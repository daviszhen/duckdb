# name: test/sql/cascade/segment_apply.test
# description: section 3.4 - SegmentApply: an operator that evaluates its right sub-tree once per segment
# group: [cascade]

# The paper's segmenting execution (section 3.4), as a *physical* operator:
#
#     R SA_A E = union over a of ( {a} x E(sigma_{A=a} R) )
#
# R is partitioned by the segmenting columns A, and for every segment the parameterized
# expression E is evaluated again - with the segment visible to it as a table-valued
# parameter. The rewrite that introduces it is described in SEGMENT_APPLY_DESIGN.md; it is
# off by default and needs DUCKDB_CASCADE_SEGMENT=1.

require-env DUCKDB_CASCADE 1

require-env DUCKDB_CASCADE_KEEP_APPLY 1

require-env DUCKDB_CASCADE_SEGMENT 1

statement ok
CREATE TABLE t(k INTEGER, v INTEGER, w INTEGER);

statement ok
INSERT INTO t VALUES (1,10,1),(1,20,2),(1,30,1),(2,40,1),(2,50,2),(3,60,1),(3,NULL,1),(NULL,99,1);

statement ok
CREATE TABLE u(k INTEGER PRIMARY KEY, x INTEGER);

statement ok
INSERT INTO u VALUES (1,100),(2,200),(4,400);

# aggregate side projection - the paper's shape, and the smallest one that fires
query IIR rowsort
SELECT t.k, t.v, g.a FROM t JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON t.k = g.k ORDER BY 1,2,3;
----
1	10	20.0
1	20	20.0
1	30	20.0
2	40	45.0
2	50	45.0
3	60	60.0
3	NULL	60.0

# extra grouping column - the segment key is one of several grouping columns
query III rowsort
SELECT t.k, t.w, g.a FROM t JOIN (SELECT k, w, sum(v) AS a FROM t GROUP BY k, w) g ON t.k = g.k AND t.w = g.w ORDER BY 1,2,3;
----
1	1	40
1	1	40
1	2	20
2	1	40
2	2	50
3	1	60
3	1	60

# count and min/max - aggregates that are not sum/avg
query IIII rowsort
SELECT t.k, g.c, g.mi, g.ma FROM t JOIN (SELECT k, count(v) AS c, min(v) AS mi, max(v) AS ma FROM t GROUP BY k) g ON t.k = g.k ORDER BY 1;
----
1	3	10	30
1	3	10	30
1	3	10	30
2	2	40	50
2	2	40	50
3	1	60	60
3	1	60	60

# the same filter on both sides - R and the aggregate's input have to be the same rows, which the rule checks
query III rowsort
SELECT r.k, r.v, g.a FROM (SELECT * FROM t WHERE v > 0) r JOIN (SELECT k, sum(v) AS a FROM t WHERE v > 0 GROUP BY k) g ON r.k = g.k ORDER BY 1,2;
----
1	10	60
1	20	60
1	30	60
2	40	90
2	50	90
3	60	60

# aggregate above the join - the result of the segment is aggregated further
query IRI rowsort
SELECT t.k, sum(t.v), g.a FROM t JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON t.k = g.k GROUP BY t.k, g.a ORDER BY 1;
----
1	60	20.0
2	90	45.0
3	60	60.0

# a NULL key is its own segment and matches nothing - `=` never matches NULL, before and after the rewrite
query I rowsort
SELECT count(*) FROM t JOIN (SELECT k, sum(v) AS a FROM t GROUP BY k) g ON t.k = g.k;
----
7

# segment on another column - the segmenting column is w here, not k
query III rowsort
SELECT t.k, t.w, g.a FROM t JOIN (SELECT w, sum(v) AS a FROM t GROUP BY w) g ON t.w = g.w ORDER BY 1,2,3;
----
1	1	239
1	1	239
1	2	70
2	1	239
2	2	70
3	1	239
3	1	239
NULL	1	239

# join on the aggregate's value - no equality between two instances of the same column
query I rowsort
SELECT count(*) FROM t JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON t.v = g.a;
----
3

# join on an expression - a computed column is not an instance of a table column
query I rowsort
SELECT count(*) FROM t JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON t.k = g.k + 0;
----
7

# different filters on the two sides - the aggregate would see different rows than the segment: declined
query I rowsort
SELECT count(*) FROM (SELECT * FROM t WHERE v > 0) r JOIN (SELECT k, avg(v) AS a FROM t WHERE v > 10 GROUP BY k) g ON r.k = g.k;
----
6

# 3.4.2 join pushed below the SegmentApply - the paper's Figure 7 move: E now reads only the rows the join with u kept
query IIRI rowsort
SELECT r.k, r.v, g.a, u.x FROM t r JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON r.k = g.k JOIN u ON g.k = u.k ORDER BY 1,2,3;
----
1	10	20.0	100
1	20	20.0	100
1	30	20.0	100
2	40	45.0	200
2	50	45.0	200

# 3.4.2 predicate reads a row column - that predicate could split a segment, so the join stays where it is
query I rowsort
SELECT count(*) FROM t r JOIN (SELECT k, avg(v) AS a FROM t GROUP BY k) g ON r.k = g.k JOIN u ON r.v = u.x;
----
0

