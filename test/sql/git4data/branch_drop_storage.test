# name: test/sql/git4data/branch_drop_storage.test
# description: Dropping a materialized branch reclaims the storage that branch owned
# group: [git4data]

load {TEST_DIR}/branch_drop_storage.db

statement ok
CREATE TABLE t(k INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO t SELECT range, range FROM range(100);

statement ok
PRAGMA git4data_create_branch('feature', '');

statement ok
PRAGMA git4data_materialize('t', 'feature', 't_feature');

statement ok
INSERT INTO t_feature SELECT 1000 + range, range FROM range(50);

query I
SELECT count(*) FROM t_feature
----
150

# Materializing gave the branch its own table; the source is untouched.
query I
SELECT count(*) FROM t
----
100

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_feature'
----
1

# Dropping the branch takes that table with it. The table was the branch's own copy of the line, so
# leaving it behind would leak one table per branch ever dropped.
statement ok
PRAGMA git4data_drop_branch('feature');

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_feature'
----
0

query I
SELECT count(*) FROM t
----
100

# The source survives the whole episode, and stays writable.
statement ok
INSERT INTO t VALUES (999, 999);

query I
SELECT count(*) FROM t
----
101

# The branch is gone from the registry, not merely its storage.
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_feature'
----
0

statement ok
CHECKPOINT

restart

query I
SELECT count(*) FROM t
----
101

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_feature'
----
0

# A branch pinned before the drop still reads, because its rows were the source's rows.
statement ok
PRAGMA git4data_create_branch('keep', '');

statement ok
PRAGMA git4data_materialize('t', 'keep', 't_keep');

statement ok
INSERT INTO t_keep SELECT 2000 + range, range FROM range(5);

query I
SELECT count(*) FROM t AT (BRANCH => 'keep')
----
106

statement ok
PRAGMA git4data_drop_branch('keep');

query I
SELECT count(*) FROM t
----
101

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_keep'
----
0

# A table two branches were given is not one branch's alone to take. Dropping a branch takes the copies
# it holds with it, and doing that to a table another branch reads leaves that branch on its pinned image
# - measured before this: a branch bound to another branch's copy fell back from v = 111 to v = 1 when
# the other branch was dropped, with nothing said. Only the tables no other branch names go with it.
statement ok
CREATE TABLE shared_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO shared_src SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('holder', '')

statement ok
PRAGMA git4data_create_branch('borrower', '')

statement ok
PRAGMA git4data_materialize('shared_src', 'holder', 'shared_table')

statement ok
PRAGMA git4data_bind_branch_table('shared_src', 'borrower', 'shared_table')

statement ok
UPDATE shared_table SET v = 111 WHERE k = 1

query II
SELECT (SELECT v FROM shared_src AT (BRANCH => 'holder') WHERE k = 1),
       (SELECT v FROM shared_src AT (BRANCH => 'borrower') WHERE k = 1)
----
111	111

statement ok
PRAGMA git4data_drop_branch('holder')

# the borrower keeps its line, and the table it reads is still there
query II
SELECT (SELECT v FROM shared_src AT (BRANCH => 'borrower') WHERE k = 1),
       (SELECT count(*) FROM shared_table)
----
111	10

# and a table nothing else names still goes with its branch, as before
statement ok
CREATE TABLE lone_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO lone_src SELECT range, range FROM range(5)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('lone', '')

statement ok
PRAGMA git4data_materialize('lone_src', 'lone', 'lone_table')

statement ok
PRAGMA git4data_drop_branch('lone')

statement error
SELECT count(*) FROM lone_table
----
<REGEX>:.*Table with name lone_table does not exist.*

# A table another branch is *about* is not this branch's to take either. The copy a branch is given can be
# the source table another branch was materialized from, and dropping the first took the second's subject
# with it: measured, after dropping "outer" the table "inner_src" was gone and the branch "inner" could not
# be read at all, while the listing still called it healthy.
statement ok
CREATE TABLE outer_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO outer_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('outer', '')

statement ok
PRAGMA git4data_materialize('outer_src', 'outer', 'inner_src')

statement ok
UPDATE inner_src SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('inner', '')

statement ok
PRAGMA git4data_materialize('inner_src', 'inner', 'inner_copy')

statement ok
PRAGMA git4data_drop_branch('outer')

query II
SELECT (SELECT v FROM inner_src AT (BRANCH => 'inner') WHERE k = 1), (SELECT count(*) FROM inner_src)
----
111	4

# the same for a source a branch differs from by a delta rather than copying
statement ok
CREATE TABLE d_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO d_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('d_outer', '')

statement ok
PRAGMA git4data_materialize('d_src', 'd_outer', 'd_mid')

statement ok
PRAGMA git4data_create_branch('d_inner', '')

statement ok
CREATE TABLE d_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE d_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('d_mid', 'd_inner', 'd_add', 'd_del')

statement ok
INSERT INTO d_add VALUES (100, 100)

statement ok
PRAGMA git4data_drop_branch('d_outer')

query II
SELECT (SELECT count(*) FROM d_mid AT (BRANCH => 'd_inner')), (SELECT count(*) FROM d_mid)
----
5	4

# and a source that was renamed under the mapping is the same table: the guard follows the oid, as the
# read path does
statement ok
CREATE TABLE e_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO e_src SELECT range, range FROM range(3)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('e_outer', '')

statement ok
PRAGMA git4data_materialize('e_src', 'e_outer', 'e_mid')

statement ok
PRAGMA git4data_create_branch('e_inner', '')

statement ok
CREATE TABLE e_copy (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO e_copy SELECT k, v FROM e_mid

statement ok
PRAGMA git4data_bind_branch_table('e_mid', 'e_inner', 'e_copy')

statement ok
ALTER TABLE e_mid RENAME TO e_mid2

statement ok
PRAGMA git4data_drop_branch('e_outer')

query II
SELECT (SELECT count(*) FROM e_mid2 AT (BRANCH => 'e_inner')), (SELECT count(*) FROM e_mid2)
----
3	3

# A mapping read back from a file has no oids - they are the catalog's and do not survive a reopen - so
# across a restart the *name* is what says another branch is about a table, and the guard has to read it
# from both halves of a mapping: the table a branch was given, and the source it is about.
statement ok
CREATE TABLE g_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO g_src SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('g_outer', '')

statement ok
PRAGMA git4data_materialize('g_src', 'g_outer', 'g_mid')

statement ok
PRAGMA git4data_create_branch('g_inner', '')

statement ok
PRAGMA git4data_materialize('g_mid', 'g_inner', 'g_copy')

statement ok
CREATE TABLE h_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO h_src SELECT range, range FROM range(3)

statement ok
PRAGMA git4data_create_branch('h_outer', '')

statement ok
PRAGMA git4data_materialize('h_src', 'h_outer', 'h_mid')

statement ok
PRAGMA git4data_create_branch('h_inner', '')

statement ok
CREATE TABLE h_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE h_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('h_mid', 'h_inner', 'h_add', 'h_del')

statement ok
CHECKPOINT

restart

statement ok
PRAGMA git4data_drop_branch('g_outer')

statement ok
PRAGMA git4data_drop_branch('h_outer')

query II
SELECT (SELECT count(*) FROM g_mid AT (BRANCH => 'g_inner')), (SELECT count(*) FROM g_mid)
----
4	4

query II
SELECT (SELECT count(*) FROM h_mid AT (BRANCH => 'h_inner')), (SELECT count(*) FROM h_mid)
----
3	3

# **A table the caller made is not the feature's to drop (3dp).** The rule is stated in three other places -
# the `owned` field's own comment ("A table bound by hand is left alone"), the replacement a second materialize
# makes, and `git4data_unbind`, which takes the mapping back and drops nothing - and dropping a branch was the
# exception: measured, a branch bound to a table the *caller* had made and filled lost it to
# `git4data_drop_branch`, silently, while unbinding the same branch left it. The same table protected by one
# path and destroyed by another is a rule a caller cannot hold in their head, so the drop follows the rule too.
# A copy the feature made (owned) still goes with the branch, which is what the case above asserts.
statement ok
CREATE TABLE hand_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO hand_src VALUES (1, 10)

statement ok
CREATE TABLE mine (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO mine VALUES (1, 999)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('hand_own', '')

statement ok
PRAGMA git4data_bind_branch_table('hand_src', 'hand_own', 'mine')

query I
SELECT v FROM hand_src AT (BRANCH => 'hand_own') WHERE k = 1
----
999

statement ok
PRAGMA git4data_drop_branch('hand_own')

# the branch is gone, and the caller's table is where they left it - with its rows
query II
SELECT (SELECT count(*) FROM git4data.branches WHERE name = 'hand_own'), (SELECT v FROM mine WHERE k = 1)
----
0	999
