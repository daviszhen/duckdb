# name: test/sql/git4data/materialize.test
# description: A branch given its own table becomes a line that can be written to
# group: [git4data]

load {TEST_DIR}/materialize.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('feature', '')

statement ok
CHECKPOINT

# a branch with no storage of its own is read as the pinned image
query I
SELECT count(*) FROM t AT (BRANCH => 'feature')
----
100

statement ok
PRAGMA git4data_materialize('t', 'feature', 't_feature')

# the branch's own table starts out as that image, and the branch now reads it
query I
SELECT count(*) FROM t_feature
----
100

query I
SELECT count(*) FROM t AT (BRANCH => 'feature')
----
100

# Its primary key comes over with it, because the key is what tells two rows apart for a diff, a pick
# or a merge afterwards.
statement error
INSERT INTO t_feature VALUES (0, 0)
----
<REGEX>:.*Constraint Error.*

# writing the branch's own table does not touch the source
statement ok
INSERT INTO t_feature SELECT 1000 + range, range FROM range(50)

statement ok
DELETE FROM t_feature WHERE k < 20

query I
SELECT count(*) FROM t AT (BRANCH => 'feature')
----
130

query I
SELECT count(*) FROM t
----
100

# the branch's changes can be brought back: a diff follows the branch's own table, so a pick sees
# them rather than the pinned image it started from
statement ok
PRAGMA git4data_create_snapshot('base')

statement ok
PRAGMA git4data_pick('t', 'feature', 'base')

query II
SELECT count(*), min(k) FROM t
----
130	20

query I
SELECT count(*) FROM t WHERE k >= 1000
----
50

# and writing the source does not touch the branch
statement ok
INSERT INTO t SELECT 2000 + range, range FROM range(7)

query I
SELECT count(*) FROM t
----
137

query I
SELECT count(*) FROM t AT (BRANCH => 'feature')
----
130

# the branch keeps its own table across a reopen
statement ok
CHECKPOINT

restart

query I
SELECT count(*) FROM t AT (BRANCH => 'feature')
----
130

query I
SELECT count(*) FROM t
----
137
