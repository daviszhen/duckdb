# name: test/sql/git4data/restore.test
# description: Rewind a table to what a reference saw
# group: [git4data]

load {TEST_DIR}/restore.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(1000)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

# three kinds of drift from the reference: rows added, rows removed, rows changed
statement ok
INSERT INTO t SELECT 1000 + range, range FROM range(500)

statement ok
DELETE FROM t WHERE k < 200

statement ok
UPDATE t SET v = v + 99999 WHERE k < 300

query I
SELECT count(*) FROM t
----
1300

statement ok
PRAGMA git4data_restore('t', 'base')

# A restore rewinds the whole table, so a row added since the reference goes too - not only the rows
# the reference knows about.
query III
SELECT count(*), min(k), max(k) FROM t
----
1000	0	999

query I
SELECT v FROM t WHERE k = 100
----
100

query I
SELECT count(*) FROM t WHERE k >= 1000
----
0

query I
SELECT count(*) FROM t WHERE k < 200
----
200

# running it again changes nothing
statement ok
PRAGMA git4data_restore('t', 'base')

query I
SELECT count(*) FROM t
----
1000

# the reference still reads its own image - a restore moves the table, not the reference
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'base')
----
1000

# a branch is a reference too, so it can be restored to
statement ok
DELETE FROM t WHERE k < 500

statement ok
PRAGMA git4data_create_branch('after_delete', '')

statement ok
CHECKPOINT

statement ok
DELETE FROM t WHERE k >= 500

query I
SELECT count(*) FROM t
----
0

statement ok
PRAGMA git4data_restore('t', 'after_delete')

query II
SELECT count(*), min(k) FROM t
----
500	500

# A table without a primary key can be rewound too: a restore deletes every row and puts the reference's
# image back, so there is nothing to match row by row. It used to refuse these tables, which was a
# requirement the generated statements never had.
statement ok
CREATE TABLE no_pk (k INTEGER, v INTEGER)

statement ok
INSERT INTO no_pk SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('np_base')

statement ok
UPDATE no_pk SET v = -1 WHERE k = 1

statement ok
DELETE FROM no_pk WHERE k = 5

statement ok
INSERT INTO no_pk VALUES (100, 100)

query II
SELECT (SELECT v FROM no_pk WHERE k = 1), (SELECT count(*) FROM no_pk)
----
-1	10

statement ok
PRAGMA git4data_restore('no_pk', 'np_base')

query III
SELECT (SELECT v FROM no_pk WHERE k = 1), (SELECT count(*) FROM no_pk WHERE k = 5),
       (SELECT count(*) FROM no_pk WHERE k = 100)
----
1	1	0

statement error
PRAGMA git4data_restore('t', 'nope')
----
<REGEX>:.*nope.*neither a snapshot nor a branch.*

# the references are durable, so a restore still works after the file is reopened
restart

query I
SELECT count(*) FROM t AT (SNAPSHOT => 'base')
----
1000

statement ok
PRAGMA git4data_restore('t', 'base')

query III
SELECT count(*), min(k), max(k) FROM t
----
1000	0	999

# ---------------------------------------------------------------------------------------------------------
# A restore of what the table already has writes nothing
# ---------------------------------------------------------------------------------------------------------

# A row that is written keeps its content but not its row id, and a diff of two references of one table
# compares row ids. So a restore that rewrote every row made a later diff of the state before it and the state
# after it report the whole table as changed, for two references that denote the same rows - measured, three
# changed on a table of three. A restore that has nothing to put right now writes nothing at all, and the ids
# of the rows stay where they are.
statement ok
CREATE TABLE r (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO r VALUES (1, 10), (2, 20), (3, 30)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('same')

statement ok
PRAGMA git4data_restore('r', 'same')

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('after_same')

# the two references denote the same rows, and now the diff says so
query I
SELECT count(*) FROM git4data_diff('r', 'same', 'after_same')
----
0

# and the content is what it was
query III
SELECT count(*), min(v), max(v) FROM r
----
3	10	30

# A restore that does have something to put right still does it: the table is rewound to the reference,
# including rows added since and rows the reference never had.
statement ok
INSERT INTO r VALUES (4, 40)

statement ok
UPDATE r SET v = 99 WHERE k = 2

statement ok
PRAGMA git4data_restore('r', 'same')

query III
SELECT count(*), min(v), max(v) FROM r
----
3	10	30

# A table with no key is rewound the same way: the two images are compared as multisets, so a table holding
# the same rows in a different order is left alone rather than rewritten
statement ok
CREATE TABLE nokey (v INTEGER)

statement ok
INSERT INTO nokey VALUES (1), (2), (2)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('nokey_same')

statement ok
PRAGMA git4data_restore('nokey', 'nokey_same')

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('nokey_after')

query I
SELECT count(*) FROM git4data_diff('nokey', 'nokey_same', 'nokey_after')
----
0

statement ok
DELETE FROM nokey WHERE v = 2

statement ok
PRAGMA git4data_restore('nokey', 'nokey_same')

query I
SELECT count(*) FROM nokey
----
3
