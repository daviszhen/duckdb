# name: test/sql/git4data/fork_state_merge.test
# description: Merging two lines that were forked from the same written branch
# group: [git4data]

load {TEST_DIR}/fork_state_merge.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('p', 'root')

statement ok
PRAGMA git4data_materialize('t', 'p', 't_p')

# the parent is written to before either child exists, so both children start from a state their
# least common ancestor's *pin* does not hold - which is the case the merge has to get right
statement ok
UPDATE t_p SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('a', 'p')

statement ok
UPDATE t_p SET v = 222 WHERE k = 2

statement ok
PRAGMA git4data_create_branch('b', 'p')

statement ok
PRAGMA git4data_materialize('t', 'a', 't_a')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b')

statement ok
UPDATE t_b SET v = 999 WHERE k = 3

# each child holds what its parent held when it forked: a has the 111 and not the 222, b has both
query III
SELECT (SELECT v FROM t_a WHERE k = 1), (SELECT v FROM t_a WHERE k = 2), (SELECT v FROM t_b WHERE k = 2)
----
111	2	222

query I
PRAGMA git4data_lca('a', 'b')
----
p

# Merging b into a lands everything b's line holds without a conflict: the row a forked with is still
# its own 111, the row the parent changed after a forked comes with b, and b's own change comes with it.
statement ok
PRAGMA git4data_merge('t', 'a', 'b', 'fail')

query III
SELECT (SELECT v FROM t_a WHERE k = 1), (SELECT v FROM t_a WHERE k = 2), (SELECT v FROM t_a WHERE k = 3)
----
111	222	999

# and the merge changed nothing about the parent or the other child
query III
SELECT (SELECT v FROM t_p WHERE k = 1), (SELECT v FROM t_p WHERE k = 2), (SELECT v FROM t_b WHERE k = 3)
----
111	222	999

# The parent's copy can also be written *before* either side forks, and then both sides part from that
# written state rather than from the parent's pinned image. Measured before this was fixed: with the
# parent's copy holding 111 for the row and both sides reading 111, a merge in which only one of them
# changed that row was refused as a conflict - both sides looked changed against the source's 1, which is
# the state the parent's *pin* names rather than the state the two sides parted at.
statement ok
CREATE TABLE t2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t2 SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('q', '')

statement ok
PRAGMA git4data_materialize('t2', 'q', 't2_q')

statement ok
UPDATE t2_q SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('ql', 'q')

statement ok
PRAGMA git4data_create_branch('qr', 'q')

statement ok
PRAGMA git4data_materialize('t2', 'ql', 't2_ql')

statement ok
PRAGMA git4data_materialize('t2', 'qr', 't2_qr')

query II
SELECT (SELECT v FROM t2 AT (BRANCH => 'ql') WHERE k = 1), (SELECT v FROM t2 AT (BRANCH => 'qr') WHERE k = 1)
----
111	111

statement ok
UPDATE t2_ql SET v = 222 WHERE k = 1

# only the left side changed this row, so the merge has no conflict there and keeps the left side's value
statement ok
PRAGMA git4data_merge('t2', 'ql', 'qr', 'fail')

query II
SELECT (SELECT v FROM t2 AT (BRANCH => 'ql') WHERE k = 1), (SELECT v FROM t2 AT (BRANCH => 'qr') WHERE k = 1)
----
222	111
