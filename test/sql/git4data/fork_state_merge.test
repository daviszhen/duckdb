# name: test/sql/git4data/fork_state_merge.test
# description: Merging two lines that were forked from the same written branch
# group: [git4data]

load {TEST_DIR}/fork_state_merge.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('p', 'root')

statement ok
PRAGMA git4data_materialize('t', 'p', 't_p')

# the parent is written to before either child exists, so both children start from a state their
# least common ancestor's *pin* does not hold - which is the case the merge has to get right
statement ok
UPDATE t_p SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('a', 'p')

statement ok
UPDATE t_p SET v = 222 WHERE k = 2

statement ok
PRAGMA git4data_create_branch('b', 'p')

statement ok
PRAGMA git4data_materialize('t', 'a', 't_a')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b')

statement ok
UPDATE t_b SET v = 999 WHERE k = 3

# each child holds what its parent held when it forked: a has the 111 and not the 222, b has both
query III
SELECT (SELECT v FROM t_a WHERE k = 1), (SELECT v FROM t_a WHERE k = 2), (SELECT v FROM t_b WHERE k = 2)
----
111	2	222

query I
PRAGMA git4data_lca('a', 'b')
----
p

# Merging b into a lands everything b's line holds without a conflict: the row a forked with is still
# its own 111, the row the parent changed after a forked comes with b, and b's own change comes with it.
statement ok
PRAGMA git4data_merge('t', 'a', 'b', 'fail')

query III
SELECT (SELECT v FROM t_a WHERE k = 1), (SELECT v FROM t_a WHERE k = 2), (SELECT v FROM t_a WHERE k = 3)
----
111	222	999

# and the merge changed nothing about the parent or the other child
query III
SELECT (SELECT v FROM t_p WHERE k = 1), (SELECT v FROM t_p WHERE k = 2), (SELECT v FROM t_b WHERE k = 3)
----
111	222	999
