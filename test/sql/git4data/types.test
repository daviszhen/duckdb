# name: test/sql/git4data/types.test
# description: A snapshot read preserves column type families, per branch_matrix_coverage
# group: [git4data]

statement ok
CREATE TABLE ty(
  ti TINYINT, si SMALLINT, i INTEGER, bi BIGINT, h HUGEINT,
  f FLOAT, d DOUBLE, dec DECIMAL(18,4),
  s VARCHAR, b BOOLEAN, dt DATE, ts TIMESTAMP, l INTEGER[]
)

statement ok
INSERT INTO ty VALUES
  (1, 2, 3, 4, 5, 1.5, 2.5, 3.5, 'text', true, DATE '2024-01-01', TIMESTAMP '2024-01-01 10:00:00', [1,2,3]),
  (-1, -2, -3, -4, -5, -1.5, -2.5, -3.5, 'more', false, DATE '2025-06-15', TIMESTAMP '2025-06-15 23:59:59', [4,5])

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('ty_snap')

statement ok
DELETE FROM ty WHERE ti = 1

statement ok
UPDATE ty SET s = 'changed' WHERE ti = -1

statement ok
CHECKPOINT

# the current state lost one row and the surviving row was updated
query II
SELECT count(*), min(s) FROM ty
----
1	changed

# the snapshot still has both rows and the pre-update value
query III
SELECT count(*), min(ti), max(s) FROM ty AT (SNAPSHOT => 'ty_snap')
----
2	-1	text

# every column family round-trips through a snapshot read
query IIIII
SELECT ti, s, b, dt, l FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = 1
----
1	text	true	2024-01-01	[1, 2, 3]

# numeric families
query IIIII
SELECT ti, si, i, bi, h FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = 1
----
1	2	3	4	5

query II
SELECT f, d FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = 1
----
1.5	2.5

query I
SELECT dec FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = 1
----
3.5000

query I
SELECT ts FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = 1
----
2024-01-01 10:00:00

# negative values survive too
query IIIII
SELECT ti, si, i, bi, h FROM ty AT (SNAPSHOT => 'ty_snap') WHERE ti = -1
----
-1	-2	-3	-4	-5

# A floating-point key: the comparison path for a key that is *not* an integer, which no test in this directory
# exercised until now - not one of them used a real or a double key, so `Git4DataIntegerKeyBits` and the hash
# path beside it were only ever reached by the integer keys the other files use. Measured while hunting for
# defects: the row whose key is NaN is found by the removed table, which a comparison by *value* could not do
# (NaN is not equal to itself in SQL), so what matches a key here is not a plain equality.
statement ok
CREATE TABLE fk (k DOUBLE PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO fk VALUES (1.0, 10), ('NaN'::DOUBLE, 20), (2.5, 40)

statement ok
PRAGMA git4data_create_snapshot('fk_s')

statement ok
PRAGMA git4data_create_branch('fk_delta', 'fk_s')

statement ok
CREATE TABLE fk_add (k DOUBLE, v INTEGER)

statement ok
INSERT INTO fk_add VALUES (99.0, 1)

statement ok
CREATE TABLE fk_rem (k DOUBLE)

statement ok
INSERT INTO fk_rem VALUES ('NaN'::DOUBLE)

statement ok
PRAGMA git4data_bind_branch_delta('fk', 'fk_delta', 'fk_add', 'fk_rem')

query II
SELECT v, k FROM fk AT (BRANCH => 'fk_delta') ORDER BY v
----
1	99.0
10	1.0
40	2.5

# the live table still holds the row the delta removed, and a copy of it does too
query I
SELECT count(*) FROM fk
----
3

statement ok
PRAGMA git4data_create_branch('fk_copy', 'fk_s')

statement ok
PRAGMA git4data_materialize('fk', 'fk_copy', 'fk_tb')

statement ok
DELETE FROM fk_tb WHERE isnan(k)

query I
SELECT count(*) FROM fk AT (BRANCH => 'fk_copy')
----
2
