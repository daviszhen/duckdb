# name: test/sql/git4data/registry_isolation.test
# description: An uncommitted reference is the transaction that made it and nobody else's
# group: [git4data]

# A reference is a row in the registry tables, so it is uncommitted until the transaction that wrote it
# commits - that is what putting the registry in tables bought. The *registries* a read consults are shared
# memory, though, and they are updated the moment a reference is made, so before this file's fix another
# connection could list a reference that was not there yet and read *through* it: measured, with one
# connection inside a transaction holding a snapshot of its own, the other connection listed it and
# `SELECT ... AT (SNAPSHOT => <name>)` answered - while `SELECT ... FROM git4data.snapshots` correctly showed
# nothing, so the feature disagreed with its own durable truth.
#
# What is asserted here is the rule that closes that: a reference another transaction has added and has not
# committed is not there yet, for the listing, for a read, for a drop and for the pragmas that resolve a name.
# The marker is dropped when its transaction ends, so a committed reference is everyone's again without
# anything having to run on the way out; the rollback case is the last block.

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t VALUES (1, 1)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('committed')

statement ok
PRAGMA git4data_create_branch('committed_b', '')

statement ok con1
BEGIN

statement ok con1
PRAGMA git4data_create_snapshot('pending')

statement ok con1
PRAGMA git4data_create_branch('pending_b', '')

# the registry table is the durable truth and never showed it
query I con2
SELECT count(*) FROM git4data.snapshots WHERE name = 'pending'
----
0

query I con2
SELECT count(*) FROM git4data.branches WHERE name = 'pending_b'
----
0

# the listing reads the shared registry, and now follows the same rule
query III con2
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'pending_b'),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'committed_b')
----
0	0	1

# and so does a read: the name is not one this transaction can use yet
statement error con2
SELECT count(*) FROM t AT (SNAPSHOT => 'pending')
----
<REGEX>:.*Snapshot "pending" does not exist.*

statement error con2
SELECT count(*) FROM t AT (BRANCH => 'pending_b')
----
<REGEX>:.*Branch "pending_b" does not exist.*

# a name that is neither is reported as neither, so a caller is not told which registry was looked in
statement error con2
SELECT count(*) FROM git4data_diff('t', 'pending', 'committed')
----
<REGEX>:.*Snapshot "pending" does not exist.*

# the pragmas that resolve a name follow it too: nothing another transaction has not committed can be
# dropped, bound, merged, picked or restored by this one
statement error con2
PRAGMA git4data_drop_snapshot('pending')
----
<REGEX>:.*Snapshot "pending" does not exist.*

statement error con2
PRAGMA git4data_drop_branch('pending_b')
----
<REGEX>:.*Branch "pending_b" does not exist.*

statement error con2
PRAGMA git4data_materialize('t', 'pending_b', 'borrowed')
----
<REGEX>:.*Branch "pending_b" does not exist.*

statement error con2
PRAGMA git4data_restore('t', 'pending')
----
<REGEX>:.*Snapshot "pending" does not exist.*

statement error con2
PRAGMA git4data_lca('pending_b', 'committed_b')
----
<REGEX>:.*Branch "pending_b" does not exist.*

statement error con2
PRAGMA git4data_merge('t', 'pending_b', 'committed_b', 'fail')
----
<REGEX>:.*Branch "pending_b" does not exist.*

# and a reference this transaction made is its own: the writer reads and lists what it has just made
query III con1
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => 'pending')),
       (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'pending_b')
----
1	1	1

statement ok con1
COMMIT

# committed, so it is everyone's: the listing, the table and a read all agree
query III con2
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'pending'))
----
1	1	1

statement ok con2
PRAGMA git4data_drop_snapshot('pending')

# a reference a transaction rolls back is nobody's, and the other connection never saw it
statement ok con1
BEGIN

statement ok con1
PRAGMA git4data_create_snapshot('gone')

query I con2
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'
----
0

statement ok con1
ROLLBACK

# A rolled-back reference is gone for everyone at once, and there is no window: the tables are the truth, so a
# record they do not hold is not put back by a rebuild unless some transaction is *still adding* it. Before
# increment 3cs this window lasted until the rolling-back connection next used the feature - measured, another
# connection listed the name and read through it in the meantime (3cr records the measurement) - because the
# rebuild put every in-memory record back.
query III con2
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'),
       (SELECT count(*) FROM git4data.snapshots WHERE name = 'gone'),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'gone')
----
0	0	0

statement error con2
SELECT count(*) FROM t AT (SNAPSHOT => 'gone')
----
<REGEX>:.*Snapshot "gone" does not exist.*

# and the rolling-back connection sees the same, whether or not it has touched the feature since
query I con1
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'
----
0

statement ok con1
PRAGMA git4data_snapshots

query I con1
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'
----
0
