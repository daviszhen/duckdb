# name: test/sql/git4data/registry_isolation.test
# description: What is visible of a reference before and after the transaction that made it ends
# group: [git4data]

# Two things are asserted here, and the first one is a **recorded limitation** rather than a promise.
#
# 1. A reference a transaction has added and has **not committed** is visible to every connection, including
#    through a read. That is not what the feature wants - a reference is a row in the registry tables, so an
#    uncommitted one should be its writer's alone - and it is not what increment 3cr made it do either, which is
#    why 3cr's check was withdrawn in 3cv: the rule cannot be implemented, because which connection is asking is
#    not observable where the question has to be answered. The pragma that *makes* a reference runs before the
#    statement it belongs to and in a different client context, so the creating connection's id, its
#    `ClientData` and its `MetaTransaction` all differ from the asking connection's - measured, all three - and
#    a check that cannot recognise the writer hides the reference from the writer too. What that looked like:
#    `BEGIN; PRAGMA git4data_create_snapshot('s'); SELECT ... AT (SNAPSHOT => 's')` refused on the connection
#    that had just made it.
#
#    The assertions below are the *measured* behaviour, kept so that a change is noticed in either direction:
#    if the feature ever learns to scope this, they are what has to be rewritten.
#
# 2. A reference a transaction has **rolled back** is gone for everyone at the same moment, and a reference a
#    connection can see is one whose rows it can see. That part is a promise, and it is what 3cs and 3ct built:
#    the tables are the truth, and a rebuild asked for by *any* connection drops a record that a finished
#    transaction of this process added.

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t VALUES (1, 1)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('committed')

statement ok con1
BEGIN

statement ok con1
PRAGMA git4data_create_snapshot('pending')

statement ok con1
PRAGMA git4data_create_branch('pending_b', '')

# the registry table is the durable truth and holds no row for it
query I con2
SELECT count(*) FROM git4data.snapshots WHERE name = 'pending'
----
0

# the writer's own workflow has to work: it can list, read through and act on what it has just made
query III con1
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'pending')),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'pending_b')
----
1	1	1

# And another connection sees it too, which is the recorded limitation: the listing reads the shared registry,
# and a read through it answers - while the row is not there yet. (This assertion was removed for one round
# because a second file appeared to contradict it; the contradiction was a mistake in *that* file's own
# queries - it filtered names with `NOT LIKE '__%'`, where `_` is the single-character wildcard, so every name
# of two characters or more was excluded. The listing was right.)
query III con2
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'pending')),
       (SELECT count(*) FROM git4data_branches() WHERE branch_name = 'pending_b')
----
1	1	1

statement ok con1
COMMIT

query III
SELECT (SELECT count(*) FROM git4data.snapshots WHERE name = 'pending'),
       (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'pending'),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'pending'))
----
1	1	1

# 2. rolled back: gone for every connection, and the connection that did it does not have to ask first
statement ok con2
PRAGMA git4data_drop_snapshot('pending')

statement ok con1
BEGIN

statement ok con1
PRAGMA git4data_create_snapshot('gone')

statement ok con1
ROLLBACK

query II con2
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'),
       (SELECT count(*) FROM git4data.snapshots WHERE name = 'gone')
----
0	0

statement error con2
SELECT count(*) FROM t AT (SNAPSHOT => 'gone')
----
<REGEX>:.*Snapshot "gone" does not exist.*

query I con1
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'gone'
----
0

# and a database whose first reference is rolled back - which takes the registry tables with it - behaves the
# same way: the tables cannot say what memory should hold, so only a marker naming a finished transaction can
query I con1
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'committed'
----
1
