# name: test/sql/git4data/merge_tables.test
# description: A merge whose two sides' tables have drifted apart in row count
# group: [git4data]

load {TEST_DIR}/merge_tables.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('left', 'root')

statement ok
PRAGMA git4data_create_branch('right', 'root')

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_materialize('t', 'left', 't_left')

statement ok
PRAGMA git4data_materialize('t', 'right', 't_right')

# Each side changes its own rows. The point is that they append a different *number* of rows: the two
# storage tables number their own rows from zero, so from here on a row id in one names a different row
# in the other, and anything comparing them by id would be comparing noise.
statement ok
UPDATE t_left SET v = 11 WHERE k = 1

statement ok
DELETE FROM t_left WHERE k = 5

statement ok
INSERT INTO t_left VALUES (1000, 1000)

statement ok
UPDATE t_right SET v = 22 WHERE k = 2

statement ok
INSERT INTO t_right VALUES (2000, 2000), (2001, 2001), (2002, 2002)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'fail')

# the left line now holds its own three changes and the right's four
query I
SELECT count(*) FROM t_left
----
103

query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k)
FROM t_left WHERE k IN (1, 2, 5, 1000, 2000, 2001, 2002)
----
1:11 2:22 1000:1000 2000:2000 2001:2001 2002:2002

# the right line is untouched by the merge, and so is the table the branches came from
query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k)
FROM t_right WHERE k IN (1, 2, 5, 1000, 2000)
----
1:1 2:22 5:5 2000:2000

# reading the branch through its reference agrees with reading its table
query I
SELECT count(*) FROM t AT (BRANCH => 'left')
----
103
