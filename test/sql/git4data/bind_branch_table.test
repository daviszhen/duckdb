# name: test/sql/git4data/bind_branch_table.test
# description: Binding a branch to a table of its own, which is what materialize does last
# group: [git4data]

load {TEST_DIR}/bind_branch_table.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('b', '')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
10

# a second table with the same shape, for the branch to be pointed at
statement ok
CREATE TABLE t_alt (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_alt VALUES (1, 999)

statement ok
CHECKPOINT

# binding is what tells the reads that the branch has a line of its own, so the branch answers from
# that table from here on - which is why materialize does the copy first and binds afterwards
statement ok
PRAGMA git4data_bind_branch_table('t', 'b', 't_alt')

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1)
----
1	999

# the table the branch was forked from is untouched
query I
SELECT count(*) FROM t
----
10

# a binding that names a branch or a table that is not there is refused rather than promised, because
# the reads would then have to break
statement error
PRAGMA git4data_bind_branch_table('t', 'nope', 't_alt')
----
<REGEX>:.*Branch "nope" does not exist.*

statement error
PRAGMA git4data_bind_branch_table('t', 'b', 'nowhere')
----
<REGEX>:.*Table with name nowhere does not exist.*

statement error
PRAGMA git4data_bind_branch_table('nowhere', 'b', 't_alt')
----
<REGEX>:.*Table with name nowhere does not exist.*

# A table that is dropped and another created with its name is not the same table, and a branch that went
# on reading it would be reading something the caller never pointed it at. The mapping carries the oid of
# the table it was given, and the read checks it - within a session, because a name is all that survives
# a reopen.
statement ok
DROP TABLE t_alt

# with no table of that name at all the branch falls back to the image it pins, which is the rule for a
# mapping whose table is gone
query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
10

statement ok
CREATE TABLE t_alt (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_alt VALUES (5000, 5000)

statement error
SELECT count(*) FROM t AT (BRANCH => 'b')
----
<REGEX>:.*the table carrying that name now is not it.*

# pointing the branch at a table again is the way out, and it works
statement ok
PRAGMA git4data_bind_branch_table('t', 'b', 't_alt')

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 5000)
----
1	5000

# A source table can be renamed, and the mapping is keyed by the source's *name* - so without the source's
# oid the name would match nothing, and the branch would silently read its pinned image instead of the
# line it holds. Measured before this: after the rename the branch read ten rows of the pinned image where
# it holds one row of its own table.
statement ok
ALTER TABLE t RENAME TO t_renamed

query II
SELECT (SELECT count(*) FROM t_renamed AT (BRANCH => 'b')),
       (SELECT v FROM t_renamed AT (BRANCH => 'b') WHERE k = 5000)
----
1	5000

# and the branch's own table is still the thing it reads, so a write to it shows through the new name
statement ok
UPDATE t_alt SET v = -5000 WHERE k = 5000

query I
SELECT v FROM t_renamed AT (BRANCH => 'b') WHERE k = 5000
----
-5000

# the table the branch was *given* can be renamed too, and the mapping is written in names: the oid is
# what finds it again, and the plan then carries the name it has now rather than the one it was given
statement ok
ALTER TABLE t_alt RENAME TO t_alt_renamed

query II
SELECT (SELECT count(*) FROM t_renamed AT (BRANCH => 'b')),
       (SELECT v FROM t_renamed AT (BRANCH => 'b') WHERE k = 5000)
----
1	-5000

statement ok
UPDATE t_alt_renamed SET v = 5000 WHERE k = 5000

query I
SELECT v FROM t_renamed AT (BRANCH => 'b') WHERE k = 5000
----
5000

# the name goes back, so the sections below still read the table they were written against - and the
# mapping keeps following it, because it is the same table's oid either way
statement ok
ALTER TABLE t_alt_renamed RENAME TO t_alt

statement ok
ALTER TABLE t_renamed RENAME TO t

# and the binding survives a reopen, because it is part of the branch
statement ok
CHECKPOINT

restart

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 5000)
----
1	5000

# The merge writes into the table a branch was given and the drop takes it with the branch, and both used
# the name the mapping was written with. Measured before this: a renamed table made the merge fail to bind
# ("Table with name t_m does not exist") and, worse, the drop left the renamed table behind, still holding
# the branch's line with nothing pointing at it.
statement ok
CREATE TABLE r1 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO r1 SELECT range, range FROM range(10)

statement ok
PRAGMA git4data_create_branch('rr', '')

statement ok
PRAGMA git4data_create_branch('rm', 'rr')

statement ok
PRAGMA git4data_create_branch('ro', 'rr')

statement ok
PRAGMA git4data_materialize('r1', 'rm', 'r1_m')

statement ok
PRAGMA git4data_materialize('r1', 'ro', 'r1_o')

statement ok
ALTER TABLE r1_m RENAME TO r1_m2

statement ok
UPDATE r1_o SET v = -5 WHERE k = 1

statement ok
PRAGMA git4data_merge('r1', 'rm', 'ro', 'fail')

query II
SELECT (SELECT count(*) FROM r1 AT (BRANCH => 'rm')), (SELECT v FROM r1 AT (BRANCH => 'rm') WHERE k = 1)
----
10	-5

statement ok
PRAGMA git4data_drop_branch('rm')

statement error
SELECT count(*) FROM r1_m2
----
<REGEX>:.*Table with name r1_m2 does not exist.*

# A branch's own line has to be a table of its own. Pointed at the source itself the branch stops being a
# branch: measured before this was refused, it read the *live* table - 11 rows after a row was inserted
# and 6 after five were deleted, where its pin held 10 either way.
statement error
PRAGMA git4data_bind_branch_table('t', 'b', 't')
----
<REGEX>:.*is "t" itself, and a branch's own line has to be a table of its own.*

# the branch is untouched by the refusal and still reads its own table
query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 5000
----
5000

# A branch's own table stands in for the source, and the read maps its columns onto the source's *by
# position* - so it has to have that table's columns in that order. Measured before this was checked: a
# table holding (v, k) where the source holds (k, v) read back as k = 777 and v = 1 from a row that held
# k = 1 and v = 777. The delta path has always checked its two tables; the storage path did not.
statement ok
CREATE TABLE t_reordered (v INTEGER, k INTEGER PRIMARY KEY)

statement ok
INSERT INTO t_reordered VALUES (777, 1)

statement error
PRAGMA git4data_bind_branch_table('t', 'b', 't_reordered')
----
<REGEX>:.*a read maps its columns by position.*

statement ok
CREATE TABLE t_extra (k INTEGER PRIMARY KEY, v INTEGER, w INTEGER)

statement error
PRAGMA git4data_bind_branch_table('t', 'b', 't_extra')
----
<REGEX>:.*a read maps its columns by position.*

# and the shape is checked on every read as well, because DDL afterwards can leave the table unable to
# stand in - the read would otherwise hand a caller someone else's values
statement ok
CREATE TABLE t_ddl (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_ddl SELECT range, range FROM range(10)

statement ok
PRAGMA git4data_create_branch('ddl_branch', '')

statement ok
PRAGMA git4data_bind_branch_table('t', 'ddl_branch', 't_ddl')

query I
SELECT count(*) FROM t AT (BRANCH => 'ddl_branch')
----
10

statement ok
ALTER TABLE t_ddl ADD COLUMN w INTEGER

statement error
SELECT count(*) FROM t AT (BRANCH => 'ddl_branch')
----
<REGEX>:.*reads table "t_ddl" as its own line.*no longer has that table's columns.*

# putting it back is the way out
statement ok
ALTER TABLE t_ddl DROP COLUMN w

query I
SELECT count(*) FROM t AT (BRANCH => 'ddl_branch')
----
10

# git4data_bind_internal is the generated form: the SQL materialize returns binds the branch in memory with
# it and writes the row itself, because a statement a pragma returns cannot call a pragma that returns one.
# It does the same binding as the caller's form, so calling it directly shows the same read.
statement ok
CREATE TABLE bi_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO bi_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('bi', '')

statement ok
CREATE TABLE bi_copy (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO bi_copy VALUES (1, 777)

statement ok
PRAGMA git4data_bind_internal('bi_src', 'bi', 'bi_copy', 'true')

query I
SELECT v FROM bi_src AT (BRANCH => 'bi') WHERE k = 1
----
777
