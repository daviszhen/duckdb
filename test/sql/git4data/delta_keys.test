# name: test/sql/git4data/delta_keys.test
# description: A delta whose keys are strings, and a composite key, with removals and additions
# group: [git4data]

load {TEST_DIR}/delta_keys.db

# The read path decides whether a base row is one the delta removed by comparing the row's key, and it
# compares the exact key - a hash of the key is only used to skip the comparison for rows that cannot
# be in the removed set. String keys and composite keys are what make that distinction matter, so they
# are covered here rather than only with integer keys.
statement ok
CREATE TABLE s (k VARCHAR PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO s SELECT 'key_' || lpad(range::VARCHAR, 6, '0'), range FROM range(2000)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
CREATE TABLE s_add (k VARCHAR PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE s_del (k VARCHAR PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('s', 'b', 's_add', 's_del')

query I
SELECT count(*) FROM s AT (BRANCH => 'b')
----
2000

statement ok
PRAGMA git4data_apply('s', 'b', 'DELETE FROM s WHERE k IN (''key_000005'', ''key_000007'')')

query I
SELECT count(*) FROM s AT (BRANCH => 'b')
----
1998

# the removed keys are the ones named, not the ones beside them
query I
SELECT count(*) FROM s AT (BRANCH => 'b') WHERE k IN ('key_000004', 'key_000005', 'key_000006', 'key_000007')
----
2

# a removal the base knows nothing about is harmless: it hides nothing and errors nowhere
statement ok
INSERT INTO s_del VALUES ('not_in_base')

query I
SELECT count(*) FROM s AT (BRANCH => 'b')
----
1998

# an added row, and then a row whose key the branch hides: one row for that key, and the base row of
# that key stays hidden
statement ok
PRAGMA git4data_apply('s', 'b', 'INSERT INTO s VALUES (''key_999999'', 900)')

statement ok
PRAGMA git4data_apply('s', 'b', 'INSERT INTO s VALUES (''key_000005'', 555)')

query III
SELECT count(*), max(v), min(v) FROM s AT (BRANCH => 'b') WHERE k = 'key_000005'
----
1	555	555

query I
SELECT count(*) FROM s AT (BRANCH => 'b')
----
2000

# an update that rewrites the key of a string-keyed row
statement ok
PRAGMA git4data_apply('s', 'b', 'UPDATE s SET k = ''renamed'' WHERE k = ''key_000010''')

query II
SELECT (SELECT count(*) FROM s AT (BRANCH => 'b') WHERE k = 'key_000010'),
       (SELECT v FROM s AT (BRANCH => 'b') WHERE k = 'renamed')
----
0	10

query I
SELECT count(*) FROM s AT (BRANCH => 'b')
----
2000

# the diff between the snapshot and the branch agrees with what the branch shows: two keys added, two
# gone, one changed - and it is the key comparison, not the row ids, because a delta side is not the
# table it differs from
query II
SELECT g4d_change, count(*) FROM git4data_diff('s', 'base', 'b') GROUP BY g4d_change ORDER BY g4d_change
----
added	2
changed	1
removed	2

# a composite key of a string and an integer, so the key a read builds is a tuple of two columns
statement ok
CREATE TABLE c (a VARCHAR, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
INSERT INTO c SELECT 'p' || (range % 7)::VARCHAR, range, range FROM range(1000)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cb', '')

statement ok
CREATE TABLE c_add (a VARCHAR, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
CREATE TABLE c_del (a VARCHAR, b INTEGER, PRIMARY KEY (a, b))

statement ok
PRAGMA git4data_bind_branch_delta('c', 'cb', 'c_add', 'c_del')

# remove every key whose second column is a multiple of a hundred, and add two rows
statement ok
PRAGMA git4data_apply('c', 'cb', 'DELETE FROM c WHERE b % 100 = 0')

statement ok
PRAGMA git4data_apply('c', 'cb', 'INSERT INTO c VALUES (''p1'', 5000, 5000)')

statement ok
PRAGMA git4data_apply('c', 'cb', 'INSERT INTO c VALUES (''p2'', 6000, 6000)')

query I
SELECT count(*) FROM c AT (BRANCH => 'cb')
----
992

# the base rows whose key is a multiple of a hundred are gone and their neighbours are not. The two
# rows that were added also carry such a key, which is why the count is taken over the base's range.
query II
SELECT count(*) FILTER (WHERE b % 100 = 0 AND b < 1000), count(*) FROM c AT (BRANCH => 'cb')
----
0	992

query III
SELECT (SELECT v FROM c AT (BRANCH => 'cb') WHERE a = 'p1' AND b = 5000),
       (SELECT v FROM c AT (BRANCH => 'cb') WHERE a = 'p2' AND b = 6000),
       (SELECT count(*) FROM c)
----
5000	6000	1000

# an update that rewrites one half of a composite key: the old key is gone, the new one is there
statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET b = 99999 WHERE a = ''p3'' AND b = 3')

query II
SELECT (SELECT count(*) FROM c AT (BRANCH => 'cb') WHERE a = 'p3' AND b = 3),
       (SELECT v FROM c AT (BRANCH => 'cb') WHERE a = 'p3' AND b = 99999)
----
0	3

# Keys of other types, and names that need quoting. The tests above all use plain lowercase names and
# integer or varchar keys, which is how two families of edges stayed invisible until they were probed:
# a key is compared as a string built from its values, so every type has to survive that, and every name
# the feature writes into SQL is quoted or escaped. All of the below was measured before it was asserted.
statement ok
CREATE TABLE big (k HUGEINT PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO big VALUES (170141183460469231731687303715884105727, 1), (-170141183460469231731687303715884105728, 2)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('big_branch', '')

statement ok
CREATE TABLE big_add (k HUGEINT PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE big_del (k HUGEINT PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('big', 'big_branch', 'big_add', 'big_del')

statement ok
PRAGMA git4data_apply('big', 'big_branch', 'UPDATE big SET v = 99 WHERE k = 170141183460469231731687303715884105727')

# both extremes of the type, one of them updated through the delta
query I
SELECT string_agg(v::VARCHAR, ',' ORDER BY k) FROM big AT (BRANCH => 'big_branch')
----
2,99

statement ok
CREATE TABLE uid (k UUID PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO uid VALUES ('00000000-0000-0000-0000-000000000001', 1), ('00000000-0000-0000-0000-000000000002', 2)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('uid_branch', '')

statement ok
CREATE TABLE uid_add (k UUID PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE uid_del (k UUID PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('uid', 'uid_branch', 'uid_add', 'uid_del')

statement ok
PRAGMA git4data_apply('uid', 'uid_branch', 'DELETE FROM uid WHERE k = ''00000000-0000-0000-0000-000000000002''')

query I
SELECT count(*) FROM uid AT (BRANCH => 'uid_branch')
----
1

statement ok
CREATE TABLE dec (k DECIMAL(18,4) PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO dec VALUES (1.5000, 1), (2.2500, 2)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('dec_branch', '')

statement ok
CREATE TABLE dec_add (k DECIMAL(18,4) PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE dec_del (k DECIMAL(18,4) PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('dec', 'dec_branch', 'dec_add', 'dec_del')

statement ok
PRAGMA git4data_apply('dec', 'dec_branch', 'UPDATE dec SET v = 7 WHERE k = 2.2500')

query I
SELECT string_agg(v::VARCHAR, ',' ORDER BY k) FROM dec AT (BRANCH => 'dec_branch')
----
1,7

# A name that carries a quote goes through every statement the feature writes: the table and the branch
# below hold one each, and the delta's two tables one apiece.
statement ok
CREATE TABLE "q'uote" (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO "q'uote" SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('b''ranch', '')

statement ok
CREATE TABLE "add'x" (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE "del'x" (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('q''uote', 'b''ranch', 'add''x', 'del''x')

statement ok
PRAGMA git4data_apply('q''uote', 'b''ranch', 'UPDATE "q''uote" SET v = 111 WHERE k = 1')

query I
SELECT v FROM "q'uote" AT (BRANCH => 'b''ranch') WHERE k = 1
----
111

query I
SELECT count(*) FROM git4data_diff('q''uote', 'b''ranch', 'b''ranch')
----
0

statement ok
PRAGMA git4data_materialize('q''uote', 'b''ranch', 'copy''x')

query I
SELECT count(*) FROM "q'uote" AT (BRANCH => 'b''ranch')
----
10

statement ok
PRAGMA git4data_unbind('q''uote', 'b''ranch')

query I
SELECT v FROM "q'uote" AT (BRANCH => 'b''ranch') WHERE k = 1
----
1

# A single integer key is the shape the removed side keeps as its 64-bit pattern rather than as a string
# (increment 3q), and the pattern has to keep values apart that a naive cast would fold together: a negative
# key and a large unsigned one. Both are read through a delta whose removed side holds them.
statement ok
CREATE TABLE signed (k BIGINT PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO signed VALUES (-9223372036854775808, 1), (-1, 2), (0, 3), (9223372036854775807, 4)

statement ok
CHECKPOINT

statement ok
CREATE TABLE signed_del (k BIGINT PRIMARY KEY)

statement ok
INSERT INTO signed_del VALUES (-1), (0)

statement ok
CREATE TABLE signed_add (k BIGINT PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO signed_add VALUES (-2, 11)

statement ok
PRAGMA git4data_create_branch('signed_branch', '')

statement ok
PRAGMA git4data_bind_branch_delta('signed', 'signed_branch', 'signed_add', 'signed_del')

# the removed keys are gone, the added row is there, and the extremes are still told apart from each other:
# -1 was removed and -2 added, so the pattern keeps neighbouring negative keys apart as well as the extremes
query II
SELECT k, v FROM signed AT (BRANCH => 'signed_branch') ORDER BY k
----
-9223372036854775808	1
-2	11
9223372036854775807	4

# the same for an unsigned key that does not fit in a signed 64-bit integer: 2^64-1 must not be read as -1,
# which is the value the signed test above removes
statement ok
CREATE TABLE unsigned_k (k UBIGINT PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO unsigned_k VALUES (0, 1), (18446744073709551615, 2)

statement ok
CHECKPOINT

statement ok
CREATE TABLE unsigned_del (k UBIGINT PRIMARY KEY)

statement ok
INSERT INTO unsigned_del VALUES (0)

statement ok
CREATE TABLE unsigned_add (k UBIGINT PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO unsigned_add VALUES (18446744073709551614, 3)

statement ok
PRAGMA git4data_create_branch('unsigned_branch', '')

statement ok
PRAGMA git4data_bind_branch_delta('unsigned_k', 'unsigned_branch', 'unsigned_add', 'unsigned_del')

query II
SELECT k, v FROM unsigned_k AT (BRANCH => 'unsigned_branch') ORDER BY k
----
18446744073709551614	3
18446744073709551615	2

# The removed table holds the source's key columns, in the order the source declares them - the read builds the
# key tuple positionally from it. This refusal had no test: a removed table with the key columns in the other
# order, or with a different column, is what it is for.
statement ok
CREATE TABLE dk2 (a INTEGER, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
INSERT INTO dk2 VALUES (1, 2, 3)

statement ok
PRAGMA git4data_create_branch('dk2b', '')

statement ok
CREATE TABLE dk2_add (a INTEGER, b INTEGER, v INTEGER)

statement ok
CREATE TABLE dk2_del_swapped (b INTEGER, a INTEGER)

statement ok
CREATE TABLE dk2_del_wrong (a INTEGER)

statement error
PRAGMA git4data_bind_branch_delta('dk2', 'dk2b', 'dk2_add', 'dk2_del_swapped')
----
<REGEX>:.*holds the keys removed from "dk2", so it needs exactly those 2 key column\(s\), in the order the source declares them.*

statement error
PRAGMA git4data_bind_branch_delta('dk2', 'dk2b', 'dk2_add', 'dk2_del_wrong')
----
<REGEX>:.*holds the keys removed from "dk2", so it needs exactly those 2 key column\(s\), in the order the source declares them.*

# the shape it wants is accepted, and the branch reads through it
statement ok
CREATE TABLE dk2_del (a INTEGER, b INTEGER)

statement ok
PRAGMA git4data_bind_branch_delta('dk2', 'dk2b', 'dk2_add', 'dk2_del')
