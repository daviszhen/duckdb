# name: test/sql/git4data/apply.test
# description: Writing to a delta branch with ordinary SQL, recorded as the delta
# group: [git4data]

load {TEST_DIR}/apply.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('before')

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
CREATE TABLE t_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_del (k INTEGER PRIMARY KEY)

# A write has nowhere to be recorded until the branch differs from its base by a delta, and the
# sentence says which call gives it somewhere. This is the rule the rest of the feature follows:
# nothing is promised that the reads cannot deliver.
statement error
PRAGMA git4data_apply('t', 'b', 'UPDATE t SET v = 1')
----
<REGEX>:.*does not differ from its base by a delta.*

statement ok
PRAGMA git4data_bind_branch_delta('t', 'b', 't_add', 't_del')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
10

# DELETE: the affected keys go into the table that hides rows from the base, and the rows stay in the
# base - which is what "a branch costs the change" means. The live table is not touched at all.
statement ok
PRAGMA git4data_apply('t', 'b', 'DELETE FROM t WHERE k < 3')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
7

query I
SELECT count(*) FROM t
----
10

query II
SELECT k, count(*) FROM t_del GROUP BY k ORDER BY k
----
0	1
1	1
2	1

# the diff between the snapshot taken before the writes and the branch sees them, because a read of
# the branch is what it diffs - there is no second copy to keep in step
query II
SELECT g4d_change, count(*) FROM git4data_diff('t', 'before', 'b') GROUP BY g4d_change ORDER BY g4d_change
----
removed	3

# UPDATE: the key is hidden from the base and the new row is added, which is what an update is in a
# delta's terms. Both halves are in the tables the caller owns, so they can be read.
statement ok
PRAGMA git4data_apply('t', 'b', 'UPDATE t SET v = v + 100 WHERE k = 3')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 3
----
103

query I
SELECT v FROM t WHERE k = 3
----
3

query II
SELECT k, v FROM t_add WHERE k = 3
----
3	103

query I
SELECT count(*) FROM t_del WHERE k = 3
----
1

# an update that rewrites the key is a removal of the old one and an addition of the new, and the
# branch shows exactly one row for it
statement ok
PRAGMA git4data_apply('t', 'b', 'UPDATE t SET k = 500 WHERE k = 4')

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b') WHERE k = 4),
       (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 500)
----
0	4

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
7

# INSERT: the row is added, and the live table still does not have it
statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t VALUES (100, 100)')

query II
SELECT (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 100), (SELECT count(*) FROM t WHERE k = 100)
----
100	0

# an insert of a key the branch already shows is refused, which is what the same insert into the
# table itself would hit - the branch's primary key is the table's
statement error
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t VALUES (5, 5)')
----
<REGEX>:.*insert collides with a row the branch already shows.*

# a key the branch *hides* is not a key it shows, so inserting it adds the row and the base row stays
# hidden: one row for that key, not two
statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t VALUES (0, 999)')

query II
SELECT count(*), max(v) FROM t AT (BRANCH => 'b') WHERE k = 0
----
1	999

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
9

# an insert with a column list, and one that takes its rows from another table
statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t (v, k) VALUES (7, 700)')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 700
----
7

statement ok
CREATE TABLE more (k INTEGER, v INTEGER)

statement ok
INSERT INTO more VALUES (800, 800)

statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t SELECT * FROM more')

query II
SELECT (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 800), (SELECT count(*) FROM t WHERE k = 800)
----
800	0

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
11

# The statement has to write the table the delta is for, and write it directly. Each refusal names
# what was wrong rather than recording a change against the wrong line.
statement error
PRAGMA git4data_apply('t', 'b', 'UPDATE other SET v = 1')
----
<REGEX>:.*the statement writes "other".*

statement error
PRAGMA git4data_apply('t', 'b', 'DELETE FROM other')
----
<REGEX>:.*the statement writes "other".*

statement error
PRAGMA git4data_apply('t', 'nowhere', 'UPDATE t SET v = 1')
----
<REGEX>:.*Branch "nowhere" does not exist.*

statement error
PRAGMA git4data_apply('t', 'b', 'CREATE TABLE x (a INTEGER)')
----
<REGEX>:.*takes INSERT, UPDATE and DELETE statements.*

statement error
PRAGMA git4data_apply('t', 'b', '')
----
<REGEX>:.*needs at least one statement.*

statement error
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t VALUES (1, 1) ON CONFLICT DO NOTHING')
----
<REGEX>:.*does not take ON CONFLICT.*

statement error
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t VALUES (1, 1) RETURNING k')
----
<REGEX>:.*does not take RETURNING.*

statement error
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t DEFAULT VALUES')
----
<REGEX>:.*does not take DEFAULT VALUES.*

statement error
PRAGMA git4data_apply('t', 'b', 'DELETE FROM t USING more WHERE t.k = more.k')
----
<REGEX>:.*does not take DELETE ... USING.*

statement error
PRAGMA git4data_apply('t', 'b', 'UPDATE t SET v = 1 FROM more WHERE t.k = more.k')
----
<REGEX>:.*does not take UPDATE ... FROM.*

# The statement is applied to the *branch*, so a bare reference to the table inside it means the
# branch's line and not the live table. Measured before this was pointed at the branch: an insert whose
# rows came from the table itself copied the live table's value (1) where the branch held 101.
statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t (k, v) SELECT k + 1000, v FROM t WHERE k = 3')

query II
SELECT (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1003), (SELECT v FROM t WHERE k = 3)
----
103	3

# and a subquery inside a predicate reads the branch too
statement ok
PRAGMA git4data_apply('t', 'b', 'DELETE FROM t WHERE k IN (SELECT k FROM t WHERE k = 700)')

query I
SELECT count(*) FROM t AT (BRANCH => 'b') WHERE k = 700
----
0

# a reference the statement names itself is left alone: naming one is a decision, not an omission
statement ok
PRAGMA git4data_create_snapshot('pinned')

statement ok
PRAGMA git4data_apply('t', 'b', 'INSERT INTO t (k, v) SELECT k + 2000, v FROM t AT (SNAPSHOT => ''pinned'') WHERE k = 3')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 2003
----
3

# An update that rewrites a key onto a key the branch already shows is the collision the same statement
# against the table itself raises. Measured before the check: it left the branch showing *two* rows for
# k = 5, where `UPDATE t SET k = 5 WHERE k = 3` against the table is a duplicate-key error. These
# probes use a table of their own so the keys they name are the ones they say.
statement ok
CREATE TABLE c (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO c SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cb', '')

statement ok
CREATE TABLE c_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE c_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('c', 'cb', 'c_add', 'c_del')

statement error
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET k = 5 WHERE k = 3')
----
<REGEX>:.*update collides with a row the branch already shows.*

# and nothing of it is left behind: the key it would have collided with is unchanged, and the row that
# was being rewritten is still there under its own key
query III
SELECT (SELECT count(*) FROM c AT (BRANCH => 'cb') WHERE k = 5),
       (SELECT count(*) FROM c AT (BRANCH => 'cb') WHERE k = 3),
       (SELECT count(*) FROM c AT (BRANCH => 'cb'))
----
1	1	10

# rewriting a key onto a key the branch does not have is an ordinary update, and the row keeps its other
# columns: `SET v = 99` then `SET k = 400` leaves one row at 400 carrying 99
statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET v = 99 WHERE k = 8')

statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET k = 400 WHERE k = 8')

query II
SELECT (SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 400),
       (SELECT count(*) FROM c AT (BRANCH => 'cb') WHERE k = 8)
----
99	0

# two rows swapping keys is not a collision either: each key the statement writes is one it is replacing
statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET k = 9000 WHERE k = 9')

statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET k = 9 WHERE k = 400')

statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET k = 400 WHERE k = 9000')

# the values travel with their rows: k = 400 ends up carrying what k = 9 held, and k = 9 what k = 400 held
query III
SELECT (SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 400),
       (SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 9),
       (SELECT count(*) FROM c AT (BRANCH => 'cb'))
----
9	99	10

# A group reads its own writes: the delta's two tables are the caller's own, so a statement in a group
# sees what the statements before it in that group wrote - to the tables and to the branch. Measured
# before this: the scans of those tables read committed row groups only, so uncommitted rows were
# invisible - `INSERT INTO t VALUES (50, 50); UPDATE t SET v = 51 WHERE k = 50` left 50, and a group
# that deleted a key and re-inserted it was refused as a collision.
statement ok
PRAGMA git4data_apply('c', 'cb', 'INSERT INTO c VALUES (50, 50); UPDATE c SET v = 51 WHERE k = 50')

query I
SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 50
----
51

statement ok
PRAGMA git4data_apply('c', 'cb', 'DELETE FROM c WHERE k = 6; INSERT INTO c VALUES (6, 66)')

query II
SELECT (SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 6),
       (SELECT count(*) FROM c AT (BRANCH => 'cb') WHERE k = 6)
----
66	1

# and the same holds inside a transaction the caller opened: the branch reads what that transaction has
# written, and the write rolls back with it
statement ok
BEGIN

statement ok
PRAGMA git4data_apply('c', 'cb', 'UPDATE c SET v = 777 WHERE k = 7')

query I
SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 7
----
777

statement ok
ROLLBACK

query I
SELECT v FROM c AT (BRANCH => 'cb') WHERE k = 7
----
7

# The diff reads the same tables the branch does, so it sees the caller's own uncommitted writes to
# them as well - and the pick and the merge are built on that diff. Measured before this: inside the
# transaction that inserted a row, the branch read showed it and the diff reported nothing added. This
# uses a table of its own so the changes it asserts are the only ones there are.
statement ok
CREATE TABLE tx (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO tx SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('tx_before')

statement ok
PRAGMA git4data_create_branch('txb', '')

statement ok
CREATE TABLE tx_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE tx_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('tx', 'txb', 'tx_add', 'tx_del')

statement ok
BEGIN

statement ok
PRAGMA git4data_apply('tx', 'txb', 'INSERT INTO tx VALUES (4000, 4000)')

statement ok
PRAGMA git4data_apply('tx', 'txb', 'DELETE FROM tx WHERE k = 4')

query II
SELECT g4d_change, k FROM git4data_diff('tx', 'tx_before', 'txb') ORDER BY g4d_change, k
----
added	4000
removed	4

# and a pick inside that transaction applies what the branch has written so far
statement ok
PRAGMA git4data_pick('tx', 'txb', 'tx_before', 'fail')

query III
SELECT (SELECT count(*) FROM tx WHERE k = 4000),
       (SELECT count(*) FROM tx WHERE k = 4),
       (SELECT v FROM tx WHERE k = 4000)
----
1	0	4000

statement ok
ROLLBACK

# the transaction took its work with it: neither the live table nor the branch has it
query II
SELECT (SELECT count(*) FROM tx WHERE k = 4000), (SELECT count(*) FROM tx AT (BRANCH => 'txb') WHERE k = 4000)
----
0	0

# a refusal leaves the branch alone: nothing was written before the statement was checked
query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
12

# the line the branch holds is the delta, so it comes back with the file
statement ok
CHECKPOINT

restart

query III
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')),
       (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 3),
       (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 800)
----
12	103	800

# and it can still be written to after the reopen
statement ok
PRAGMA git4data_apply('t', 'b', 'DELETE FROM t WHERE k = 800')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
11

# The changes a branch accumulated through plain SQL are the changes any other reference has over
# this one, so a pick applies them to the live table: the feature's other modules need no special
# case for a line that was written through this one.
statement ok
PRAGMA git4data_pick('t', 'b', 'before', 'fail')

query III
SELECT (SELECT count(*) FROM t), (SELECT v FROM t WHERE k = 3), (SELECT v FROM t WHERE k = 500)
----
11	103	4

# A group of statements is one unit of work: they are translated against the same delta and handed back
# together, so the caller's statements land in one transaction. Measured on a fresh table:
statement ok
CREATE TABLE g (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO g SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('gb', '')

statement ok
CREATE TABLE g_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE g_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('g', 'gb', 'g_add', 'g_del')

statement ok
PRAGMA git4data_apply('g', 'gb', 'UPDATE g SET v = 111 WHERE k = 1; DELETE FROM g WHERE k = 2; INSERT INTO g VALUES (100, 100)')

query IIII
SELECT (SELECT v FROM g AT (BRANCH => 'gb') WHERE k = 1),
       (SELECT count(*) FROM g AT (BRANCH => 'gb') WHERE k = 2),
       (SELECT v FROM g AT (BRANCH => 'gb') WHERE k = 100),
       (SELECT count(*) FROM g AT (BRANCH => 'gb'))
----
111	0	100	10

# and one failing statement takes the whole group with it: the update of k = 3 is not there afterwards,
# and the delta tables are empty - which is what makes a group a unit of work rather than a sequence of
# writes that a caller has to undo by hand
statement error
PRAGMA git4data_apply('g', 'gb', 'UPDATE g SET v = 222 WHERE k = 3; INSERT INTO g VALUES (5, 5)')
----
<REGEX>:.*insert collides with a row the branch already shows.*

query III
SELECT (SELECT v FROM g AT (BRANCH => 'gb') WHERE k = 3),
       (SELECT count(*) FROM g_add WHERE k = 3),
       (SELECT count(*) FROM g_del WHERE k = 3)
----
3	0	0

# A source table can be renamed under a mapping, and the mapping follows the table it was bound to - a read
# already did. The write path looked the delta up by the name it was bound under, so a renamed source
# refused with "does not differ from its base by a delta"; the oid finds it, the way it does on a read.
statement ok
ALTER TABLE g RENAME TO g2

statement error
PRAGMA git4data_apply('g', 'gb', 'INSERT INTO g VALUES (200, 200)')
----
<REGEX>:.*Table with name g does not exist.*

statement ok
PRAGMA git4data_apply('g2', 'gb', 'INSERT INTO g2 VALUES (200, 200)')

query II
SELECT k, v FROM g2 AT (BRANCH => 'gb') WHERE k = 200
----
200	200

statement ok
PRAGMA git4data_apply('g2', 'gb', 'DELETE FROM g2 WHERE k = 100')

query I
SELECT count(*) FROM g2 AT (BRANCH => 'gb') WHERE k = 100
----
0

# the delta edit went to the tables the mapping named, not to tables of the renamed source
query II
SELECT (SELECT count(*) FROM g_add WHERE k = 200), (SELECT count(*) FROM g_del WHERE k = 100)
----
1	1
