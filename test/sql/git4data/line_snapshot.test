# name: test/sql/git4data/line_snapshot.test
# description: A reference that captures a branch's own line rather than the table at a commit
# group: [git4data]

load {TEST_DIR}/line_snapshot.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b')

# b's own line now differs from the table, in a table of its own. A pin cannot point at that, which is
# the gap this reference closes: a snapshot of the table at this commit reads the main line, and a
# snapshot that names b reads what b holds.
statement ok
UPDATE t_b SET v = -1 WHERE k = 1

statement ok
PRAGMA git4data_create_snapshot('plain')

statement ok
PRAGMA git4data_create_snapshot('of_b', 'b')

query II
SELECT (SELECT v FROM t AT (SNAPSHOT => 'plain') WHERE k = 1),
       (SELECT v FROM t AT (SNAPSHOT => 'of_b') WHERE k = 1)
----
1	-1

# the branch itself reads the same thing the captured line does
query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1
----
-1

# both are still references to the same source table, and neither sees a row added after its pin
statement ok
INSERT INTO t VALUES (2000, 2000)

query II
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => 'plain')), (SELECT count(*) FROM t AT (SNAPSHOT => 'of_b'))
----
100	100

# a captured line composes with the diff, because a diff reads each side as the reference it names
query I
SELECT count(*) FROM git4data_diff('t', 'plain', 'of_b')
----
1

# the listing gains a column saying which references capture a line; its content is asserted by
# git4data-retention-check.sh, which can read the pragma's output directly
statement ok
PRAGMA git4data_snapshots;

# a line has to exist before it can be captured
statement ok
PRAGMA git4data_create_branch('root', '')

statement error
PRAGMA git4data_create_snapshot('nosuch', 'missing')
----
<REGEX>:.*Branch "missing" does not exist.*

statement error
PRAGMA git4data_create_snapshot('base_only', 'root')
----
<REGEX>:.*has no line of its own, so there is nothing to capture.*

# A fork from the captured line takes that state, which is what the reference is for: the child carries
# the line and reads it as it stood at the pin
statement ok
PRAGMA git4data_create_branch('child', 'of_b')

query I
SELECT v FROM t AT (BRANCH => 'child') WHERE k = 1
----
-1

# the branch the line came from moves on, and the child's state does not: the pin is what it reads at
statement ok
UPDATE t_b SET v = -9 WHERE k = 1

query II
SELECT (SELECT v FROM t AT (BRANCH => 'child') WHERE k = 1),
       (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1)
----
-1	-9

# a fork taking a state is what the child's own storage then starts from
statement ok
PRAGMA git4data_materialize('t', 'child', 't_child')

query II
SELECT (SELECT v FROM t_child WHERE k = 1), (SELECT count(*) FROM t_child)
----
-1	100

# the line the child carries is held down by it
statement error
PRAGMA git4data_drop_branch('b')
----
<REGEX>:.*captured its line.*

# the reference and the line the child carries both survive a reopen, which is the half of it the
# registry block does
statement ok
CHECKPOINT

restart

query III
SELECT (SELECT v FROM t AT (SNAPSHOT => 'of_b') WHERE k = 1),
       (SELECT v FROM t AT (SNAPSHOT => 'plain') WHERE k = 1),
       (SELECT v FROM t AT (BRANCH => 'child') WHERE k = 1)
----
-1	1	-1

# and dropping is still held back by the child after the reopen
statement error
PRAGMA git4data_drop_branch('b')
----
<REGEX>:.*captured its line.*

statement ok
PRAGMA git4data_snapshots;

# A reference that captured a branch's line is held to that line, so the branch cannot be dropped out from
# under it either: the reference would go on existing under the same name, reading the pinned image of the
# table instead. Measured, a captured v = 111 read as v = 1 after the branch was dropped, which is a name
# answering with a state it never captured.
statement ok
CREATE TABLE c (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO c SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cb', '')

statement ok
PRAGMA git4data_materialize('c', 'cb', 'c_b')

statement ok
UPDATE c_b SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_snapshot('cs', 'cb')

query I
SELECT v FROM c AT (SNAPSHOT => 'cs') WHERE k = 1
----
111

statement error
PRAGMA git4data_drop_branch('cb')
----
<REGEX>:.*Snapshot "cs" captured a line of branch "cb".*

# and the line it captured is still that line
query I
SELECT v FROM c AT (SNAPSHOT => 'cs') WHERE k = 1
----
111

# with the snapshot gone the branch goes, and takes the table it was given
statement ok
PRAGMA git4data_drop_snapshot('cs')

statement ok
PRAGMA git4data_drop_branch('cb')

statement error
SELECT count(*) FROM c_b
----
<REGEX>:.*Table with name c_b does not exist.*

query I
SELECT count(*) FROM c
----
4


# A capture holds against writes made *after* it, for both shapes a branch can hold its line in. This is the
# promise that could break most quietly, because a branch reads a copy or a delta's tables as the caller has
# them, so a capture that did the same would answer with rows and values from after the commit it pinned.
# Measured by hand before this test existed: with a capture of a branch holding a copy, a later v = 222 and
# an appended row were invisible to the capture while the branch read both.
statement ok
CREATE TABLE cap_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO cap_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cap_b', '')

statement ok
PRAGMA git4data_materialize('cap_src', 'cap_b', 'cap_copy')

statement ok
UPDATE cap_copy SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_snapshot('cap_s', 'cap_b')

statement ok
CHECKPOINT

statement ok
UPDATE cap_copy SET v = 222 WHERE k = 1

statement ok
INSERT INTO cap_copy VALUES (77, 77)

query II
SELECT (SELECT v FROM cap_src AT (BRANCH => 'cap_b') WHERE k = 1),
       (SELECT count(*) FROM cap_src AT (BRANCH => 'cap_b'))
----
222	5

query II
SELECT (SELECT v FROM cap_src AT (SNAPSHOT => 'cap_s') WHERE k = 1),
       (SELECT count(*) FROM cap_src AT (SNAPSHOT => 'cap_s'))
----
111	4

# the same for a line that differs by a delta: the delta's tables are the caller's, but a capture reads them
# at its pin
statement ok
CREATE TABLE cap_d_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO cap_d_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cap_d', '')

statement ok
CREATE TABLE cap_d_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE cap_d_del (k INTEGER PRIMARY KEY)

statement ok
INSERT INTO cap_d_add VALUES (100, 100)

statement ok
INSERT INTO cap_d_del VALUES (1)

statement ok
PRAGMA git4data_bind_branch_delta('cap_d_src', 'cap_d', 'cap_d_add', 'cap_d_del')

statement ok
PRAGMA git4data_create_snapshot('cap_d_s', 'cap_d')

statement ok
CHECKPOINT

statement ok
INSERT INTO cap_d_add VALUES (500, 500)

statement ok
DELETE FROM cap_d_del WHERE k = 1

statement ok
INSERT INTO cap_d_del VALUES (2)

query II
SELECT (SELECT count(*) FROM cap_d_src AT (BRANCH => 'cap_d')),
       (SELECT count(*) FROM cap_d_src AT (BRANCH => 'cap_d') WHERE k = 500)
----
5	1

query II
SELECT (SELECT count(*) FROM cap_d_src AT (SNAPSHOT => 'cap_d_s')),
       (SELECT count(*) FROM cap_d_src AT (SNAPSHOT => 'cap_d_s') WHERE k = 500)
----
4	0
