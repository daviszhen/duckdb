# name: test/sql/git4data/workflow.test
# description: The whole feature set on one table, in the order a person would use it
# group: [git4data]

load {TEST_DIR}/workflow.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(1000)

statement ok
CHECKPOINT

# 1. tag the state that is known good
statement ok
PRAGMA git4data_create_snapshot('v1')

# 2. start a line from it and work on it: the point of forking from a snapshot is that the line
#    begins where the tag is, not where the table now is
statement ok
PRAGMA git4data_create_branch('feature', 'v1')

statement ok
PRAGMA git4data_materialize('t', 'feature', 't_feature')

statement ok
UPDATE t_feature SET v = v + 10000 WHERE k < 10

statement ok
DELETE FROM t_feature WHERE k >= 10 AND k < 20

statement ok
INSERT INTO t_feature VALUES (2000, 2000)

statement ok
CHECKPOINT

# 3. the main line moves on independently, and by a different number of appended rows
statement ok
UPDATE t SET v = -1 WHERE k = 999

statement ok
INSERT INTO t VALUES (3000, 3000)

statement ok
CHECKPOINT

# 4. the three states are all readable and all different at the keys that were touched
query IIIII
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => 'v1')), (SELECT v FROM t WHERE k = 0),
       (SELECT v FROM t AT (BRANCH => 'feature') WHERE k = 0), (SELECT v FROM t WHERE k = 999),
       (SELECT count(*) FROM t)
----
1000	0	10000	-1	1001

# 5. what the branch did, read as a diff against the tag it forked from
query II
SELECT change, count(*) FROM git4data_diff('t', 'v1', 'feature') GROUP BY change ORDER BY change
----
added	1
changed	10
removed	10

# 6. bring those changes into the main line; the one key the main line changed itself is a conflict
#    only if both sides changed it, and here they did not
statement ok
PRAGMA git4data_pick('t', 'feature', 'v1', 'fail')

query III
SELECT (SELECT v FROM t WHERE k = 0), (SELECT v FROM t WHERE k = 1), (SELECT count(*) FROM t)
----
10000	10001	992

# 7. the branch is still its own line
query I
SELECT v FROM t AT (BRANCH => 'feature') WHERE k = 0
----
10000

# 8. tag again, then rewind the main line to the first tag
statement ok
PRAGMA git4data_create_snapshot('v2')

statement ok
PRAGMA git4data_restore('t', 'v1')

query III
SELECT (SELECT count(*) FROM t), (SELECT v FROM t WHERE k = 0), (SELECT v FROM t WHERE k = 999)
----
1000	0	999

# 9. a recovery window keeps the newest state reachable without a tag of its own
statement ok
PRAGMA git4data_restore('t', 'v2')

statement ok
PRAGMA git4data_pitr(3650)

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
992

# 10. churn under the window, then reclaim what no reference reaches
statement ok
INSERT INTO t SELECT 100000 + range, 100000 + range FROM range(100000)

statement ok
DELETE FROM t WHERE k >= 100000 AND k % 2 = 1

statement ok
CHECKPOINT

statement ok
CHECKPOINT

query III
SELECT (SELECT count(*) FROM t), (SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'v1'))
----
50992	992	1000

# 11. dropping the references leaves the live table alone, and a checkpoint still agrees with it
statement ok
PRAGMA git4data_drop_snapshot('v1')

statement ok
PRAGMA git4data_drop_snapshot('v2')

statement ok
PRAGMA git4data_drop_branch('feature')

statement ok
PRAGMA git4data_pitr_off

statement ok
CHECKPOINT

query I
SELECT count(*) FROM t
----
50992

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 't_feature'
----
0
