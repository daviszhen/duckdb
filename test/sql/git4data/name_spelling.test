# name: test/sql/git4data/name_spelling.test
# description: The name a mapping records, and what a read of a table that was swapped under it does
# group: [git4data]

# A name a caller writes is SQL: `t_b`, `"t_b"` and `main.t_b` are one table, and what a mapping records is which
# table it is about. It used to record the *spelling* instead - so a copy named `"t_b"` left a row holding `"t_b"`
# with its quotes, which matches neither the name the catalog gives the table nor anything the identity guard
# compares a mapping against. The guard then did not run at all, and after a reopen a table dropped and recreated
# under that name was read as the branch's own line: measured, the read answered with the replacement's rows
# (1998) where the same sequence spelled plainly is refused. That is the wrong answer decision 2 exists to
# prevent, so both spellings are asserted here, along with a name that only quoting can write as one identifier.

load {TEST_DIR}/name_spelling.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20)

statement ok
PRAGMA git4data_create_branch('b', '')

# the copy is asked for under the name SQL writes for it; what the row records is the name the table has
statement ok
PRAGMA git4data_materialize('t', 'b', '"t_b"')

query I
SELECT storage FROM git4data.storage
----
t_b

query I
SELECT sum(v) FROM t AT (BRANCH => 'b')
----
30

# the caller drops the table the branch was given and puts another one of the same name and shape there
statement ok
DROP TABLE t_b

statement ok
CREATE TABLE t_b (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_b VALUES (1, 999), (2, 999)

# in this session the id of the table it was given is known, so this is the refusal that does not need the
# identity at all
statement error
SELECT sum(v) FROM t AT (BRANCH => 'b')
----
<REGEX>:.*the table carrying that name now is not it.*

restart

# After a reopen the ids are gone and the identity the table carries is what catches the replacement - and it can
# only catch it if the mapping was written under a name the guard matches, which is what this file is about.
statement error
SELECT sum(v) FROM t AT (BRANCH => 'b')
----
<REGEX>:.*that is not the table it was given.*

# A name that has to be quoted to be one identifier is recorded the same way, and a mapping about it is found
# through the same comparison: the dot is part of the table's name here, not a schema boundary.
statement ok
CREATE TABLE "c1.dot" (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO "c1.dot" VALUES (1, 5)

statement ok
PRAGMA git4data_create_snapshot('s')

statement ok
PRAGMA git4data_create_branch('bd', 's')

statement ok
PRAGMA git4data_materialize('"c1.dot"', 'bd', '"c2.dot"')

query I
SELECT sum(v) FROM "c1.dot" AT (BRANCH => 'bd')
----
5

# and the guard works for it too: the table it was given is replaced, and the read is refused rather than answered
# from a table the reference never saw
statement ok
DROP TABLE "c2.dot"

statement ok
CREATE TABLE "c2.dot" (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO "c2.dot" VALUES (1, 777)

statement error
SELECT sum(v) FROM "c1.dot" AT (BRANCH => 'bd')
----
<REGEX>:.*the table carrying that name now is not it.*
