# name: test/sql/git4data/combinations.test
# description: The features in combination, where the individual tests leave the matrix to the reader
# group: [git4data]

load {TEST_DIR}/combinations.db

# Every module here is covered on its own. What a reader cannot see from that is whether the *pairs* work,
# and each of the three below was probed first: a window with a delta branch, a captured line with a delta
# on the child, and a restore beside a branch that holds a line of its own. They are separate mechanisms -
# a window is a reference the database manages, a captured line is one a child inherits, a restore writes
# the live table - so each pair is a place where one could have been written without the other in mind.

# 1. A point-in-time window and a delta branch, open and closed.
statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('d', '')

statement ok
CREATE TABLE d_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE d_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('t', 'd', 'd_add', 'd_del')

statement ok
PRAGMA git4data_apply('t', 'd', 'DELETE FROM t WHERE k < 50')

# the window is a reference the database keeps; the branch is one the caller keeps, and both hold the
# timeline down at once
statement ok
PRAGMA git4data_pitr(3600)

query I
SELECT count(*) FROM t AT (BRANCH => 'd')
----
50

statement ok
PRAGMA git4data_apply('t', 'd', 'INSERT INTO t VALUES (500, 500)')

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'd')), (SELECT count(*) FROM t AT (BRANCH => 'd') WHERE k = 500)
----
51	1

# and the live table never took any of it
query I
SELECT count(*) FROM t
----
100

# closing the window takes the database's own reference away and leaves the branch reading what it holds
statement ok
PRAGMA git4data_pitr(0)

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'd')), (SELECT count(*) FROM t AT (BRANCH => 'd') WHERE k = 500)
----
51	1

# 2. A captured line with a delta on the child that inherited it.
statement ok
CREATE TABLE c (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO c SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('parent', '')

statement ok
PRAGMA git4data_materialize('c', 'parent', 'c_parent')

statement ok
UPDATE c_parent SET v = 111 WHERE k = 1

# the child inherits the parent's line at the commit the capture names
statement ok
PRAGMA git4data_create_snapshot('cap', 'parent')

statement ok
PRAGMA git4data_create_branch('child', 'cap')

query I
SELECT v FROM c AT (BRANCH => 'child') WHERE k = 1
----
111

# and its own delta sits on top of what it inherited
statement ok
CREATE TABLE child_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE child_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('c', 'child', 'child_add', 'child_del')

statement ok
PRAGMA git4data_apply('c', 'child', 'UPDATE c SET v = 222 WHERE k = 2')

query III
SELECT (SELECT v FROM c AT (BRANCH => 'child') WHERE k = 1),
       (SELECT v FROM c AT (BRANCH => 'child') WHERE k = 2),
       (SELECT count(*) FROM c AT (BRANCH => 'child'))
----
111	222	10

# 3. A restore beside a branch that holds a line of its own: the restore writes the live table and the
# branch's own table is not what it writes.
statement ok
PRAGMA git4data_apply('c', 'child', 'INSERT INTO c VALUES (900, 900)')

statement ok
PRAGMA git4data_restore('c', 'child')

query III
SELECT (SELECT count(*) FROM c), (SELECT v FROM c WHERE k = 2), (SELECT count(*) FROM c WHERE k = 900)
----
11	222	1

# the branch's own table still holds its line, and the child still reads it
query II
SELECT (SELECT v FROM c AT (BRANCH => 'child') WHERE k = 2), (SELECT count(*) FROM c_parent)
----
222	10

# 4. A *write* through a branch that both inherits a line and has a delta of its own - the shape two overlays
# make, and the one a write is hardest on: the branch's own delta records the change while the line it inherited
# stays as it was. Probed before it was written down: updating a row that came from the *inherited* delta's
# added table left the branch reading the new value once and the branch it inherited from untouched.
statement ok
CREATE TABLE ov (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ov SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('ovb', '')

statement ok
CREATE TABLE ovb_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ovb_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ov', 'ovb', 'ovb_add', 'ovb_del')

statement ok
INSERT INTO ovb_add VALUES (100, 100)

statement ok
INSERT INTO ovb_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('ovc', 'ovb')

statement ok
CREATE TABLE ovc_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ovc_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ov', 'ovc', 'ovc_add', 'ovc_del')

statement ok
INSERT INTO ovc_add VALUES (200, 200)

query III
SELECT (SELECT count(*) FROM ov AT (BRANCH => 'ovc')),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 100),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 2)
----
6	1	0

# the row it changes came from the inherited delta, and the change lands in its own tables
statement ok
PRAGMA git4data_apply('ov', 'ovc', 'UPDATE ov SET v = 555 WHERE k = 100')

query IIII
SELECT (SELECT count(*) FROM ov AT (BRANCH => 'ovc')),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 100 AND v = 555),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 100 AND v = 100),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovb') WHERE k = 100 AND v = 100)
----
6	1	0	1

query II
SELECT (SELECT count(*) FROM ovc_add), (SELECT count(*) FROM ovc_del)
----
2	1

# and removing it takes it out of the branch without touching the line it inherited
statement ok
PRAGMA git4data_apply('ov', 'ovc', 'DELETE FROM ov WHERE k = 100')

query II
SELECT (SELECT count(*) FROM ov AT (BRANCH => 'ovc')),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 100)
----
5	0

query II
SELECT (SELECT count(*) FROM ov AT (BRANCH => 'ovb') WHERE k = 100),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovb'))
----
1	5

# taking the branch's own delta back leaves it reading the line it inherited, which is what it has
statement ok
PRAGMA git4data_unbind('ov', 'ovc')

query III
SELECT (SELECT count(*) FROM ov AT (BRANCH => 'ovc')),
       (SELECT count(*) FROM ov AT (BRANCH => 'ovc') WHERE k = 100),
       (SELECT line FROM git4data_branches() WHERE branch_name = 'ovc')
----
5	1	ovb

# 5. A chain of forks: each link inherits the line of the one before it, so a read at the end walks the whole
# chain. Probed before it was written down - the fork rule did not take an inherited line with it until 3bu, and
# a chain read the raw table one hop down.
statement ok
CREATE TABLE ch (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ch SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('ch0', '')

statement ok
CREATE TABLE ch0_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ch0_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ch', 'ch0', 'ch0_add', 'ch0_del')

statement ok
INSERT INTO ch0_add VALUES (100, 100)

statement ok
INSERT INTO ch0_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('ch1', 'ch0')

statement ok
PRAGMA git4data_create_branch('ch2', 'ch1')

statement ok
PRAGMA git4data_create_branch('ch3', 'ch2')

query IIII
SELECT (SELECT count(*) FROM ch AT (BRANCH => 'ch1')),
       (SELECT count(*) FROM ch AT (BRANCH => 'ch2')),
       (SELECT count(*) FROM ch AT (BRANCH => 'ch3')),
       (SELECT count(*) FROM ch AT (BRANCH => 'ch3') WHERE k = 2)
----
5	5	5	0

query II
SELECT line, parent FROM git4data_branches() WHERE branch_name = 'ch3'
----
ch2	ch2

# the ancestor walk sees every link
query I
PRAGMA git4data_lca('ch3', 'ch1')
----
ch1

query I
PRAGMA git4data_lca('ch3', 'ch0')
----
ch0

# a capture of a middle link reads what that link reads, and a fork from the capture reads it too
statement ok
PRAGMA git4data_create_snapshot('ch2_cap', 'ch2')

query III
SELECT (SELECT count(*) FROM ch AT (SNAPSHOT => 'ch2_cap')),
       (SELECT count(*) FROM ch AT (BRANCH => 'ch3')),
       (SELECT count(*) FROM ch AT (SNAPSHOT => 'ch2_cap') WHERE k = 100)
----
5	5	1

# restoring the live table to the end of the chain rewinds it to what the chain reads
statement ok
PRAGMA git4data_restore('ch', 'ch3')

query III
SELECT (SELECT count(*) FROM ch), (SELECT count(*) FROM ch WHERE k = 100), (SELECT count(*) FROM ch WHERE k = 2)
----
5	1	0

# and the middle link can still be materialized: the copy holds what the chain reads, not the raw table
statement ok
PRAGMA git4data_materialize('ch', 'ch2', 'ch2_copy')

query II
SELECT (SELECT count(*) FROM ch2_copy), (SELECT count(*) FROM ch2_copy WHERE k = 100)
----
5	1

# 6. A merge whose *target* is a branch with two overlays: the landing has to go on top of a line the target
# inherited while its own delta records the change. Probed before it was written down: merging a sibling of the
# same line into it brought the sibling's change over and left the line the target inherited, and the sibling,
# untouched.
statement ok
CREATE TABLE mg (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO mg SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('mg0', '')

statement ok
CREATE TABLE mg0_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE mg0_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('mg', 'mg0', 'mg0_add', 'mg0_del')

statement ok
INSERT INTO mg0_add VALUES (100, 100)

statement ok
INSERT INTO mg0_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('mg1', 'mg0')

statement ok
CREATE TABLE mg1_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE mg1_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('mg', 'mg1', 'mg1_add', 'mg1_del')

statement ok
INSERT INTO mg1_add VALUES (200, 200)

statement ok
INSERT INTO mg1_del VALUES (3)

statement ok
PRAGMA git4data_create_branch('mg2', 'mg0')

statement ok
CREATE TABLE mg2_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE mg2_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('mg', 'mg2', 'mg2_add', 'mg2_del')

statement ok
INSERT INTO mg2_add VALUES (300, 300)

statement ok
INSERT INTO mg2_del VALUES (4)

query IIIIII
SELECT (SELECT count(*) FROM mg AT (BRANCH => 'mg1')),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg2')),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 200),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 300),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 3),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 4)
----
5	5	1	0	0	1

statement ok
PRAGMA git4data_merge('mg', 'mg1', 'mg2', 'fail')

# the target keeps its line and its own change, takes the sibling's change, and the sibling and the shared
# ancestor are untouched
query IIIIIIII
SELECT (SELECT count(*) FROM mg AT (BRANCH => 'mg1')),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 100),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 200),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 300),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 2),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 3),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg1') WHERE k = 4),
       (SELECT count(*) FROM mg AT (BRANCH => 'mg2'))
----
5	1	1	1	0	0	0	5

query I
SELECT count(*) FROM mg AT (BRANCH => 'mg0')
----
5

# 7. A point-in-time window beside a *chain*: the window is one reference the database moves itself at each
# checkpoint, and the chain's links are references the caller made. The window may not keep history (a window of
# zero keeps nothing), so what holds the chain's pins down is the chain. Probed before it was written down: with
# a zero-day window and a checkpoint, the chain read exactly what it read before, and the retention bound stayed
# at the chain's oldest pin rather than moving up to the window's.
statement ok
CREATE TABLE pw (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO pw SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('pw0', '')

statement ok
CREATE TABLE pw0_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE pw0_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('pw', 'pw0', 'pw0_add', 'pw0_del')

statement ok
INSERT INTO pw0_add VALUES (100, 100)

statement ok
INSERT INTO pw0_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('pw1', 'pw0')

statement ok
PRAGMA git4data_create_branch('pw2', 'pw1')

# the bound before the window is what the chain holds it at, and a window of zero keeps nothing of its own
query IIII
SELECT (SELECT count(*) FROM pw AT (BRANCH => 'pw2')),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw2') WHERE k = 100),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw2') WHERE k = 2),
       (SELECT history_retained FROM git4data_state())
----
5	1	0	true

statement ok
PRAGMA git4data_pitr(0)

statement ok
CHECKPOINT

query IIII
SELECT (SELECT count(*) FROM pw AT (BRANCH => 'pw2')),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw1')),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw0')),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw2') WHERE k = 2)
----
5	5	5	0

# the window holds a reference of its own, which is what it moves; the chain is untouched by that
query III
SELECT (SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = '__pitr__'),
       (SELECT reference_held FROM git4data_pitr_state()),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw2') WHERE k = 100)
----
1	true	1

statement ok
PRAGMA git4data_pitr(7)

statement ok
INSERT INTO pw VALUES (500, 500)

statement ok
CHECKPOINT

# a write and a checkpoint do not disturb the chain: it reads its pins, not the table
query IIII
SELECT (SELECT count(*) FROM pw AT (BRANCH => 'pw2')),
       (SELECT count(*) FROM pw AT (BRANCH => 'pw2') WHERE k = 500),
       (SELECT count(*) FROM pw),
       (SELECT history_retained FROM git4data_state())
----
5	0	6	true

# 8. More than one source, with two overlays on one of them: a branch inherits a line for every source its parent
# has one for, and its own delta covers *one* source - so a read of the other must be unaffected by it. Probed
# before it was written down: the child read the parent's line for both sources, its own delta applied to one,
# and a write through it for that source left the other alone.
statement ok
CREATE TABLE ms1t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ms1t SELECT range, range FROM range(4)

statement ok
CREATE TABLE ms2t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ms2t SELECT range * 10, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('msp', '')

statement ok
CREATE TABLE msp1_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE msp1_del (k INTEGER PRIMARY KEY)

statement ok
CREATE TABLE msp2_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE msp2_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ms1t', 'msp', 'msp1_add', 'msp1_del')

statement ok
PRAGMA git4data_bind_branch_delta('ms2t', 'msp', 'msp2_add', 'msp2_del')

statement ok
INSERT INTO msp1_add VALUES (100, 100)

statement ok
INSERT INTO msp1_del VALUES (1)

statement ok
INSERT INTO msp2_add VALUES (200, 200)

statement ok
PRAGMA git4data_create_branch('msc', 'msp')

statement ok
CREATE TABLE msc1_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE msc1_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ms1t', 'msc', 'msc1_add', 'msc1_del')

statement ok
INSERT INTO msc1_add VALUES (300, 300)

statement ok
INSERT INTO msc1_del VALUES (100)

# the child applies its own delta to the first source and the inherited line as it stands to the second
query IIII
SELECT (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms1t AT (BRANCH => 'msc')),
       (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms1t AT (BRANCH => 'msp')),
       (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms2t AT (BRANCH => 'msc')),
       (SELECT count(*) FROM ms2t AT (BRANCH => 'msc') WHERE k = 0)
----
0,2,3,300	0,2,3,100	0,10,20,30,200	1

# the listing says which sources the branch holds something of its own for, and which line the rest comes from
query III
SELECT line, delta_source, delta_added FROM git4data_branches() WHERE branch_name = 'msc'
----
msp	ms1t	msc1_add

statement ok
PRAGMA git4data_apply('ms1t', 'msc', 'INSERT INTO ms1t VALUES (400, 400)')

query III
SELECT (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms1t AT (BRANCH => 'msc')),
       (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms1t AT (BRANCH => 'msp')),
       (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM ms2t AT (BRANCH => 'msc'))
----
0,2,3,300,400	0,2,3,100	0,10,20,30,200
