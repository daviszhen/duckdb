# name: test/sql/git4data/schema_source.test
# description: A source that is not in the default schema, and a source that is temporary
# group: [git4data]

load {TEST_DIR}/schema_source.db

# Every other test here keeps its tables in `main`, and every other test's source is a permanent table.
# Both were probed before anything was written down and both are correct, so this file pins what would
# otherwise be an unstated assumption: the feature names tables the way SQL does - through the search
# path - and a temporary table can be a source like any other.
statement ok
CREATE SCHEMA other

statement ok
CREATE TABLE other.t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO other.t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
USE other

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
CREATE TABLE t_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('t', 'b', 't_add', 't_del')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
10

statement ok
PRAGMA git4data_apply('t', 'b', 'UPDATE t SET v = 111 WHERE k = 1')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1
----
111

# the copy materialize makes lands in the schema the name resolves in, which is the source's own - not
# silently in `main`
statement ok
PRAGMA git4data_materialize('t', 'b', 't_copy')

query I
SELECT count(*) FROM t AT (BRANCH => 'b')
----
10

query III
SELECT (SELECT count(*) FROM other.t_copy),
       (SELECT count(*) FROM other.t_add WHERE k = 1),
       (SELECT count(*) FROM other.t_del WHERE k = 1)
----
10	1	1

query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name IN ('t_copy', 't_add', 't_del')
----
0

# A temporary table can be a source: a snapshot of it reads through the pin, and a branch can be given a
# copy of it. What a temporary table cannot do is outlive the connection, so a reference to one is only
# as durable as the table it names - which is the caller's to know, and not something the feature hides.
statement ok
CREATE TEMP TABLE tt (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO tt SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_snapshot('temp_pin')

query I
SELECT count(*) FROM tt AT (SNAPSHOT => 'temp_pin')
----
5

statement ok
CREATE TEMP TABLE tt_line (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO tt_line SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('temp_branch', '')

statement ok
PRAGMA git4data_bind_branch_table('tt', 'temp_branch', 'tt_line')

query I
SELECT count(*) FROM tt AT (BRANCH => 'temp_branch')
----
5

statement ok
UPDATE tt_line SET v = 99 WHERE k = 2

query I
SELECT v FROM tt AT (BRANCH => 'temp_branch') WHERE k = 2
----
99
