# name: test/sql/git4data/listings.test
# description: The listings as rows a statement can select, so their values are asserted and not only their shape
# group: [git4data]

# `PRAGMA git4data_branches` and `PRAGMA git4data_snapshots` return a result, and a result cannot be selected
# *from*: every value in them - which tables a branch reads, whether those tables are still there, the line a
# capture holds - was readable by a person and asserted only by its shape. The rows are table functions now,
# which is what this file uses; the pragmas return them, so the two surfaces cannot drift apart.

load {TEST_DIR}/listings.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('plain_branch', '')

statement ok
PRAGMA git4data_materialize('t', 'plain_branch', 'b_copy')

statement ok
PRAGMA git4data_create_snapshot('plain_snap')

statement ok
PRAGMA git4data_create_snapshot('line_snap', 'plain_branch')

statement ok
PRAGMA git4data_create_branch('delta_branch', '')

statement ok
CREATE TABLE d_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE d_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('t', 'delta_branch', 'd_add', 'd_del')

# a branch with a copy says so, and names the table it reads and the (empty) delta names
query III
SELECT has_storage, storage_table, delta_added || '|' || delta_removed FROM git4data_branches()
WHERE branch_name = 'plain_branch'
----
true	b_copy	|

# a branch that differs by a delta says that instead, and names both tables
query III
SELECT has_delta, delta_added, delta_removed FROM git4data_branches()
WHERE branch_name = 'delta_branch'
----
true	d_add	d_del

# nothing is missing while the tables are there
query II
SELECT storage_missing, delta_missing FROM git4data_branches()
WHERE branch_name IN ('plain_branch', 'delta_branch')
----
false	false
false	false

# a snapshot that captured a branch's own line names it; one that captured the table as a commit saw it has
# no line rather than an empty string
query II
SELECT snapshot_name, line IS NULL FROM git4data_snapshots() ORDER BY snapshot_name
----
line_snap	false
plain_snap	true

query I
SELECT line FROM git4data_snapshots() WHERE snapshot_name = 'line_snap'
----
plain_branch

# A mapping whose table is dropped leaves the branch reading its pinned image, and the listing says so rather
# than reporting a table that cannot be read. Measured when this column was added: a materialized branch whose
# copy was dropped still carried has_storage true.
statement ok
DROP TABLE d_add

query II
SELECT has_delta, delta_missing FROM git4data_branches()
WHERE branch_name = 'delta_branch'
----
true	true

# the pragmas return the same rows, and the listing is a query like any other: it joins and aggregates
query III
SELECT (SELECT count(*) FROM git4data_branches()),
       (SELECT count(*) FROM git4data_snapshots()),
       (SELECT count(*) FROM (SELECT * FROM git4data_branches()) AS pragma_rows)
----
2	2	2

query I
SELECT count(*) FROM git4data_branches() WHERE has_storage
----
1

# A listing is a read like any other, so a rollback that took a reference takes it out of the listing: the
# in-memory registries are reconciled before the rows are built, exactly as a read at a reference reconciles
# them. Without that the row would be gone from the table and still reported here.
statement ok
BEGIN

statement ok
PRAGMA git4data_create_snapshot('rolled_back')

query I
SELECT count(*) FROM git4data_snapshots()
----
3

statement ok
ROLLBACK

query I
SELECT count(*) FROM git4data_snapshots()
----
2

query I
SELECT count(*) FROM git4data_snapshots() WHERE snapshot_name = 'rolled_back'
----
0

# The registry is a hash map, so the listing orders its rows itself - by the commit and then the name - which
# is what makes them a surface something can be asserted against. Measured: without the sort the parity check's
# two listing-order checks failed, because the order the map hands out is not the order anything was created in.
query T
SELECT snapshot_name FROM git4data_snapshots()
----
plain_snap
line_snap

# A branch reads the line its parent holds plus its own mapping, and the read falls back to the pinned image
# when one of those tables cannot be resolved. Both of the branch's own columns stay intact when the table that
# is gone belongs to the *parent*, so the listing said nothing: measured before `inherited_missing` was added,
# after `DROP TABLE di_add` the branch below read six rows without the inherited added one while
# `delta_missing` said true for `di` and false for `dic`, and nothing in either row said the child's read had
# changed.
statement ok
CREATE TABLE di (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO di SELECT range, range FROM range(6)

statement ok
PRAGMA git4data_create_branch('di', '')

statement ok
CREATE TABLE di_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE di_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('di', 'di', 'di_add', 'di_del')

statement ok
INSERT INTO di_add VALUES (100, 100)

statement ok
INSERT INTO di_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('dic', 'di')

statement ok
CREATE TABLE dic_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE dic_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('di', 'dic', 'dic_add', 'dic_del')

statement ok
INSERT INTO dic_add VALUES (300, 300)

# both overlays are read, and nothing of either line is missing
query IIII
SELECT (SELECT count(*) FROM di AT (BRANCH => 'dic')),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 100),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 2),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 300)
----
7	1	0	1

query III
SELECT delta_missing, inherited_missing, identified FROM git4data_branches() WHERE branch_name = 'dic'
----
false	false	true

statement ok
DROP TABLE di_add

# The child reads the base's six rows, plus its own one: the inherited overlay is gone from the read whole -
# a delta needs both of its tables, so the key the parent had removed (2) is back as well as the row it had
# added (100) being gone - and the child's own row is what says so. The child's own columns do not move.
query IIII
SELECT (SELECT count(*) FROM di AT (BRANCH => 'dic')),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 100),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 2),
       (SELECT count(*) FROM di AT (BRANCH => 'dic') WHERE k = 300)
----
7	0	1	1

query III
SELECT delta_missing, inherited_missing, identified FROM git4data_branches() WHERE branch_name = 'dic'
----
false	true	true

# the parent says it itself, in its own column
query II
SELECT delta_missing, inherited_missing FROM git4data_branches() WHERE branch_name = 'di'
----
true	false

# A capture that named a branch's line reads that line, so a table of it being dropped changes what the
# capture reads - and the row here named the line and nothing else. Measured before `line_missing` was added:
# `dl_cap` read five rows with the branch's added key, and after `DROP TABLE dlp_add` it read four without it,
# while `git4data_snapshots()` said only `line = dlp`.
statement ok
CREATE TABLE dl (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO dl SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('dlp', '')

statement ok
CREATE TABLE dlp_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE dlp_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('dl', 'dlp', 'dlp_add', 'dlp_del')

statement ok
INSERT INTO dlp_add VALUES (100, 100)

statement ok
INSERT INTO dlp_del VALUES (2)

statement ok
PRAGMA git4data_create_snapshot('dl_cap', 'dlp')

query III
SELECT (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap')),
       (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap') WHERE k = 100),
       (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap') WHERE k = 2)
----
5	1	0

query II
SELECT line, line_missing FROM git4data_snapshots() WHERE snapshot_name = 'dl_cap'
----
dlp	false

# a capture of the table itself has no line, and nothing whose tables could be gone: both columns are NULL
# rather than an empty string and a false
query II
SELECT line IS NULL, line_missing IS NULL FROM git4data_snapshots() WHERE snapshot_name = 'plain_snap'
----
true	true

statement ok
DROP TABLE dlp_add

query III
SELECT (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap')),
       (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap') WHERE k = 100),
       (SELECT count(*) FROM dl AT (SNAPSHOT => 'dl_cap') WHERE k = 2)
----
5	0	1

query II
SELECT line, line_missing FROM git4data_snapshots() WHERE snapshot_name = 'dl_cap'
----
dlp	true

# the branch that owns the table says it in its own column, which is what a reader of the two listings joins
query II
SELECT delta_missing, inherited_missing FROM git4data_branches() WHERE branch_name = 'dlp'
----
true	false

# A branch is a line for *every* source it is given, so the tables it holds are comma-joined lists - and the
# source each pair belongs to was named nowhere in the listing. Measured before `storage_source`/`delta_source`:
# a branch holding a copy for one table and a delta for another reported `delta_added = "ms2_add"` with the one
# it applies to absent, and on a branch over two deltas only the position of the names in `delta_added` and
# `delta_removed` linked the two halves - nothing at all said the mapping was for that table.
statement ok
CREATE TABLE ms1 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ms1 SELECT range, range FROM range(4)

statement ok
CREATE TABLE ms2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ms2 SELECT range * 10, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('msb', '')

statement ok
PRAGMA git4data_materialize('ms1', 'msb', 'ms1_copy')

statement ok
CREATE TABLE ms2_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ms2_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ms2', 'msb', 'ms2_add', 'ms2_del')

query IIIII
SELECT storage_source, storage_table, delta_source, delta_added, delta_removed FROM git4data_branches()
WHERE branch_name = 'msb'
----
ms1	ms1_copy	ms2	ms2_add	ms2_del

# two sources, so the four names come in the order of the mappings they belong to: the source list and the table
# list line up position by position
statement ok
CREATE TABLE ms3 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ms3 SELECT range * 100, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('msc', '')

statement ok
CREATE TABLE ms3_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ms3_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ms2', 'msc', 'ms2_add', 'ms2_del')

statement ok
PRAGMA git4data_bind_branch_delta('ms3', 'msc', 'ms3_add', 'ms3_del')

query III
SELECT delta_source, delta_added, delta_removed FROM git4data_branches() WHERE branch_name = 'msc'
----
ms2, ms3	ms2_add, ms3_add	ms2_del, ms3_del

# a source that has been renamed is reported as the table it is now, which is the rule the tables follow too
statement ok
ALTER TABLE ms2 RENAME TO ms2_renamed

query II
SELECT storage_source, delta_source FROM git4data_branches() WHERE branch_name = 'msb'
----
ms1	ms2_renamed

# The line a branch reads is not the reference it was created from: a fork from a *snapshot* of a branch carries
# the snapshot as `parent` and that branch as its line. Measured before `line` was added: `ln_child` reported
# `parent = ln_cap`, `has_delta = false` and no delta tables, while it read five rows through `ln_b`'s delta -
# so the row named neither the line nor the tables, and `inherited_missing` beside it referred to a line the row
# did not mention.
statement ok
CREATE TABLE ln_t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ln_t SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('ln_b', '')

statement ok
CREATE TABLE ln_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE ln_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ln_t', 'ln_b', 'ln_add', 'ln_del')

statement ok
INSERT INTO ln_add VALUES (100, 100)

statement ok
PRAGMA git4data_create_snapshot('ln_cap', 'ln_b')

statement ok
PRAGMA git4data_create_branch('ln_child', 'ln_cap')

query IIII
SELECT parent, line, has_delta, inherited_missing FROM git4data_branches() WHERE branch_name = 'ln_child'
----
ln_cap	ln_b	false	false

query II
SELECT (SELECT count(*) FROM ln_t AT (BRANCH => 'ln_child')),
       (SELECT count(*) FROM ln_t AT (BRANCH => 'ln_child') WHERE k = 100)
----
5	1

# a branch that reads the source table itself has no line, and a branch made with no parent has no parent: both
# are NULL rather than an empty string, so a caller asks "nothing here" the same way in either column
query III
SELECT parent IS NULL, line IS NULL, delta_added FROM git4data_branches() WHERE branch_name = 'ln_b'
----
true	true	ln_add

# and the capture of a line says whether the tables it reads were identified in this session, which is the
# column the branches listing already carried: here they were, and a capture of the table itself has no line and
# therefore nothing to identify
query III
SELECT line, line_missing, identified FROM git4data_snapshots() WHERE snapshot_name = 'ln_cap'
----
ln_b	false	true

query II
SELECT line IS NULL, identified IS NULL FROM git4data_snapshots() WHERE snapshot_name = 'plain_snap'
----
true	true

# `line` says which line a branch inherited, not that every read of it comes from that line: a mapping of its
# own is read *instead of* the line for the source it covers, and which sources a branch is read through is the
# caller's argument at read time - so the columns beside `line` (storage_source, storage_table, delta_source,
# delta_added, delta_removed) are what say where the rest comes from. Measured: `ownline`, forked from a delta
# branch, read five rows through the line; after binding a table of its own it read **two rows - only that
# table** - while `line` still named the branch it inherited from.
statement ok
CREATE TABLE ol (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ol SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('olb', '')

statement ok
CREATE TABLE olb_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE olb_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ol', 'olb', 'olb_add', 'olb_del')

statement ok
INSERT INTO olb_add VALUES (100, 100)

statement ok
INSERT INTO olb_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('ownline', 'olb')

query IIII
SELECT line, has_storage, storage_table,
       (SELECT count(*) FROM ol AT (BRANCH => 'ownline'))
FROM git4data_branches() WHERE branch_name = 'ownline'
----
olb	false	(empty)	5

statement ok
CREATE TABLE ownline_copy (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ownline_copy VALUES (7, 700), (8, 800)

statement ok
PRAGMA git4data_bind_branch_table('ol', 'ownline', 'ownline_copy')

# the line is still what it inherited, and the read is its own table - both facts are in the row
query IIII
SELECT line, storage_source, storage_table,
       (SELECT count(*) FROM ol AT (BRANCH => 'ownline'))
FROM git4data_branches() WHERE branch_name = 'ownline'
----
olb	ol	ownline_copy	2

query IIII
SELECT (SELECT count(*) FROM ol AT (BRANCH => 'ownline') WHERE k = 100),
       (SELECT count(*) FROM ol AT (BRANCH => 'ownline') WHERE k = 2),
       (SELECT count(*) FROM ol AT (BRANCH => 'ownline') WHERE k = 7),
       (SELECT count(*) FROM ol AT (BRANCH => 'olb'))
----
0	0	1	5
