# name: test/sql/git4data/snapshot_read.test
# description: Read a table as of a pinned snapshot, matching MatrixOne's snapshot_read cases
# group: [git4data]

statement ok
CREATE TABLE t AS SELECT range AS i FROM range(100);

query I
SELECT count(*) FROM t
----
100

statement ok
PRAGMA git4data_create_snapshot('snap_01')

statement ok
DELETE FROM t WHERE i <= 50

query I
SELECT count(*) FROM t
----
49

# the snapshot still sees everything the delete removed
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'snap_01')
----
100

statement ok
PRAGMA git4data_create_snapshot('snap_02')

statement ok
INSERT INTO t SELECT range FROM range(40)

query I
SELECT count(*) FROM t
----
89

# snap_01 predates the delete, so the insert is invisible to it too
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'snap_01')
----
100

# snap_02 postdates the delete but predates the insert
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'snap_02')
----
49

# a snapshot read composes with filters, and with CTAS
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'snap_01') WHERE i <= 30
----
31

statement ok
CREATE TABLE copy AS SELECT * FROM t AT (SNAPSHOT => 'snap_01') WHERE i <= 30

query I
SELECT count(*) FROM copy
----
31

statement ok
CREATE TABLE copy2(b INT)

statement ok
INSERT INTO copy2 SELECT i FROM t AT (SNAPSHOT => 'snap_01') WHERE i >= 97

query I
SELECT count(*) FROM copy2
----
3

# the same state is reachable through the function form
query I
SELECT count(*) FROM git4data_snapshot_scan('t', 'snap_01')
----
100

statement ok
DROP TABLE copy

statement ok
DROP TABLE copy2

# dropping a snapshot releases it; the read is then refused by name
statement ok
PRAGMA git4data_drop_snapshot('snap_01')

statement error
SELECT count(*) FROM t AT (SNAPSHOT => 'snap_01')
----
<REGEX>:.*does not exist.*

statement ok
PRAGMA git4data_drop_snapshot('snap_02')
