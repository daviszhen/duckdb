# name: test/sql/git4data/materialize_replace.test
# description: A second materialize replaces the branch's line without leaving the first copy behind
# group: [git4data]

load {TEST_DIR}/materialize_replace.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b1')

# the branch has a line of its own now, and writing to it is what the copy bought
statement ok
UPDATE t_b1 SET v = 111 WHERE k = 1

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1
----
111

# Materializing the same source into a second table replaces the mapping, because a branch reads one
# table of its own per source. Measured before the fix: the branch read the new table while the first
# copy was still there, holding the identical line, with nothing pointing at it - and dropping the
# branch took only the second, so the first survived that too.
statement ok
PRAGMA git4data_materialize('t', 'b', 't_b2')

# the second copy carries what the branch holds, not the pinned image: the copy is made while the
# branch still reads the first table, and the first is dropped only after
query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1)
----
10	111

query II
SELECT (SELECT count(*) FROM t_b2), (SELECT v FROM t_b2 WHERE k = 1)
----
10	111

# and the copy the feature made the first time is gone, because a materialize costs a table and
# nothing pointed at this one any more
statement error
SELECT count(*) FROM t_b1
----
<REGEX>:.*Table with name t_b1 does not exist.*

# the branch reads the second copy, so it is the one that carries the line from here on
statement ok
UPDATE t_b2 SET v = 222 WHERE k = 1

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1
----
222

# A table the caller bound by hand is not the feature's to drop, so a later materialize leaves it
# alone - it was never created for the branch, and the caller may still be reading it.
statement ok
CREATE TABLE t_mine (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_mine VALUES (7, 7)

statement ok
PRAGMA git4data_bind_branch_table('t', 'b', 't_mine')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 7
----
7

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b3')

query I
SELECT count(*) FROM t_mine
----
1

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 7
----
7

# who created a mapping's table survives a reopen, so the replacement still drops its own copy after
# a restart rather than leaving it behind for the rest of the database's life
statement ok
CHECKPOINT

restart

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b4')

query I
SELECT v FROM t AT (BRANCH => 'b') WHERE k = 7
----
7

statement error
SELECT count(*) FROM t_b3
----
<REGEX>:.*Table with name t_b3 does not exist.*

# the table the caller bound is still there after all of that
query I
SELECT count(*) FROM t_mine
----
1

# dropping the branch takes the table it reads, and the copy the first materialize made was already
# gone rather than outliving the branch it was made for - which is what the whole fix is for
statement ok
PRAGMA git4data_drop_branch('b')

statement error
SELECT count(*) FROM t_b4
----
<REGEX>:.*Table with name t_b4 does not exist.*

query I
SELECT count(*) FROM t_mine
----
1

# a flag that is neither true nor false is refused rather than taken for one of them
statement error
PRAGMA git4data_bind_branch_table('t', 'b', 't_mine', 'maybe')
----
<REGEX>:.*it is true or false, not "maybe".*

# The copy a second materialize replaces is dropped because it is a table of the identical line with nothing
# pointing at it - unless something does point at it. Another branch can be materialized *from* that copy, so
# it is the table that branch is about, and taking it leaves that branch with nothing to read at all.
# Measured: after the second materialize here, "t_b1" was gone and the branch about it could not be read.
statement ok
CREATE TABLE m_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO m_src SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('m1', '')

statement ok
PRAGMA git4data_materialize('m_src', 'm1', 'm_copy1')

statement ok
UPDATE m_copy1 SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('m2', '')

statement ok
PRAGMA git4data_materialize('m_copy1', 'm2', 'm_copy1_copy')

statement ok
PRAGMA git4data_materialize('m_src', 'm1', 'm_copy2')

# the replaced copy stayed, and the branch about it still reads its line
query II
SELECT (SELECT v FROM m_copy1 AT (BRANCH => 'm2') WHERE k = 1), (SELECT count(*) FROM m_copy1)
----
111	4

# and the branch that materialized again reads the new copy, not the old one
query I
SELECT v FROM m_src AT (BRANCH => 'm1') WHERE k = 1
----
111

# **A caller's own binding replaces the mapping the same way, so it leaves the same orphan (3dq).** A copy
# materialize made is a table of the identical line once nothing points at it, and binding a table of the
# caller's over it did not take that copy with it - measured, `t_b5` stayed behind with no row naming it and no
# listing showing it, so the caller would have to remember the name to clean it up. The rule is the same one
# the replacement above follows, with the same conditions: the table has to be the feature's, it must not be the
# table being bound now, and no other branch may name it.
statement ok
PRAGMA git4data_create_branch('rb', '')

statement ok
PRAGMA git4data_materialize('t', 'rb', 't_b5')

statement ok
CREATE TABLE t_hand (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_hand VALUES (1, 4242)

statement ok
PRAGMA git4data_bind_branch_table('t', 'rb', 't_hand')

query I
SELECT v FROM t AT (BRANCH => 'rb') WHERE k = 1
----
4242

statement error
SELECT count(*) FROM t_b5
----
<REGEX>:.*Table with name t_b5 does not exist.*

# the table the caller bound is left where it is, which is the rule 3dp settled for the drop: only what the
# feature created is the feature's to take
query I
SELECT count(*) FROM t_hand
----
1

# re-binding the *same* table is not a replacement, and must not drop it - this surface is case-insensitive
# everywhere else, and the spelling here differs only in case
statement ok
PRAGMA git4data_bind_branch_table('t', 'rb', 'T_HAND')

query I
SELECT v FROM t AT (BRANCH => 'rb') WHERE k = 1
----
4242

# and a copy another branch names is not this branch's alone to take, the same clause materialize's own
# replacement carries: `t_shared` is read by `rc` as well
statement ok
PRAGMA git4data_create_branch('rc', '')

statement ok
PRAGMA git4data_materialize('t', 'rb', 't_shared')

statement ok
PRAGMA git4data_bind_branch_table('t', 'rc', 't_shared')

statement ok
PRAGMA git4data_bind_branch_table('t', 'rb', 't_hand')

query I
SELECT count(*) FROM t_shared
----
1
