# name: test/sql/git4data/reserved_names.test
# description: The names the feature keeps for its own internal references are refused to users
# group: [git4data]

load {TEST_DIR}/reserved_names.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

# A reference the feature manages itself is looked up by exact name, so one a user happened to take
# would be dropped by the machinery that manages it - silent data loss rather than a conflict. Measured
# before this guard: a snapshot called __merge_base__ was gone after one merge, and the point-in-time
# recovery window manages __pitr__ the same way.
statement error
PRAGMA git4data_create_snapshot('__merge_base__')
----
<REGEX>:.*reserves for references it manages itself.*

statement error
PRAGMA git4data_create_snapshot('__pitr__')
----
<REGEX>:.*reserves for references it manages itself.*

statement error
PRAGMA git4data_create_branch('__pitr__', '')
----
<REGEX>:.*reserves for references it manages itself.*

# one underscore is not the feature's, and neither is a doubled one inside a name
statement ok
PRAGMA git4data_create_snapshot('_one')

statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('a__b', 'root')

statement ok
PRAGMA git4data_create_branch('c', 'root')

# the refusals left nothing behind: one snapshot of the user's and three branches
query IIII
PRAGMA git4data_limits
----
-1	1	-1	3

# the same change on both sides, so the merge has nothing to resolve
statement ok
PRAGMA git4data_materialize('t', 'a__b', 't_ab')

statement ok
PRAGMA git4data_materialize('t', 'c', 't_c')

statement ok
UPDATE t_ab SET v = 7 WHERE k = 1

statement ok
UPDATE t_c SET v = 7 WHERE k = 1

# This merge needs an internal reference of its own, at the ancestor's pin. The user's snapshot is a
# different name, so it is not the one that gets dropped - which is what the counts and the read below
# are here to say, and what was wrong before the guard existed.
statement ok
PRAGMA git4data_merge('t', 'c', 'a__b', 'fail')

query IIII
PRAGMA git4data_limits
----
-1	1	-1	3

query II
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => '_one')), (SELECT count(*) FROM t)
----
10	10

query II
SELECT (SELECT v FROM t_c WHERE k = 1), (SELECT count(*) FROM t_c)
----
7	10


# Reference names that are awkward survive creation, the listing and a read: a quote, another script, and spaces around the name, which are trimmed before the uniqueness check - so ' b ' and b are one
# branch rather than a duplicate. The empty name is allowed too: it lists as a row with an empty name and
# reads, which is odd but usable rather than a hole. Only the reserved __ prefix is refused.
statement ok
CREATE TABLE nf (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO nf SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('a''b', '')

statement ok
PRAGMA git4data_create_branch('分支-1', '')

# a padded name is a name of its own: it is not trimmed, so ' b ' and b are two branches, and both read
statement ok
PRAGMA git4data_create_branch(' b ', '')

statement ok
PRAGMA git4data_create_branch('b', '')

query I
SELECT count(*) FROM nf AT (BRANCH => ' b ')
----
10

statement ok
PRAGMA git4data_create_branch('', '')

query II
SELECT (SELECT count(*) FROM nf AT (BRANCH => 'a''b')), (SELECT count(*) FROM nf AT (BRANCH => '分支-1'))
----
10	10

query I
SELECT count(*) FROM nf AT (BRANCH => '')
----
10

# The *schema* the registry is kept in has a reserved name too, and it is not enough to guard the tables inside
# it: a caller can create the schema before the feature ever has. Measured before this guard, on a fresh
# database: `CREATE SCHEMA git4data` succeeded, and the schema was then hidden from every listing while every
# statement inside it was refused as the registry's - a schema the caller made and can neither see nor use. On a
# database that already has a reference the same statement met the catalog's own error instead, "Schema with name
# "git4data" already exists!", which names a schema that no listing shows. Both are refused the same way now.
statement error
CREATE SCHEMA git4data
----
<REGEX>:.*the name of the schema the reference registry is kept in.*

# the spelling is the name, so it is refused in any case
statement error
CREATE SCHEMA GIT4DATA
----
<REGEX>:.*the name of the schema the reference registry is kept in.*

# and `IF NOT EXISTS` is not a way around it either
statement error
CREATE SCHEMA IF NOT EXISTS git4data
----
<REGEX>:.*the name of the schema the reference registry is kept in.*

# another name is nobody's business but the caller's
statement ok
CREATE SCHEMA mine

# the refusals left the feature working: a reference can still be created, and the schema the feature owns is
# still readable through the listings
statement ok
PRAGMA git4data_create_snapshot('after_schema_guard')

query I
SELECT count(*) FROM (SELECT snapshot_name FROM git4data_snapshots() WHERE snapshot_name = 'after_schema_guard')
----
1

# The same statement on a database with no references yet - which is where the feature has *not* created the
# schema, so this is the half that a check on an existing schema could not have covered. It is also the half
# that says the feature's own `CREATE SCHEMA IF NOT EXISTS git4data` still goes through: the snapshot below is
# what creates that schema, and it succeeds.
statement ok
ATTACH '{TEST_DIR}/reserved_names_fresh.db' AS fresh

statement ok
USE fresh

statement ok
CREATE TABLE t (k INTEGER, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement error
CREATE SCHEMA git4data
----
<REGEX>:.*the name of the schema the reference registry is kept in.*

statement ok
PRAGMA git4data_create_snapshot('fresh1')

query II
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => 'fresh1')), (SELECT count(*) FROM t)
----
10	10

# The reserved prefix is refused where a reference is *created*, and the drop face was the way round it.
# Measured before this guard, on the open window: `git4data_drop_snapshot('__pitr__')` dropped the reference
# the window holds its history with while the window itself stayed on - the session read
# `true, 100, false`, and the same database after a restart read `false, 0, false`, because the row is what a
# reload decides the window by. The history the window promised was then held by nothing, and the way out
# that would have ended it on both sides is `git4data_pitr_off`.
statement ok
PRAGMA git4data_pitr(100)

query III
PRAGMA git4data_pitr_state
----
true	100	true

statement error
PRAGMA git4data_drop_snapshot('__pitr__')
----
<REGEX>:.*reserves for a reference it manages itself.*

statement error
PRAGMA git4data_drop_snapshot('__merge_base__')
----
<REGEX>:.*reserves for a reference it manages itself.*

# forgetting a reference is the other face that reaches these names, and it reaches only the one the merge's
# own generated SQL forgets. Measured before this guard: the window stayed enabled, the registry held nothing
# for it while its row stayed in the table, and the next checkpoint put the reference back at the *current*
# commit - moving the pin from 7 to 25 and shrinking the reach the window promised, with nothing said.
statement error
PRAGMA git4data_forget_internal('__pitr__')
----
<REGEX>:.*is not the reference this forgets.*

# the refusals took nothing with them: the window is still on and still holds what it promises
query III
PRAGMA git4data_pitr_state
----
true	100	true

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
10

# and the way out the refusal names ends it on both sides
statement ok
PRAGMA git4data_pitr_off

query III
PRAGMA git4data_pitr_state
----
false	0	false

# the rule is the reserved prefix alone, so an ordinary name is still dropped by this face
statement ok
PRAGMA git4data_create_snapshot('droppable')

statement ok
PRAGMA git4data_drop_snapshot('droppable')

query I
SELECT count(*) FROM (SELECT snapshot_name FROM git4data_snapshots() WHERE snapshot_name = 'droppable')
----
0

