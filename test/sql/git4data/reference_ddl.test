# name: test/sql/git4data/reference_ddl.test
# description: What a reference means when the table under it is altered or dropped
# group: [git4data]

load {TEST_DIR}/reference_ddl.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('pin')

# A reference pins the rows, not the schema: a column added afterwards reads as its default at the
# reference too, exactly as it does in the current view.
statement ok
ALTER TABLE t ADD COLUMN c INTEGER DEFAULT 7

query II
SELECT v, c FROM t AT (SNAPSHOT => 'pin') WHERE k = 1
----
1	7

query II
SELECT v, c FROM t WHERE k = 1
----
1	7

statement ok
ALTER TABLE t DROP COLUMN c

# the column is gone for every reader, the reference included: the pinned rows are still there and
# still read, and asking for the dropped column is an ordinary binder error
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'pin')
----
100

statement error
SELECT c FROM t AT (SNAPSHOT => 'pin')
----
<REGEX>:.*Binder Error.*

# A column added *again* under the name of the dropped one is a new column, and the reference reads it as
# its own default - the same rule as the column added above, which is what the name makes easy to forget:
# the values the pinned rows had under that name are gone with the column they were in.
statement ok
ALTER TABLE t ADD COLUMN c INTEGER DEFAULT 0

query II
SELECT v, c FROM t AT (SNAPSHOT => 'pin') WHERE k = 1
----
1	0

# A column *type* change is the in-place path that rewrites a column's data, and the pre-images survive it:
# the reference still reads the row it pinned, while the table reads the update that came after it. Measured,
# because the note recorded a worry that a path which dirtied a segment would lose the pre-image; this is
# that path, and it does not.
statement ok
UPDATE t SET v = 1000 WHERE k = 1

statement ok
ALTER TABLE t ALTER COLUMN v TYPE BIGINT

query II
SELECT v, c FROM t AT (SNAPSHOT => 'pin') WHERE k = 1
----
1	0

query I
SELECT v FROM t WHERE k = 1
----
1000

# Dropping the table takes the rows with it. The reference stays - it is a commit, not a claim on a
# table - and reading it says the table is not there rather than crashing.
statement ok
DROP TABLE t

query IIII
PRAGMA git4data_limits
----
-1	1	-1	0

statement error
SELECT count(*) FROM t AT (SNAPSHOT => 'pin')
----
<REGEX>:.*Table with name t does not exist.*

# Recreating the name does not resurrect the old rows: at that commit the new table had none, and rows
# inserted into it afterwards came later than the commit the reference holds.
statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

query I
SELECT count(*) FROM t AT (SNAPSHOT => 'pin')
----
0

statement ok
INSERT INTO t SELECT range, range FROM range(5)

query I
SELECT count(*) FROM t AT (SNAPSHOT => 'pin')
----
0

# the dead reference survives a checkpoint and a reopen, and can still be dropped there
statement ok
CHECKPOINT

restart

query IIII
PRAGMA git4data_limits
----
-1	1	-1	0

query I
SELECT count(*) FROM t
----
5

# A reference held across a drop and a recreate does not produce a difference against anything: at the
# commit it pins, the table that is there now had no rows, so a self-diff is empty and a pick across it
# applies nothing rather than inventing changes.
query I
SELECT count(*) FROM git4data_diff('t', 'pin', 'pin')
----
0

query I
SELECT count(*) FROM git4data_diff('t', 'pin', 'pin')
----
0

statement ok
PRAGMA git4data_pick('t', 'pin', 'pin', 'fail')

query I
SELECT count(*) FROM t
----
5

statement ok
PRAGMA git4data_drop_snapshot('pin')

query IIII
PRAGMA git4data_limits
----
-1	0	-1	0

# A mapping is found by the key a read names and by the oid of the table it was made against - and the oid also
# says when a name now reaches a **different** table. That was silent: measured before this, after
# `DROP TABLE sw; CREATE TABLE sw (...)` a branch bound to `sw` read the new table as if it were the one it was
# given, and a write through `git4data_apply` landed in the mapping's own tables as that table's line, while the
# listing said `delta_source = sw` and `delta_missing = false`. The mapping's own tables have refused this since
# they were built ("the tables carrying those names now are not them"); the source half was missing.
statement ok
CREATE TABLE sw (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO sw SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_snapshot('base_snap')

statement ok
PRAGMA git4data_create_branch('swb', '')

statement ok
CREATE TABLE swb_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE swb_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('sw', 'swb', 'swb_add', 'swb_del')

statement ok
INSERT INTO swb_add VALUES (100, 100)

statement ok
PRAGMA git4data_create_branch('sws', '')

statement ok
PRAGMA git4data_materialize('sw', 'sws', 'sws_copy')

query III
SELECT (SELECT count(*) FROM sw AT (BRANCH => 'swb')),
       (SELECT count(*) FROM sw AT (BRANCH => 'swb') WHERE k = 100),
       (SELECT count(*) FROM sw AT (BRANCH => 'sws'))
----
5	1	4

# the source table is dropped and another takes its name
statement ok
DROP TABLE sw

statement ok
CREATE TABLE sw (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO sw SELECT range * 10, range FROM range(3)

# a read through the mapping is refused rather than answered from the new table
statement error
SELECT count(*) FROM sw AT (BRANCH => 'swb')
----
<REGEX>:.*has a mapping for "sw", and the table carrying that name now is not the one the mapping was made against.*

# and so is a write through it, which used to land in the mapping's tables as the new table's line
statement error
PRAGMA git4data_apply('sw', 'swb', 'INSERT INTO sw VALUES (400, 400)')
----
<REGEX>:.*the table it was made against is no longer reachable under that name\..*

# the same for a table of its own
statement error
SELECT count(*) FROM sw AT (BRANCH => 'sws')
----
<REGEX>:.*has a mapping for "sw", and the table carrying that name now is not the one the mapping was made against.*

# The message names the ways out that work. `git4data_materialize` was in that list and cannot work here - it
# copies what the branch *reads*, which is the mapping this refusal is about, so it answered with this same
# sentence (measured): a message naming a way out that refuses with the message is a loop. The two it names do
# work: a rebind, and taking the mapping back (asserted below).
statement error
PRAGMA git4data_materialize('sw', 'swb', 'swb_copy')
----
<REGEX>:.*Bind the mapping again \(git4data_bind_branch_delta, git4data_bind_branch_table\) or take it back with git4data_unbind\..*

# and a pick, which reads the branch's image, refuses the same way rather than comparing against the new table
statement error
PRAGMA git4data_pick('sw', 'swb', 'base_snap', 'fail')
----
<REGEX>:.*has a mapping for "sw", and the table carrying that name now is not the one the mapping was made against.*

# a merge is covered by the same refusal without a check of its own: it reads both sides through the read path
# before it lands anything - measured, removing the check from the merge's own lookup changes nothing, because
# the diff's read of the target refuses first
statement error
PRAGMA git4data_merge('sw', 'swb', 'sws', 'fail')
----
<REGEX>:.*has a mapping for "sw", and the table carrying that name now is not the one the mapping was made against.*

# the caller's way through is to take the mapping back - which is why the refusal above must not fire for
# `git4data_unbind` itself, and it did until this was measured: the message named a way out that the check was
# blocking. Without the mapping the branch reads the *name* again, which is the table that has it now, at the
# branch's pin: the new table did not exist then, so there are no rows at all
statement ok
PRAGMA git4data_unbind('sw', 'swb')

query I
SELECT count(*) FROM sw AT (BRANCH => 'swb')
----
0

# and the mapping can be made again against the table that has the name now
statement ok
PRAGMA git4data_bind_branch_delta('sw', 'swb', 'swb_add', 'swb_del')

# and the mapping made again is read as of now while the base is read at the pin, so its own added row is there
# and nothing of the new table's rows is
query II
SELECT (SELECT count(*) FROM sw AT (BRANCH => 'swb') WHERE k = 100),
       (SELECT count(*) FROM sw AT (BRANCH => 'swb') WHERE k = 0)
----
1	0

# The three refusals about a mapping whose tables are not the ones it was given all said "one was dropped and
# another was created with the same name", and a **rename** reaches them without any drop: measured below, the
# source renamed and a new table taking its old name leaves the mapping following the renamed table by oid (it
# reads five rows through `ren_s2`), while a read through the old name is refused - correctly, because that name
# now reaches a different table, but for a reason the sentence got wrong. The claim is what changed here: what is
# true in both shapes is that the table is no longer reachable under that name.
statement ok
CREATE TABLE ren_s (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ren_s SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('renb', '')

statement ok
CREATE TABLE renb_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE renb_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ren_s', 'renb', 'renb_add', 'renb_del')

statement ok
INSERT INTO renb_add VALUES (100, 100)

statement ok
ALTER TABLE ren_s RENAME TO ren_s2

statement ok
CREATE TABLE ren_s (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ren_s VALUES (7, 7)

# nothing was dropped, and the mapping followed the table it was made against
query I
SELECT count(*) FROM ren_s2 AT (BRANCH => 'renb')
----
5

query II
SELECT (SELECT count(*) FROM ren_s2 AT (BRANCH => 'renb') WHERE k = 100), (SELECT count(*) FROM ren_s)
----
1	1

# the old name now reaches another table, so a read through it is refused - with a reason that holds
statement error
SELECT count(*) FROM ren_s AT (BRANCH => 'renb')
----
<REGEX>:.*is not the one the mapping was made against - the table it was made against is no longer reachable under that name\..*

# and the same shape for the mapping's *own* tables: rename the added table and take its name
statement ok
CREATE TABLE ren_t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO ren_t SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('rent', '')

statement ok
CREATE TABLE rent_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE rent_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('ren_t', 'rent', 'rent_add', 'rent_del')

statement ok
INSERT INTO rent_add VALUES (200, 200)

statement ok
ALTER TABLE rent_add RENAME TO rent_add_moved

statement ok
CREATE TABLE rent_add (k INTEGER PRIMARY KEY, v INTEGER)

statement error
SELECT count(*) FROM ren_t AT (BRANCH => 'rent')
----
<REGEX>:.*the tables carrying those names now are not them - the tables it was given are no longer reachable under those names\..*

# The third of the three sentences - a branch's copy whose name was taken - is measured here rather than left
# implied. The copy is renamed (so the mapping could still find it by oid) and a new table takes its old name, and
# the read is refused: the name resolves to a table the branch was not given, which is the same rule the source and
# the delta pair follow, and the branch is not silently read through the renamed copy. The sentence is the one
# 3cf put in its place, and the row's `storage_missing` stays false - which is what that column means: it reports a
# table that cannot be *resolved*, and this one resolves, to another table.
statement ok
CREATE TABLE cpy (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO cpy SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('cpyb', '')

statement ok
PRAGMA git4data_materialize('cpy', 'cpyb', 'cpyb_copy')

query I
SELECT count(*) FROM cpy AT (BRANCH => 'cpyb')
----
4

statement ok
ALTER TABLE cpyb_copy RENAME TO cpyb_copy_moved

statement ok
CREATE TABLE cpyb_copy (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO cpyb_copy VALUES (9, 9)

# the copy itself kept its rows, and it is the name that now means something else
query II
SELECT (SELECT count(*) FROM cpyb_copy_moved), (SELECT count(*) FROM cpyb_copy)
----
4	1

statement error
SELECT count(*) FROM cpy AT (BRANCH => 'cpyb')
----
<REGEX>:.*the table it was given is no longer reachable under that name\. Point the branch at a table of its own again with git4data_bind_branch_table\..*

# and the way out the sentence names works: pointing the branch at a table of its own again
statement ok
PRAGMA git4data_bind_branch_table('cpy', 'cpyb', 'cpyb_copy_moved')

query II
SELECT (SELECT count(*) FROM cpy AT (BRANCH => 'cpyb')), (SELECT count(*) FROM cpy AT (BRANCH => 'cpyb') WHERE k = 0)
----
4	1
