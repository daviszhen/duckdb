# name: test/sql/git4data/branch_delta.test
# description: A branch that differs from its base by a delta instead of holding a copy of it
# group: [git4data]

load {TEST_DIR}/branch_delta.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('base', 'root')

# the branch is given no copy. What it changes is said with two tables of its own: rows it has that
# its base does not, and keys it has removed from its base.
statement ok
CREATE TABLE t_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('t', 'base', 't_add', 't_del')

# nothing written yet, so the branch still reads exactly its base
query I
SELECT count(*) FROM t AT (BRANCH => 'base')
----
100

statement ok
INSERT INTO t_add VALUES (2000, 2000)

statement ok
INSERT INTO t_del VALUES (5)

# the branch is the base minus the removed keys plus the added rows, and the base itself is untouched
query IIII
SELECT (SELECT count(*) FROM t AT (BRANCH => 'base')),
       (SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 5),
       (SELECT v FROM t AT (BRANCH => 'base') WHERE k = 2000),
       (SELECT count(*) FROM t)
----
100	0	2000	100

query II
SELECT (SELECT count(*) FROM t WHERE k = 5), (SELECT count(*) FROM t WHERE k = 2000)
----
1	0

# a row the branch changed is an added row and a removed key, which is the same shape an update has
statement ok
INSERT INTO t_del VALUES (7)

statement ok
INSERT INTO t_add VALUES (7, 700)

query II
SELECT (SELECT v FROM t AT (BRANCH => 'base') WHERE k = 7), (SELECT v FROM t WHERE k = 7)
----
700	7

# the branch composes with a diff, which reads each side as the reference it names. Against a snapshot
# of the base the branch shows the row it added, the key it removed, and the key it replaced - the
# third because a row it added and a key it removed share a key, which is the shape of an update.
statement ok
PRAGMA git4data_create_snapshot('was')

query II
SELECT g4d_change, count(*) FROM git4data_diff('t', 'was', 'base') GROUP BY g4d_change ORDER BY g4d_change
----
added	1
changed	1
removed	1

# the listing says the branch carries a delta rather than a copy; the column's content is asserted by
# git4data-retention-check.sh, which can read the pragma's output
statement ok
PRAGMA git4data_branches;

# the delta's tables have to be able to stand in for the source's rows and keys
statement ok
CREATE TABLE wrong_columns (k INTEGER PRIMARY KEY, x INTEGER)

statement error
PRAGMA git4data_bind_branch_delta('t', 'base', 'wrong_columns', 't_del')
----
<REGEX>:.*so it needs that table's columns in that order.*

statement ok
CREATE TABLE wrong_keys (k INTEGER PRIMARY KEY, v INTEGER)

statement error
PRAGMA git4data_bind_branch_delta('t', 'base', 't_add', 'wrong_keys')
----
<REGEX>:.*so it needs exactly those 1 key column.*

statement ok
CREATE TABLE nokey (k INTEGER, v INTEGER)

statement ok
CREATE TABLE same_columns (k INTEGER, v INTEGER)

statement error
PRAGMA git4data_bind_branch_delta('nokey', 'base', 'same_columns', 'same_columns')
----
<REGEX>:.*has no primary key, so a delta cannot say which rows it removes.*

statement error
PRAGMA git4data_bind_branch_delta('t', 'missing', 't_add', 't_del')
----
<REGEX>:.*Branch "missing" does not exist.*

# Capturing the line does work, and it reads the delta at the commit it captured rather than at now:
# the base is fixed and the delta is not, which is why the two are read at different bounds.
statement ok
PRAGMA git4data_create_snapshot('cap', 'base')

statement ok
INSERT INTO t_del VALUES (9)

statement ok
INSERT INTO t_add VALUES (3000, 3000)

query IIIII
SELECT (SELECT count(*) FROM t AT (SNAPSHOT => 'cap')),
       (SELECT v FROM t AT (SNAPSHOT => 'cap') WHERE k = 2000),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'cap') WHERE k = 9),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'cap') WHERE k = 3000),
       (SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 3000)
----
100	2000	1	0	1

# and a fork from that capture takes the state it names, not what the branch holds now
statement ok
PRAGMA git4data_create_branch('child', 'cap')

query IIII
SELECT (SELECT count(*) FROM t AT (BRANCH => 'child')),
       (SELECT count(*) FROM t AT (BRANCH => 'child') WHERE k = 3000),
       (SELECT count(*) FROM t AT (BRANCH => 'child') WHERE k = 9),
       (SELECT v FROM t AT (BRANCH => 'child') WHERE k = 2000)
----
100	0	1	2000

# A delta branch is an ordinary reference to everything else, and worth measuring rather than assuming:
# a merge takes its changes into a branch that has a table of its own,
statement ok
PRAGMA git4data_create_branch('target', 'root')

statement ok
PRAGMA git4data_materialize('t', 'target', 't_target')

statement ok
INSERT INTO t_del VALUES (11)

statement ok
PRAGMA git4data_merge('t', 'target', 'base', 'fail')

query II
SELECT (SELECT count(*) FROM t_target WHERE k = 11), (SELECT v FROM t_target WHERE k = 3000)
----
0	3000

# a pick applies them to the live table,
statement ok
PRAGMA git4data_create_snapshot('before_pick')

statement ok
PRAGMA git4data_pick('t', 'base', 'before_pick', 'overwrite')

query II
SELECT (SELECT v FROM t WHERE k = 3000), (SELECT count(*) FROM t WHERE k = 11)
----
3000	0

# and a restore rewinds it to that line
statement ok
PRAGMA git4data_restore('t', 'base')

query II
SELECT (SELECT v FROM t WHERE k = 3000), (SELECT count(*) FROM t WHERE k = 11)
----
3000	0

# the delta is part of the branch, so it comes back with the file
statement ok
CHECKPOINT

restart

query III
SELECT (SELECT count(*) FROM t AT (BRANCH => 'base')),
       (SELECT v FROM t AT (BRANCH => 'base') WHERE k = 2000),
       (SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 5)
----
99	2000	0

# A fork from a branch that differs by a delta takes the state that branch holds: the child carries the
# line and reads the delta at the commit it forked at. Measured: the parent's own added row is there and
# the key its delta removed is gone.
statement ok
PRAGMA git4data_create_branch('forked', 'base')

query III
SELECT (SELECT count(*) FROM t AT (BRANCH => 'forked')),
       (SELECT v FROM t AT (BRANCH => 'forked') WHERE k = 2000),
       (SELECT count(*) FROM t AT (BRANCH => 'forked') WHERE k = 5)
----
99	2000	0

# and what the delta does afterwards is outside that pin
statement ok
INSERT INTO t_add VALUES (5000, 5000)

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'forked') WHERE k = 5000),
       (SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 5000)
----
0	1

# taken back out, so the counts the rest of this file asserts are the ones it was written against
statement ok
DELETE FROM t_add WHERE k = 5000

# A read after DDL lands on the delta's tables, and those have to be able to stand in for the source:
# the added rows are read as the source's rows. Saying so is better than the index-out-of-range the read
# used to raise, and the read recovers as soon as the schemas match again. It runs here because dropping
# a column discards its data, which the assertions above are about.
statement ok
ALTER TABLE t_add DROP COLUMN v

statement error
SELECT count(*) FROM t AT (BRANCH => 'base')
----
<REGEX>:.*holds the rows added to "t", and it no longer has that table's columns.*

statement ok
ALTER TABLE t_add ADD COLUMN v INTEGER

query I
SELECT count(*) FROM t AT (BRANCH => 'base')
----
99

# the source's schema is the other half of that
statement ok
ALTER TABLE t DROP COLUMN v

statement error
SELECT count(*) FROM t AT (BRANCH => 'base')
----
<REGEX>:.*holds the rows added to "t", and it no longer has that table's columns.*

statement ok
ALTER TABLE t ADD COLUMN v INTEGER

# An addition whose key the base already has is two rows: a delta says what to add and what to remove
# rather than what to replace, so a changed row is an added row and a removed key, as above. It is
# removed again here because a copy enforces the key, and this line is about to be copied.
statement ok
INSERT INTO t_add VALUES (12, 1200)

query I
SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 12
----
2

statement ok
DELETE FROM t_add WHERE k = 12

# materializing turns the delta into a copy of the branch's line, and that line is not the base's: the
# removed key is still gone and the added row is there, which is what the counts say
statement ok
PRAGMA git4data_materialize('t', 'base', 't_base')

query III
SELECT (SELECT count(*) FROM t_base), (SELECT count(*) FROM t_base WHERE k = 5),
       (SELECT count(*) FROM t_base WHERE k = 3000)
----
99	0	1

# The copy is the branch's line from then on, so the delta is cleared rather than left beside it: two
# answers to "what does this branch hold" is what silence looks like. The delta's tables are the
# caller's and stay where they are.
statement ok
INSERT INTO t_add VALUES (4000, 4000)

query II
SELECT (SELECT count(*) FROM t AT (BRANCH => 'base') WHERE k = 4000),
       (SELECT count(*) FROM t_add WHERE k = 4000)
----
0	1

# and a delta cannot be bound to a branch that already has a table of its own
statement error
PRAGMA git4data_bind_branch_delta('t', 'base', 't_add', 't_del')
----
<REGEX>:.*already has a table of its own for "t", so it reads that rather than a delta.*

# A delta's tables carry the same risk as a branch's own: a table that takes the name of one that was
# dropped is another table, and reading it would apply a delta the caller never made.
statement ok
CREATE TABLE t_e_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_e_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_create_branch('e', 'root')

statement ok
PRAGMA git4data_bind_branch_delta('t', 'e', 't_e_add', 't_e_del')

statement ok
INSERT INTO t_e_add VALUES (7000, 7000)

query I
SELECT count(*) FROM t AT (BRANCH => 'e') WHERE k = 7000
----
1

statement ok
DROP TABLE t_e_add

statement ok
CREATE TABLE t_e_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_e_add VALUES (8000, 8000)

statement error
SELECT count(*) FROM t AT (BRANCH => 'e')
----
<REGEX>:.*the tables carrying those names now are not them.*

# binding the delta again is the way out
statement ok
PRAGMA git4data_bind_branch_delta('t', 'e', 't_e_add', 't_e_del')

query I
SELECT count(*) FROM t AT (BRANCH => 'e') WHERE k = 8000
----
1

# A composite key is a key like any other, and the diff has to report a removal under one. It did not:
# which left rows a right row had accounted for was remembered by the *hash* of the key, and two
# composite keys that share a hash are two rows - so once one of them matched, the other's removal was
# dropped. Measured before the fix: a delta that removed a key reported `added` only, no `removed`.
statement ok
CREATE TABLE comp (a INTEGER, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
INSERT INTO comp SELECT CAST(floor(range / 5) AS INTEGER) AS a, range % 5 AS b, range AS v FROM range(25)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('cr', '')

statement ok
PRAGMA git4data_create_branch('cd', 'cr')

statement ok
CREATE TABLE cd_add (a INTEGER, b INTEGER, v INTEGER)

statement ok
CREATE TABLE cd_del (a INTEGER, b INTEGER)

statement ok
PRAGMA git4data_bind_branch_delta('comp', 'cd', 'cd_add', 'cd_del')

statement ok
INSERT INTO cd_del VALUES (2, 3)

statement ok
INSERT INTO cd_add VALUES (9, 9, 999)

statement ok
PRAGMA git4data_create_snapshot('comp_base')

# both differences are reported: the row the delta removed and the row it added
query III
SELECT g4d_change, a, b FROM git4data_diff('comp', 'comp_base', 'cd') ORDER BY g4d_change, a, b
----
added	9	9
removed	2	3

# and the branch itself reads 25 rows, the base's 25 less one plus one
query I
SELECT count(*) FROM comp AT (BRANCH => 'cd')
----
25
