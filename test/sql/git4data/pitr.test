# name: test/sql/git4data/pitr.test
# description: A point-in-time recovery window keeps recent history reachable
# group: [git4data]

load {TEST_DIR}/pitr.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

# A window that will not elapse on its own leaves the reference where it was opened, which is what
# makes that state reachable without anyone having taken a reference by hand.
statement ok
PRAGMA git4data_pitr(3650)

query III
PRAGMA git4data_pitr_state
----
true	3650	true

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
100

statement ok
INSERT INTO t SELECT 100 + range, range FROM range(100)

statement ok
CHECKPOINT

query I
SELECT count(*) FROM t
----
200

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
100

# so a rewind to a time after the window was opened reaches back to it
statement ok
PRAGMA git4data_restore_at('t', '2030-01-01 00:00:00')

query III
SELECT count(*), min(k), max(k) FROM t
----
100	0	99

# the policy is part of the file, so the reference is still held back after a reopen
restart

query III
PRAGMA git4data_pitr_state
----
true	3650	true

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
100

# A window is not the only reference a file can hold, and that is what makes the two kinds of reference meet.
# The references a *caller* makes are rows in `git4data.snapshots`, and the rebuild that runs once the log has
# been replayed is what brings them back - but it clears both registries first and refills them from the tables.
# The window's own reference is not a row: the engine creates and moves it from C++, so it lives in the
# checkpoint's registry block, and that block is read at open, *before* the rebuild. Measured, a window opened
# while the file already held a caller's reference came back as `reference_held = false` - and it then
# re-pinned itself at the current commit at the next checkpoint, silently narrowing the history it promises to
# the moment of the restart. **The order here is the point**: a window opened *before* the caller's first
# reference is copied into the tables by the migration that creates them, which is why the window is turned off
# and on again after it.
statement ok
PRAGMA git4data_create_snapshot('before_the_window')

statement ok
PRAGMA git4data_pitr_off

statement ok
PRAGMA git4data_pitr(3650)

restart

query III
PRAGMA git4data_pitr_state
----
true	3650	true

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
100

# and the caller's own reference came back with it, because it is a row
query I
SELECT count(*) FROM t AT (SNAPSHOT => 'before_the_window')
----
100

# A window of zero keeps nothing: the reference moves to the current state at every checkpoint, so
# the reach collapses onto the present.
statement ok
PRAGMA git4data_pitr_off

statement ok
PRAGMA git4data_pitr(0)

query III
PRAGMA git4data_pitr_state
----
true	0	true

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
100

statement ok
INSERT INTO t SELECT 200 + range, range FROM range(100)

statement ok
CHECKPOINT

query I
SELECT count(*) FROM t
----
200

query I
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
200

# turning the window off releases the reference it was moving
statement ok
PRAGMA git4data_pitr_off

query III
PRAGMA git4data_pitr_state
----
false	0	false

statement error
SELECT count(*) FROM t AT (SNAPSHOT => '__pitr__')
----
<REGEX>:.*__pitr__.*does not exist.*

query I
SELECT count(*) FROM t
----
200
