# name: test/sql/git4data/branch_time_travel.test
# description: A branch's own line has a history, readable at a snapshot like any other table
# group: [git4data]

load {TEST_DIR}/branch_time_travel.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b')

statement ok
UPDATE t_b SET v = 111 WHERE k = 1

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('s1')

statement ok
UPDATE t_b SET v = 222 WHERE k = 2

statement ok
DELETE FROM t_b WHERE k = 3

statement ok
CHECKPOINT

# the branch reads its own current state
query III
SELECT (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 2),
       (SELECT count(*) FROM t AT (BRANCH => 'b') WHERE k = 3)
----
111	222	0

# A branch's line is a table, and a table can be read at a snapshot - which is what makes a branch's
# own history readable rather than only its newest state. At 's1' only the first change had happened.
query III
SELECT (SELECT v FROM t_b AT (SNAPSHOT => 's1') WHERE k = 1), (SELECT v FROM t_b AT (SNAPSHOT => 's1') WHERE k = 2),
       (SELECT count(*) FROM t_b AT (SNAPSHOT => 's1') WHERE k = 3)
----
111	2	1

# A branch's storage is a table of its own, created when the branch was given one, so a snapshot taken
# before that reads nothing from it - the rows were inserted after that commit.
query I
SELECT count(*) FROM t_b AT (SNAPSHOT => 'base')
----
0

# the table the branch came from is untouched by any of it, at either snapshot
query III
SELECT (SELECT v FROM t WHERE k = 1), (SELECT count(*) FROM t WHERE k = 3),
       (SELECT count(*) FROM t AT (SNAPSHOT => 'base'))
----
1	1	10

# The clause carries a unit, and the feature answers two of them: SNAPSHOT and BRANCH. DuckDB parses two
# more - VERSION and TIMESTAMP, which a time-travelling catalog would read - and those are not taken as a
# reference named after their value: the clause is passed on to the catalog as written, which refuses it. A
# read of "AT (VERSION => 1)" is therefore an error and not a read of a reference called "1".
statement error
SELECT count(*) FROM t AT (VERSION => 1)
----
<REGEX>:.*does not support time travel.*

statement error
SELECT count(*) FROM t AT (TIMESTAMP => '2024-01-01'::TIMESTAMP)
----
<REGEX>:.*does not support time travel.*

# The unit picks the registry, so a name that is a branch is not a snapshot: the two are separate lookups,
# and each says which one came up empty. (`branch.test` asserts the other direction - a snapshot name asked
# for as a branch.)
statement error
SELECT count(*) FROM t AT (SNAPSHOT => 'b')
----
<REGEX>:.*Snapshot "b" does not exist.*

# The name is the *value* of the clause, not the text of the statement: a constant expression is evaluated
# and what it evaluates to is the reference asked for
query I
SELECT count(*) FROM t AT (SNAPSHOT => concat('ba', 'se'))
----
10

# A value that is not a string is still a name and nothing else - it is not a read of the live table, and
# not a crash: NULL is in the same position, since "no reference named NULL" is a name that is not there
statement error
SELECT count(*) FROM t AT (SNAPSHOT => 42)
----
<REGEX>:.*Snapshot "42" does not exist.*

statement error
SELECT count(*) FROM t AT (SNAPSHOT => NULL)
----
<REGEX>:.*Snapshot "NULL" does not exist.*

# the value side is bound as a constant before it becomes a name, so an expression that is not one is
# refused rather than silently naming something
statement error
SELECT count(*) FROM t AT (SNAPSHOT => k)
----
<REGEX>:.*AT clause cannot contain column names.*
