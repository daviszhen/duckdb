# name: test/sql/git4data/pick_branch.test
# description: Picking a materialized branch's changes onto the main line
# group: [git4data]

load {TEST_DIR}/pick_branch.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

statement ok
PRAGMA git4data_create_branch('feature', '')

statement ok
PRAGMA git4data_materialize('t', 'feature', 't_feature')

# the feature branch is written to on its own line: ten rows changed, ten removed, one added
statement ok
UPDATE t_feature SET v = v + 1000 WHERE k < 10

statement ok
DELETE FROM t_feature WHERE k >= 10 AND k < 20

statement ok
INSERT INTO t_feature VALUES (200, 200)

# the main line also moves on, and by a different number of appended rows, so the branch's storage
# table and the main table no longer share row ids - which is exactly why a pick has to match on the
# primary key rather than on a row id
statement ok
INSERT INTO t VALUES (300, 300)

statement ok
UPDATE t SET v = -1 WHERE k = 1

statement ok
CHECKPOINT

# a key both sides changed is a conflict, and fail refuses the whole pick
statement error
PRAGMA git4data_pick('t', 'feature', 'base', 'fail')
----
<REGEX>:.*pick conflict.*

query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k) FROM t WHERE k IN (0, 1, 200, 300)
----
0:0 1:-1 300:300

# skip takes the branch's changes everywhere the main line has not made one of its own
statement ok
PRAGMA git4data_pick('t', 'feature', 'base', 'skip')

query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k) FROM t WHERE k IN (0, 1, 5, 9, 200, 300)
----
0:1000 1:-1 5:1005 9:1009 200:200 300:300

# the rows the branch removed are gone from the main line, and the ones it never touched are untouched
query III
SELECT (SELECT count(*) FROM t WHERE k >= 10 AND k < 20), (SELECT v FROM t WHERE k = 50),
       (SELECT count(*) FROM t)
----
0	50	92

# the branch itself is unchanged by the pick: the changes were copied over, not moved
query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k)
FROM t AT (BRANCH => 'feature') WHERE k IN (0, 1, 5, 9, 200)
----
0:1000 1:1001 5:1005 9:1009 200:200

# The branch is a line of its own, and the pick copied its changes rather than moving them: the diff
# between the reference and the branch still reports exactly what the branch did.
query II
SELECT change, count(*) FROM git4data_diff('t', 'base', 'feature') GROUP BY change ORDER BY change
----
added	1
changed	10
removed	10
