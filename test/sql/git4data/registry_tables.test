# name: test/sql/git4data/registry_tables.test
# description: The reference registry kept in tables, which is what carries a reference through a restart
# group: [git4data]

load {TEST_DIR}/registry_tables.db

statement ok
CREATE TABLE rt (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO rt SELECT range, range FROM range(4)

statement ok
CHECKPOINT

# A reference is a row in these tables, so it reaches the log like any other change and comes back whether
# or not a checkpoint happened to run: before them a session whose only change was a reference left no log
# at all, the close-time checkpoint skipped its body for an empty log, and the reference was gone.
statement ok
PRAGMA git4data_create_snapshot('rt_only')

statement ok
PRAGMA git4data_create_branch('rt_b', '')

statement ok
PRAGMA git4data_materialize('rt', 'rt_b', 'rt_b_copy')

statement ok
PRAGMA git4data_create_snapshot('rt_line', 'rt_b')

# the row is written exactly once, by the statement the pragma returns: the tables are made and the file's
# own references migrated into them before the new one joins the registry in memory, which is what keeps the
# first reference from being written twice (measured: a clone of a one-snapshot database had two rows)
query II
SELECT (SELECT count(*) FROM git4data.snapshots WHERE name = 'rt_only'),
       (SELECT count(*) FROM git4data.snapshots WHERE name = 'rt_line')
----
1	1

restart

# the rows survived, and so did what they name
query II
SELECT (SELECT count(*) FROM git4data.snapshots WHERE name = 'rt_only'),
       (SELECT count(*) FROM git4data.snapshots WHERE name = 'rt_line')
----
1	1

query II
SELECT (SELECT count(*) FROM rt AT (SNAPSHOT => 'rt_only')),
       (SELECT v FROM rt AT (SNAPSHOT => 'rt_line') WHERE k = 1)
----
4	1

# a snapshot dropped after a restart takes its row with it, or the next open would bring it back
statement ok
PRAGMA git4data_drop_snapshot('rt_only')

query I
SELECT count(*) FROM git4data.snapshots
----
1

restart

query I
SELECT count(*) FROM git4data.snapshots
----
1

# git4data_forget_internal is what the merge's generated SQL calls to drop the reference it made for itself.
# That one name is the only thing it accepts: it forgets a reference in memory only, so a name it does not
# own would read again the moment its row was loaded - and the window, which is reserved as well, would lose
# the reach it promised without saying so.
statement error
PRAGMA git4data_forget_internal('rt_only')
----
<REGEX>:.*is not the reference this forgets.*

# A branch and the tables it reads are rows too, and they are written the same way, so they survive a restart.
# **Why this restart carries them in the file rather than in a log, located in 3dl**: the sqllogictest harness
# gives every test a `checkpoint_wal_size` of 0 (`test/helpers/test_helpers.cpp`), so each committing
# transaction checkpoints on its own and a log never has anything in it - measured, `wal_size` reads
# `0 bytes` after a bare `CREATE TABLE` and `glob('{TEST_DIR}/x.db*')` finds the database file alone. This
# comment used to say the *close* is what checkpoints, which is where the same measurement was first taken;
# that is a consequence, not the cause. **The log path is therefore reachable here**, not only in a shell:
# `PRAGMA checkpoint_threshold='10GB'` keeps the tail in the log, and the case at the end of this file stages
# it - a reference made after the last checkpoint coming back through the replay.
statement ok
CREATE TABLE rt2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO rt2 SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('rt2_own', '')

statement ok
PRAGMA git4data_materialize('rt2', 'rt2_own', 'rt2_copy')

statement ok
UPDATE rt2_copy SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('rt2_delta', '')

statement ok
CREATE TABLE rt2_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE rt2_del (k INTEGER PRIMARY KEY)

statement ok
INSERT INTO rt2_add VALUES (100, 100)

statement ok
PRAGMA git4data_bind_branch_delta('rt2', 'rt2_delta', 'rt2_add', 'rt2_del')

# the rows are there before the restart, one per mapping
query III
SELECT (SELECT count(*) FROM git4data.branches WHERE name = 'rt2_own'),
       (SELECT count(*) FROM git4data.storage WHERE branch = 'rt2_own' AND source = 'rt2'),
       (SELECT count(*) FROM git4data.deltas WHERE branch = 'rt2_delta' AND source = 'rt2')
----
1	1	1

restart

# and they are still there after it, without a checkpoint in between: the branch holds the line it was
# given, and the delta branch holds its own edits over the base
query III
SELECT (SELECT count(*) FROM git4data.branches WHERE name IN ('rt2_own', 'rt2_delta')),
       (SELECT count(*) FROM git4data.storage WHERE branch = 'rt2_own'),
       (SELECT count(*) FROM git4data.deltas WHERE branch = 'rt2_delta')
----
2	1	1

query III
SELECT (SELECT v FROM rt2 AT (BRANCH => 'rt2_own') WHERE k = 1),
       (SELECT count(*) FROM rt2 AT (BRANCH => 'rt2_own')),
       (SELECT count(*) FROM rt2 AT (BRANCH => 'rt2_delta') WHERE k = 100)
----
111	4	1

# dropping the branch takes its rows with it, so the next open does not read it back
statement ok
PRAGMA git4data_drop_branch('rt2_delta')

query II
SELECT (SELECT count(*) FROM git4data.branches WHERE name = 'rt2_delta'),
       (SELECT count(*) FROM git4data.deltas WHERE branch = 'rt2_delta')
----
0	0

restart

query II
SELECT (SELECT count(*) FROM git4data.branches WHERE name = 'rt2_delta'),
       (SELECT count(*) FROM git4data.deltas WHERE branch = 'rt2_delta')
----
0	0

# The registry's tables are the feature's own state, and a caller writing them would take a reference's
# meaning with it: a deleted snapshot row takes its pin, and the history that pin holds down is reclaimed
# under a reference that still names it. Reading them is allowed - they are how a caller can see what the
# feature is keeping - and the feature's own statements, which are the ones that write them, still run.
query I
SELECT count(*) FROM git4data.snapshots
----
1

statement error
INSERT INTO git4data.snapshots VALUES ('forged', 1, TIMESTAMP '2020-01-01 00:00:00', '')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
DELETE FROM git4data.branches
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
UPDATE git4data.storage SET storage = 'elsewhere'
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
DROP TABLE git4data.deltas
----
<REGEX>:.*is the schema the reference registry is kept in.*

statement error
DROP SCHEMA git4data
----
<REGEX>:.*is the schema the reference registry is kept in.*

statement error
ALTER TABLE git4data.snapshots ADD COLUMN extra INTEGER
----
<REGEX>:.*is the schema the reference registry is kept in.*

# **The statements that are not writes but leave the same hole**, each measured and pinned here because the
# guard is on the *schema* rather than on a list of statement types. A rename takes the table the feature looks
# up away; dropping the column that holds a reference's pin leaves a row the feature cannot read; TRUNCATE
# empties the table through the delete path rather than the write path; and a view is a caller's object in the
# feature's own schema. TRUNCATE is the one worth its own line for a second reason: it was refused before this
# test existed, and a refusal nothing asserts is a refusal that can be removed without anything noticing.
statement error
ALTER TABLE git4data.snapshots RENAME TO sn2
----
<REGEX>:.*is the schema the reference registry is kept in.*

statement error
ALTER TABLE git4data.snapshots DROP COLUMN line
----
<REGEX>:.*is the schema the reference registry is kept in.*

statement error
TRUNCATE git4data.snapshots
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
CREATE VIEW git4data.v AS SELECT 1
----
<REGEX>:.*is in the schema the reference registry is kept in.*

# And where the boundary is: an index on one of those tables is *allowed*, because it changes no row and the
# feature's statements keep it up to date like any other table's. Pinning the allowance is what makes a future
# refusal a decision rather than a drift.
# (the index name is unqualified because DuckDB's CREATE INDEX does not take a schema for it; it lands in the
# table's schema, which is this one)
statement ok
CREATE INDEX ix ON git4data.snapshots(name)

query I
SELECT count(*) FROM duckdb_indexes() WHERE schema_name = 'git4data' AND index_name = 'ix'
----
1

# And creating there is refused too, which DROP and ALTER were standing in for: measured,
# `CREATE OR REPLACE TABLE git4data.snapshots (a INTEGER)` replaced the table and every reference with it -
# the count below read 0 - and a caller's own table in the feature's schema went through as well.
statement error
CREATE TABLE git4data.mine (x INTEGER)
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE OR REPLACE TABLE git4data.snapshots (a INTEGER)
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE TABLE git4data.copy AS SELECT 1 AS a
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE VIEW git4data.v AS SELECT 1 AS a
----
<REGEX>:.*is in the schema the reference registry is kept in.*

# MERGE INTO reaches the rows through none of INSERT, UPDATE or DELETE, and it was measured doing exactly
# what they are refused for: `MERGE INTO git4data.snapshots ... WHEN NOT MATCHED THEN INSERT ...` put a
# forged reference in the registry (the count below went from 1 to 2 before this was refused).
# COPY ... FROM is a fourth way to write rows and reaches the guard through the insert path rather than
# through a statement of its own, so it is asserted here rather than left to the INSERT case above: measured,
# it is refused with the same message and the row count does not move.
statement error
COPY git4data.snapshots FROM '{TEST_DIR}/registry_tables.test' (FORMAT CSV)
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
MERGE INTO git4data.snapshots USING (SELECT 'forged' AS name) s ON (git4data.snapshots.name = s.name) WHEN NOT MATCHED THEN INSERT VALUES ('forged', 1, TIMESTAMP '2020-01-01 00:00:00', '')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

# and the references are untouched by all of it
query II
SELECT (SELECT count(*) FROM git4data.snapshots), (SELECT count(*) FROM git4data.branches)
----
1	2

# **The rest of the boundary, and the hole it had (3dm).** A view and a table were refused above; a
# **sequence, a type and a macro** were not, and neither was any of them written without a schema while the
# session's default schema was this one - an entry type that never reached a check, and a *resolved* schema
# that the check did not look at because it read the schema the caller wrote. Measured before the fix:
# `CREATE SEQUENCE git4data.seq` succeeded (and `duckdb_sequences()` then listed `git4data`, so the schema
# stopped being invisible), and `SET schema='git4data'; CREATE TABLE mine (x INTEGER)` put a caller's table in
# the feature's own schema. The refusal is on the resolved schema now, which is what closes both, and an
# **index** stays allowed exactly as the boundary above says - it is a decision, and it is still the one.
statement error
CREATE SEQUENCE git4data.seq
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE TYPE git4data.ty AS INTEGER
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE MACRO git4data.mac() AS 1
----
<REGEX>:.*is in the schema the reference registry is kept in.*

# the same three written without a schema, through the session's default schema - the form the written-schema
# check could not see
statement ok
SET schema='git4data'

statement error
CREATE TABLE mine (x INTEGER)
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE SEQUENCE mine_seq
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE TYPE mine_type AS INTEGER
----
<REGEX>:.*is in the schema the reference registry is kept in.*

statement error
CREATE MACRO mine_macro() AS 1
----
<REGEX>:.*is in the schema the reference registry is kept in.*

# the index allowance is not affected by the default schema, because an index is created where its table is
statement ok
CREATE INDEX mine_ix ON snapshots(name)

# and reading the registry by name still works while that schema is the default, which is what a caller who
# sets it is after
query I
SELECT count(*) FROM snapshots
----
1

statement ok
SET schema='main'

# none of it put anything of the caller's in the feature's schema: the tables and the one allowed index are
# all that is there
query II
SELECT (SELECT count(*) FROM duckdb_sequences() WHERE schema_name = 'git4data'),
       (SELECT count(*) FROM duckdb_types() WHERE schema_name = 'git4data')
----
0	0

# **The write guard has a back door, and it is the feature's own statements (3dn).** A caller cannot write the
# registry tables - but a *binding* can point the feature at them, and everything the feature writes goes
# through statements marked internal, which is exactly what lets them past that guard. Measured, with a source
# shaped like `git4data.snapshots` (four columns, primary key on the first): `git4data_bind_branch_delta` took
# `git4data.snapshots` as the delta's added table, and `git4data_apply` then landed a row naming a **forged
# snapshot with a pin of the caller's choosing** - `SELECT count(*) FROM t AT (SNAPSHOT => 'forged')` read one
# row through it, and the row is in the file, so the next open loads it like any other reference. A pin is what
# holds history, so a forged one is a forged retention promise as well. The refusal is on the aim rather than
# on the shot, because every writer goes through a binding: the table a branch is given, and both sides of a
# delta, cannot be one of these tables.
statement ok
CREATE TABLE reg_shape (branch VARCHAR PRIMARY KEY, source VARCHAR, storage VARCHAR, owned BOOLEAN)

statement ok
INSERT INTO reg_shape VALUES ('x', 'y', 'z', false)

statement ok
CREATE TABLE reg_delta_shape (branch VARCHAR PRIMARY KEY, source VARCHAR, added VARCHAR, removed VARCHAR)

statement ok
INSERT INTO reg_delta_shape VALUES ('x', 'y', 'z', 'w')

statement ok
CREATE TABLE reg_delta_del (branch VARCHAR PRIMARY KEY)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('reg_b', '')

statement error
PRAGMA git4data_bind_branch_table('reg_shape', 'reg_b', 'git4data.storage')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
PRAGMA git4data_bind_branch_delta('reg_delta_shape', 'reg_b', 'git4data.deltas', 'reg_delta_del')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
PRAGMA git4data_bind_branch_delta('reg_delta_shape', 'reg_b', 'reg_delta_shape', 'git4data.deltas')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

# The other two writers take the live table as an argument rather than through a binding: a pick and a restore
# both write it with the feature's own statements. Neither could be aimed at the registry through a qualified
# name (the resolver reads `git4data.snapshots` as one identifier first), which is what the default schema is
# for - and that is how the write was reached, measured, before this refusal existed.
statement ok
SET schema='git4data'

statement error
PRAGMA git4data_restore('snapshots', 'reg_b')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
PRAGMA git4data_restore_at('snapshots', '2030-01-01 00:00:00')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement error
PRAGMA git4data_pick('snapshots', 'reg_b', 'reg_b')
----
<REGEX>:.*is one of the tables the reference registry is kept in.*

statement ok
SET schema='main'

# and none of it wrote anything: no forged reference and no delta row, and the one branch the test made here is
# the only thing these statements added
query II
SELECT (SELECT count(*) FROM git4data.snapshots WHERE name = 'forged'),
       (SELECT count(*) FROM git4data.deltas)
----
0	0

query I
SELECT count(*) FROM git4data.branches WHERE name = 'reg_b'
----
1

# The schema is the feature's own bookkeeping, so it is not part of what the database looks like to a
# caller: SHOW TABLES and information_schema.tables are queries over duckdb_tables(), and that function
# leaves it out. Reading the tables by name still works - that is how a caller sees what the feature keeps.
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'git4data'
----
0

query I
SELECT count(*) FROM information_schema.tables WHERE table_schema = 'git4data'
----
0

# **Three filters hold that up**, one in each of the catalog's own table functions - `duckdb_tables`,
# `duckdb_schemas` and `duckdb_columns` - and only the first of them was asserted here. A caller browsing the
# database meets the feature's bookkeeping through any of the three: the schema on its own, and the columns of
# the tables in it.
query II
SELECT (SELECT count(*) FROM duckdb_schemas() WHERE schema_name = 'git4data'),
       (SELECT count(*) FROM information_schema.schemata WHERE schema_name = 'git4data')
----
0	0

query II
SELECT (SELECT count(*) FROM duckdb_columns() WHERE schema_name = 'git4data'),
       (SELECT count(*) FROM information_schema.columns WHERE table_schema = 'git4data')
----
0	0

query I
SELECT count(*) FROM git4data.snapshots
----
1

# and the tables the caller does have are still listed
query I
SELECT count(*) FROM duckdb_tables() WHERE schema_name = 'main' AND table_name = 'rt'
----
1

# the same skip in the other two catalog functions that walk the schemas: the columns of those tables and
# the schema itself are not part of what the database looks like to a caller
query I
SELECT count(*) FROM duckdb_columns() WHERE schema_name = 'git4data'
----
0

query I
SELECT count(*) FROM duckdb_schemas() WHERE schema_name = 'git4data'
----
0

# and the caller's own columns are still listed
query I
SELECT count(*) FROM duckdb_columns() WHERE table_name = 'rt'
----
2

# A reference is a row now, so a rollback takes it - and the in-memory registries have to follow, or the
# rest of the session keeps showing a reference that is on no disk. They are rebuilt from the tables after a
# rollback, which is what this asserts.
statement ok
CREATE TABLE rb_src (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO rb_src VALUES (1, 1)

statement ok
CHECKPOINT

statement ok
BEGIN

statement ok
PRAGMA git4data_create_snapshot('rb_gone')

statement ok
ROLLBACK

statement error
SELECT count(*) FROM rb_src AT (SNAPSHOT => 'rb_gone')
----
<REGEX>:.*Snapshot "rb_gone" does not exist.*

query I
SELECT count(*) FROM git4data.snapshots WHERE name = 'rb_gone'
----
0

# and a reference made after the rollback is unaffected by the rebuild
statement ok
PRAGMA git4data_create_snapshot('rb_kept')

query I
SELECT count(*) FROM git4data.snapshots WHERE name = 'rb_kept'
----
1

restart

query I
SELECT count(*) FROM git4data.snapshots WHERE name = 'rb_kept'
----
1

# **The log path, in a test file.** The harness checkpoints every commit (see the note above the `rt2` case),
# so nothing normally sits in a log; raising the threshold keeps the tail there instead. The last checkpoint
# above is what put the file's state in place, so everything written after it is carried by the log alone -
# which makes this the replay doing the carrying. It is the mechanism the registry-in-tables change was for: a
# session whose only change is a reference has no reason for a checkpoint to run, and the reference has to come
# back anyway. **What this case depends on, measured in 3dl**: the open's `Git4DataLoadRegistry`
# (`storage_manager.cpp`, after `WriteAheadLog::Replay`). Commenting that call out fails **31 of the 83 feature
# files**, this one among them - so the registry read at open is what makes a reopened database answer for its
# references, and no reconcile on a later use makes up for it. **What it does *not* depend on is the ordering**:
# moving the load *above* the replay leaves this file passing unchanged, which is recorded here because the
# comment first written for this case claimed that move would fail - it does not, and the reason is that a
# registry loaded too early is repaired from the tables on the next use.
statement ok
PRAGMA checkpoint_threshold='10GB'

statement ok
PRAGMA git4data_create_branch('rt_log', '')

# the log is there, and the branch's row is in it rather than in the file
query I
SELECT count(*) FROM glob('{TEST_DIR}/registry_tables.db.wal')
----
1

restart

query II
SELECT (SELECT count(*) FROM git4data.branches WHERE name = 'rt_log'),
       (SELECT count(*) FROM rt2 AT (BRANCH => 'rt_log'))
----
1	4
