# name: test/sql/git4data/merge.test
# description: Three-way merge of one branch into another, with conflict policies
# group: [git4data]

load {TEST_DIR}/merge.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

# two branches off one ancestor, so the ancestor is their least common base
statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('left', 'root')

statement ok
PRAGMA git4data_create_branch('right', 'root')

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_materialize('t', 'left', 't_left')

statement ok
PRAGMA git4data_materialize('t', 'right', 't_right')

# each side changes a different row
statement ok
INSERT INTO t_left VALUES (1000, 1)

statement ok
INSERT INTO t_right VALUES (2000, 2)

statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'fail')

query I
SELECT count(*) FROM t AT (BRANCH => 'left')
----
102

query I
SELECT v FROM t_left WHERE k = 2000
----
2

# the merge lands in the left branch, so the source table is untouched
query I
SELECT count(*) FROM t
----
100

# a real conflict: the same key, changed differently on each side
statement ok
INSERT INTO t_left VALUES (3000, 3)

statement ok
INSERT INTO t_right VALUES (3000, 99)

statement error
PRAGMA git4data_merge('t', 'left', 'right', 'fail')
----
<REGEX>:.*merge conflict.*

# failing applies nothing at all, not half of it
query I
SELECT count(*) FROM t_left WHERE k = 2000
----
1

query I
SELECT v FROM t_left WHERE k = 3000
----
3

# skip leaves a conflicting key as the left branch has it
statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'skip')

query I
SELECT v FROM t_left WHERE k = 3000
----
3

# accept takes the right branch's version
statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'accept')

query I
SELECT v FROM t_left WHERE k = 3000
----
99

# The same change made on both sides is not a conflict, so a policy of fail does not refuse it -
# otherwise two branches adding the same row could never be merged.
statement ok
INSERT INTO t_left VALUES (5000, 5)

statement ok
INSERT INTO t_right VALUES (5000, 5)

statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'fail')

query I
SELECT count(*) FROM t_left WHERE k = 5000
----
1

# a merge has to land somewhere writable, and root has neither a table of its own nor a delta yet
statement error
PRAGMA git4data_merge('t', 'root', 'left', 'fail')
----
<REGEX>:.*has neither a table of its own nor a delta.*

statement ok
PRAGMA git4data_materialize('t', 'root', 't_root')

# merged into a branch that is an ancestor: right's changes relative to the ancestor apply cleanly
statement ok
PRAGMA git4data_merge('t', 'root', 'right', 'fail')

query I
SELECT count(*) FROM t_root
----
103

statement error
PRAGMA git4data_merge('t', 'left', 'nope', 'fail')
----
<REGEX>:.*nope.*does not exist.*

statement error
PRAGMA git4data_merge('t', 'left', 'right', 'maybe')
----
<REGEX>:.*fail, skip or accept.*

# and it still works after the file is reopened
statement ok
CHECKPOINT

restart

query I
SELECT v FROM t_left WHERE k = 3000
----
99

query I
SELECT count(*) FROM t AT (BRANCH => 'left')
----
104

# ---------------------------------------------------------------------------------------------------------
# A merge inside the caller's transaction, and what a refusal leaves behind
# ---------------------------------------------------------------------------------------------------------

# A merge is a group of statements in the caller's transaction, and one of them builds a helper table holding
# the conflicts. A refusal aborts the whole transaction, so the caller has to roll back - and the rollback has
# to leave no trace: no helper table, and no change to either side. Measured, that is what happens: the helper
# is a `CREATE OR REPLACE TEMP TABLE`, and a temp table made inside the transaction goes with it.
statement ok
CREATE TABLE tx_t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO tx_t VALUES (1, 10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('tx_root', '')

statement ok
PRAGMA git4data_create_branch('tx_left', 'tx_root')

statement ok
PRAGMA git4data_create_branch('tx_right', 'tx_root')

statement ok
PRAGMA git4data_materialize('tx_t', 'tx_left', 'tx_left_t')

statement ok
PRAGMA git4data_materialize('tx_t', 'tx_right', 'tx_right_t')

# the same row, changed differently on each side
statement ok
UPDATE tx_left_t SET v = 111 WHERE k = 1

statement ok
UPDATE tx_right_t SET v = 222 WHERE k = 1

statement ok
BEGIN

statement error
PRAGMA git4data_merge('tx_t', 'tx_left', 'tx_right', 'fail')
----
<REGEX>:.*merge conflict.*

# the session is in an aborted transaction after a refusal, which the note records as the one thing a caller
# has to clear; the rollback clears it and takes the merge with it
statement ok
ROLLBACK

query I
SELECT v FROM tx_left_t WHERE k = 1
----
111

query I
SELECT v FROM tx_right_t WHERE k = 1
----
222

# no helper table is left behind by the refusal
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name LIKE 'g4d%'
----
0

# and the merge still works when the caller asks it to skip the conflicting row
statement ok
PRAGMA git4data_merge('tx_t', 'tx_left', 'tx_right', 'skip')

query I
SELECT v FROM tx_left_t WHERE k = 1
----
111

# Both sides removing the same row is agreement, not a conflict - there is no row left on either side for
# them to disagree about. Measured before this was fixed: that case was refused with the conflict message,
# so a caller with nothing to resolve was told to resolve something.
statement ok
CREATE TABLE g (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO g SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('ga', '')

statement ok
PRAGMA git4data_create_branch('ga1', 'ga')

statement ok
PRAGMA git4data_create_branch('ga2', 'ga')

statement ok
PRAGMA git4data_materialize('g', 'ga1', 'g_ga1')

statement ok
PRAGMA git4data_materialize('g', 'ga2', 'g_ga2')

statement ok
DELETE FROM g_ga1 WHERE k = 5

statement ok
DELETE FROM g_ga2 WHERE k = 5

statement ok
PRAGMA git4data_merge('g', 'ga1', 'ga2', 'fail')

query I
SELECT count(*) FROM g AT (BRANCH => 'ga1')
----
9

# and the rule is not wider than that: removing the row on one side while the other changes it is still a
# conflict, because the two sides did not end up with the same row
statement ok
PRAGMA git4data_create_branch('gb', '')

statement ok
PRAGMA git4data_create_branch('gb1', 'gb')

statement ok
PRAGMA git4data_create_branch('gb2', 'gb')

statement ok
PRAGMA git4data_materialize('g', 'gb1', 'g_gb1')

statement ok
PRAGMA git4data_materialize('g', 'gb2', 'g_gb2')

statement ok
DELETE FROM g_gb1 WHERE k = 6

statement ok
UPDATE g_gb2 SET v = 999 WHERE k = 6

statement error
PRAGMA git4data_merge('g', 'gb1', 'gb2', 'fail')
----
<REGEX>:.*merge conflict.*

# A branch does not have to have a table of its own to be merged into: one that differs by a delta has
# somewhere to record the change, and it is the same two tables git4data_apply records in. Measured before
# this was possible, such a target was refused with "has no storage of its own ... materialize it first", so a
# branch written through a delta could be given another branch's changes only by hand.
statement ok
CREATE TABLE dm (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO dm SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
CREATE TABLE dm_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE dm_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_create_branch('dleft', '')

statement ok
PRAGMA git4data_bind_branch_delta('dm', 'dleft', 'dm_add', 'dm_del')

statement ok
PRAGMA git4data_create_branch('dright', 'dleft')

statement ok
PRAGMA git4data_materialize('dm', 'dright', 'dm_right')

statement ok
INSERT INTO dm_right VALUES (500, 500)

statement ok
DELETE FROM dm_right WHERE k = 3

statement ok
UPDATE dm_right SET v = 777 WHERE k = 4

statement ok
PRAGMA git4data_merge('dm', 'dleft', 'dright', 'fail')

# the row it added comes with it, the row it removed is gone, and the row it changed reads its value - all of
# it recorded as delta rows, because that is where this branch keeps its own line
query IIII
SELECT (SELECT count(*) FROM dm AT (BRANCH => 'dleft') WHERE k = 500),
       (SELECT count(*) FROM dm AT (BRANCH => 'dleft') WHERE k = 3),
       (SELECT v FROM dm AT (BRANCH => 'dleft') WHERE k = 4),
       (SELECT count(*) FROM dm AT (BRANCH => 'dleft'))
----
1	0	777	10

query II
SELECT (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM dm_add),
       (SELECT string_agg(k::VARCHAR, ',' ORDER BY k) FROM dm_del)
----
4,500	3,4

# and the source table itself is untouched by a merge that lands in a delta
query I
SELECT count(*) FROM dm
----
10

# The three conflict policies work the same way when the merge lands in a delta: fail refuses, skip leaves the
# conflicting key as the left has it, and accept takes the right's row - and a row the right removed lands too.
# Both sides change k = 1 differently, which a delta records as a removal plus an added row.
statement ok
CREATE TABLE pm1 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE pm2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO pm1 SELECT range, range FROM range(10)

statement ok
INSERT INTO pm2 SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
CREATE TABLE p1la (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE p1ld (k INTEGER PRIMARY KEY)

statement ok
CREATE TABLE p1ra (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE p1rd (k INTEGER PRIMARY KEY)

statement ok
CREATE TABLE p2la (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE p2ld (k INTEGER PRIMARY KEY)

statement ok
CREATE TABLE p2ra (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE p2rd (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_create_branch('p1base', '')

statement ok
PRAGMA git4data_create_branch('p1l', 'p1base')

statement ok
PRAGMA git4data_create_branch('p1r', 'p1base')

statement ok
PRAGMA git4data_bind_branch_delta('pm1', 'p1l', 'p1la', 'p1ld')

statement ok
PRAGMA git4data_bind_branch_delta('pm1', 'p1r', 'p1ra', 'p1rd')

statement ok
PRAGMA git4data_create_branch('p2base', '')

statement ok
PRAGMA git4data_create_branch('p2l', 'p2base')

statement ok
PRAGMA git4data_create_branch('p2r', 'p2base')

statement ok
PRAGMA git4data_bind_branch_delta('pm2', 'p2l', 'p2la', 'p2ld')

statement ok
PRAGMA git4data_bind_branch_delta('pm2', 'p2r', 'p2ra', 'p2rd')

statement ok
INSERT INTO p1ld VALUES (1)

statement ok
INSERT INTO p1la VALUES (1, 111)

statement ok
INSERT INTO p1rd VALUES (1)

statement ok
INSERT INTO p1ra VALUES (1, 222)

statement error
PRAGMA git4data_merge('pm1', 'p1l', 'p1r', 'fail')
----
<REGEX>:.*merge conflict.*

statement ok
PRAGMA git4data_merge('pm1', 'p1l', 'p1r', 'skip')

query III
SELECT (SELECT v FROM pm1 AT (BRANCH => 'p1l') WHERE k = 1), (SELECT count(*) FROM p1la WHERE k = 1),
       (SELECT count(*) FROM p1ld WHERE k = 1)
----
111	1	1

# accept takes the right's value for the conflicting key, and the key the right removed goes with it
statement ok
INSERT INTO p2ld VALUES (1)

statement ok
INSERT INTO p2la VALUES (1, 111)

statement ok
INSERT INTO p2rd VALUES (1)

statement ok
INSERT INTO p2ra VALUES (1, 222)

statement ok
INSERT INTO p2rd VALUES (7)

statement ok
PRAGMA git4data_merge('pm2', 'p2l', 'p2r', 'accept')

query IIII
SELECT (SELECT v FROM pm2 AT (BRANCH => 'p2l') WHERE k = 1), (SELECT count(*) FROM pm2 AT (BRANCH => 'p2l') WHERE k = 7),
       (SELECT count(*) FROM p2la WHERE k = 1), (SELECT count(*) FROM p2ld WHERE k = 1)
----
222	0	1	1

# Both sides making the same addition leaves one row in the target, not two: a second copy of it in the delta's
# added table would make the branch's own read answer with a duplicate-key error.
statement ok
CREATE TABLE pn (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO pn SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
CREATE TABLE pna (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE pnd (k INTEGER PRIMARY KEY)

statement ok
CREATE TABLE pnra (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE pnrd (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_create_branch('pnbase', '')

statement ok
PRAGMA git4data_create_branch('pnl', 'pnbase')

statement ok
PRAGMA git4data_create_branch('pnr', 'pnbase')

statement ok
PRAGMA git4data_bind_branch_delta('pn', 'pnl', 'pna', 'pnd')

statement ok
PRAGMA git4data_bind_branch_delta('pn', 'pnr', 'pnra', 'pnrd')

statement ok
INSERT INTO pna VALUES (100, 100)

statement ok
INSERT INTO pnra VALUES (100, 100)

statement ok
PRAGMA git4data_merge('pn', 'pnl', 'pnr', 'fail')

query III
SELECT (SELECT count(*) FROM pn AT (BRANCH => 'pnl') WHERE k = 100), (SELECT count(*) FROM pna WHERE k = 100),
       (SELECT count(*) FROM pn AT (BRANCH => 'pnl'))
----
1	1	11

# A composite key is a key like any other for a merge that lands in a delta: the landing matches rows on the
# whole key, so a table whose key is two columns has to work as well as a single-column one.
statement ok
CREATE TABLE ck (a INTEGER, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
INSERT INTO ck SELECT range // 10, range % 10, range FROM range(20)

statement ok
CHECKPOINT

statement ok
CREATE TABLE ck_add (a INTEGER, b INTEGER, v INTEGER, PRIMARY KEY (a, b))

statement ok
CREATE TABLE ck_del (a INTEGER, b INTEGER, PRIMARY KEY (a, b))

statement ok
PRAGMA git4data_create_branch('ckbase', '')

statement ok
PRAGMA git4data_create_branch('ckl', 'ckbase')

statement ok
PRAGMA git4data_create_branch('ckr', 'ckbase')

statement ok
PRAGMA git4data_bind_branch_delta('ck', 'ckl', 'ck_add', 'ck_del')

statement ok
PRAGMA git4data_materialize('ck', 'ckr', 'ck_copy')

statement ok
INSERT INTO ck_copy VALUES (5, 5, 555)

statement ok
DELETE FROM ck_copy WHERE a = 0 AND b = 1

statement ok
UPDATE ck_copy SET v = 777 WHERE a = 0 AND b = 2

statement ok
PRAGMA git4data_merge('ck', 'ckl', 'ckr', 'fail')

query IIII
SELECT (SELECT v FROM ck AT (BRANCH => 'ckl') WHERE a = 5 AND b = 5),
       (SELECT count(*) FROM ck AT (BRANCH => 'ckl') WHERE a = 0 AND b = 1),
       (SELECT v FROM ck AT (BRANCH => 'ckl') WHERE a = 0 AND b = 2),
       (SELECT count(*) FROM ck AT (BRANCH => 'ckl'))
----
555	0	777	20

query II
SELECT (SELECT string_agg(a::VARCHAR || ':' || b::VARCHAR, ',' ORDER BY a, b) FROM ck_add),
       (SELECT string_agg(a::VARCHAR || ':' || b::VARCHAR, ',' ORDER BY a, b) FROM ck_del)
----
0:2,5:5	0:1,0:2

query I
SELECT count(*) FROM ck
----
20

