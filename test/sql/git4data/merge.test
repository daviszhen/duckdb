statement ok
CREATE TABLE cp_del4 (a INTEGER, b INTEGER, PRIMARY KEY (a, b))

statement ok
PRAGMA git4data_create_branch('cps1', '')

statement ok
PRAGMA git4data_create_branch('cpl1', 'cps1')

statement ok
PRAGMA git4data_create_branch('cpr1', 'cps1')

statement ok
PRAGMA git4data_create_branch('cps2', '')

statement ok
PRAGMA git4data_create_branch('cpl2', 'cps2')

statement ok
PRAGMA git4data_create_branch('cpr2', 'cps2')

statement ok
PRAGMA git4data_bind_branch_delta('cp', 'cpl1', 'cp_add1', 'cp_del1')

