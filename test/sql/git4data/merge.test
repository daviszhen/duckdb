statement ok
PRAGMA git4data_apply('cp', 'cpl1', 'UPDATE cp SET v = 111 WHERE a = 1 AND b = 1')

statement ok
PRAGMA git4data_apply('cp', 'cpr1', 'UPDATE cp SET v = 222 WHERE a = 1 AND b = 1')

statement ok
PRAGMA git4data_apply('cp', 'cpl2', 'UPDATE cp SET v = 111 WHERE a = 1 AND b = 1')

statement ok
PRAGMA git4data_apply('cp', 'cpr2', 'UPDATE cp SET v = 222 WHERE a = 1 AND b = 1')

statement error
PRAGMA git4data_merge('cp', 'cpl1', 'cpr1', 'fail')
----
<REGEX>:.*merge conflict.*

statement ok
PRAGMA git4data_merge('cp', 'cpl1', 'cpr1', 'skip')

query I
SELECT v FROM cp AT (BRANCH => 'cpl1') WHERE a = 1 AND b = 1
----
111

statement ok
PRAGMA git4data_merge('cp', 'cpl2', 'cpr2', 'accept')

query I
SELECT v FROM cp AT (BRANCH => 'cpl2') WHERE a = 1 AND b = 1
----
222

# The internal reference a merge names its base with is created only when the ancestor has a copy or a delta
# of its own - an ancestor without one is read as its own name, so no pin is needed and none is made. Where it
# is made, a merge that fails leaves it (a read through it returns the state it pinned) and a merge that
# completes forgets it, which is what the generated body's closing `git4data_forget_internal` is for. The
# first version of this phase used an ancestor with neither, where the reference never exists, and its two
# assertions passed for that reason rather than for this one.
statement ok
CREATE TABLE mbs (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO mbs SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('mbsbase', '')

statement ok
PRAGMA git4data_materialize('mbs', 'mbsbase', 'mbs_base_copy')

statement ok
UPDATE mbs_base_copy SET v = 111 WHERE k = 1

statement ok
PRAGMA git4data_create_branch('mbsl', 'mbsbase')

statement ok
PRAGMA git4data_create_branch('mbsr', 'mbsbase')

statement ok
PRAGMA git4data_materialize('mbs', 'mbsl', 'mbs_left')

statement ok
PRAGMA git4data_materialize('mbs', 'mbsr', 'mbs_right')

statement ok
UPDATE mbs_left SET v = 222 WHERE k = 1

statement ok
UPDATE mbs_right SET v = 333 WHERE k = 1

statement error
PRAGMA git4data_merge('mbs', 'mbsl', 'mbsr', 'fail')
----
<REGEX>:.*merge conflict.*

# the refused merge left the base behind, and it still names the state the two sides parted at
query I
SELECT count(*) FROM mbs AT (SNAPSHOT => '__merge_base__')
----
10

statement ok
PRAGMA git4data_merge('mbs', 'mbsl', 'mbsr', 'skip')

statement error
SELECT count(*) FROM mbs AT (SNAPSHOT => '__merge_base__')
----
<REGEX>:.*does not exist.*
