# name: test/sql/git4data/merge.test
# description: Three-way merge of one branch into another, with conflict policies
# group: [git4data]

load {TEST_DIR}/merge.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

# two branches off one ancestor, so the ancestor is their least common base
statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('left', 'root')

statement ok
PRAGMA git4data_create_branch('right', 'root')

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_materialize('t', 'left', 't_left')

statement ok
PRAGMA git4data_materialize('t', 'right', 't_right')

# each side changes a different row
statement ok
INSERT INTO t_left VALUES (1000, 1)

statement ok
INSERT INTO t_right VALUES (2000, 2)

statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'fail')

query I
SELECT count(*) FROM t AT (BRANCH => 'left')
----
102

query I
SELECT v FROM t_left WHERE k = 2000
----
2

# the merge lands in the left branch, so the source table is untouched
query I
SELECT count(*) FROM t
----
100

# a real conflict: the same key, changed differently on each side
statement ok
INSERT INTO t_left VALUES (3000, 3)

statement ok
INSERT INTO t_right VALUES (3000, 99)

statement error
PRAGMA git4data_merge('t', 'left', 'right', 'fail')
----
<REGEX>:.*merge conflict.*

# failing applies nothing at all, not half of it
query I
SELECT count(*) FROM t_left WHERE k = 2000
----
1

query I
SELECT v FROM t_left WHERE k = 3000
----
3

# skip leaves a conflicting key as the left branch has it
statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'skip')

query I
SELECT v FROM t_left WHERE k = 3000
----
3

# accept takes the right branch's version
statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'accept')

query I
SELECT v FROM t_left WHERE k = 3000
----
99

# The same change made on both sides is not a conflict, so a policy of fail does not refuse it -
# otherwise two branches adding the same row could never be merged.
statement ok
INSERT INTO t_left VALUES (5000, 5)

statement ok
INSERT INTO t_right VALUES (5000, 5)

statement ok
PRAGMA git4data_merge('t', 'left', 'right', 'fail')

query I
SELECT count(*) FROM t_left WHERE k = 5000
----
1

# a merge has to land somewhere writable, and root has no storage of its own yet
statement error
PRAGMA git4data_merge('t', 'root', 'left', 'fail')
----
<REGEX>:.*no storage of its own.*

statement ok
PRAGMA git4data_materialize('t', 'root', 't_root')

# merged into a branch that is an ancestor: right's changes relative to the ancestor apply cleanly
statement ok
PRAGMA git4data_merge('t', 'root', 'right', 'fail')

query I
SELECT count(*) FROM t_root
----
103

statement error
PRAGMA git4data_merge('t', 'left', 'nope', 'fail')
----
<REGEX>:.*nope.*does not exist.*

statement error
PRAGMA git4data_merge('t', 'left', 'right', 'maybe')
----
<REGEX>:.*fail, skip or accept.*

# and it still works after the file is reopened
statement ok
CHECKPOINT

restart

query I
SELECT v FROM t_left WHERE k = 3000
----
99

query I
SELECT count(*) FROM t AT (BRANCH => 'left')
----
104

# ---------------------------------------------------------------------------------------------------------
# A merge inside the caller's transaction, and what a refusal leaves behind
# ---------------------------------------------------------------------------------------------------------

# A merge is a group of statements in the caller's transaction, and one of them builds a helper table holding
# the conflicts. A refusal aborts the whole transaction, so the caller has to roll back - and the rollback has
# to leave no trace: no helper table, and no change to either side. Measured, that is what happens: the helper
# is a `CREATE OR REPLACE TEMP TABLE`, and a temp table made inside the transaction goes with it.
statement ok
CREATE TABLE tx_t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO tx_t VALUES (1, 10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('tx_root', '')

statement ok
PRAGMA git4data_create_branch('tx_left', 'tx_root')

statement ok
PRAGMA git4data_create_branch('tx_right', 'tx_root')

statement ok
PRAGMA git4data_materialize('tx_t', 'tx_left', 'tx_left_t')

statement ok
PRAGMA git4data_materialize('tx_t', 'tx_right', 'tx_right_t')

# the same row, changed differently on each side
statement ok
UPDATE tx_left_t SET v = 111 WHERE k = 1

statement ok
UPDATE tx_right_t SET v = 222 WHERE k = 1

statement ok
BEGIN

statement error
PRAGMA git4data_merge('tx_t', 'tx_left', 'tx_right', 'fail')
----
<REGEX>:.*merge conflict.*

# the session is in an aborted transaction after a refusal, which the note records as the one thing a caller
# has to clear; the rollback clears it and takes the merge with it
statement ok
ROLLBACK

query I
SELECT v FROM tx_left_t WHERE k = 1
----
111

query I
SELECT v FROM tx_right_t WHERE k = 1
----
222

# no helper table is left behind by the refusal
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name LIKE 'g4d%'
----
0

# and the merge still works when the caller asks it to skip the conflicting row
statement ok
PRAGMA git4data_merge('tx_t', 'tx_left', 'tx_right', 'skip')

query I
SELECT v FROM tx_left_t WHERE k = 1
----
111

# Both sides removing the same row is agreement, not a conflict - there is no row left on either side for
# them to disagree about. Measured before this was fixed: that case was refused with the conflict message,
# so a caller with nothing to resolve was told to resolve something.
statement ok
CREATE TABLE g (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO g SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('ga', '')

statement ok
PRAGMA git4data_create_branch('ga1', 'ga')

statement ok
PRAGMA git4data_create_branch('ga2', 'ga')

statement ok
PRAGMA git4data_materialize('g', 'ga1', 'g_ga1')

statement ok
PRAGMA git4data_materialize('g', 'ga2', 'g_ga2')

statement ok
DELETE FROM g_ga1 WHERE k = 5

statement ok
DELETE FROM g_ga2 WHERE k = 5

statement ok
PRAGMA git4data_merge('g', 'ga1', 'ga2', 'fail')

query I
SELECT count(*) FROM g AT (BRANCH => 'ga1')
----
9

# and the rule is not wider than that: removing the row on one side while the other changes it is still a
# conflict, because the two sides did not end up with the same row
statement ok
PRAGMA git4data_create_branch('gb', '')

statement ok
PRAGMA git4data_create_branch('gb1', 'gb')

statement ok
PRAGMA git4data_create_branch('gb2', 'gb')

statement ok
PRAGMA git4data_materialize('g', 'gb1', 'g_gb1')

statement ok
PRAGMA git4data_materialize('g', 'gb2', 'g_gb2')

statement ok
DELETE FROM g_gb1 WHERE k = 6

statement ok
UPDATE g_gb2 SET v = 999 WHERE k = 6

statement error
PRAGMA git4data_merge('g', 'gb1', 'gb2', 'fail')
----
<REGEX>:.*merge conflict.*
