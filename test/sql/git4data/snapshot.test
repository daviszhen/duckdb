# name: test/sql/git4data/snapshot.test
# description: Git4Data snapshot registry lifecycle
# group: [git4data]

statement ok
CREATE TABLE t(i INTEGER);

statement ok
INSERT INTO t VALUES (1), (2), (3);

# Creating a snapshot pins the current commit id
statement ok
PRAGMA git4data_create_snapshot('s1');

# Names must be unique
statement error
PRAGMA git4data_create_snapshot('s1')
----
<REGEX>:.*Snapshot "s1" already exists.*

# A pinned snapshot is listed
statement ok
PRAGMA git4data_snapshots;

# Dropping releases the pin
statement ok
PRAGMA git4data_drop_snapshot('s1');

# Dropping an unknown snapshot fails
statement error
PRAGMA git4data_drop_snapshot('s1')
----
<REGEX>:.*Snapshot "s1" does not exist.*

# An empty name is a legal name and must still be unique
statement ok
PRAGMA git4data_create_snapshot('');

statement error
PRAGMA git4data_create_snapshot('')
----
<REGEX>:.*Snapshot "" already exists.*

statement ok
PRAGMA git4data_drop_snapshot('');

# A name that needs quoting in the listing query the pragma generates. The escaped-quote
# case is covered by git4data-mo-parity-check.sh instead: this runner's parser reads an
# escaped quote as an unterminated string.
statement ok
PRAGMA git4data_create_snapshot('spaced name');

statement ok
PRAGMA git4data_snapshots;

statement ok
PRAGMA git4data_drop_snapshot('spaced name');

# Independent snapshots coexist and release independently
statement ok
PRAGMA git4data_create_snapshot('s2');

statement ok
PRAGMA git4data_create_snapshot('s3');

statement ok
PRAGMA git4data_drop_snapshot('s2');

statement ok
PRAGMA git4data_snapshots;

statement ok
PRAGMA git4data_drop_snapshot('s3');

# Every snapshot is gone again, so a read by name is refused
statement error
SELECT count(*) FROM t AT (SNAPSHOT => 's3')
----
<REGEX>:.*does not exist.*

# The reference registry is not transactional: a reference taken inside a transaction that rolls back
# stays. That is worth an assertion rather than an assumption - it is not a silent wrongness, because what
# a reference pins is the last *committed* commit, which a rolled-back transaction did not change, but it
# is a behaviour someone will meet.
statement ok
BEGIN

statement ok
PRAGMA git4data_create_snapshot('in_tx')

statement ok
ROLLBACK

statement ok
PRAGMA git4data_snapshots

statement ok
PRAGMA git4data_drop_snapshot('in_tx')

# A snapshot and a branch cannot share a name. Wherever a reference is named without saying which kind it
# is - a diff, a pick, a restore, and a merge's own image clauses - a bare name is looked up in the
# snapshot registry first, so the two would be indistinguishable. Measured before this: with a branch and
# a snapshot both called x, a merge of x with x compared the branch against the snapshot and reported a
# conflict that did not exist.
statement ok
PRAGMA git4data_create_branch('shared_name', '')

statement error
PRAGMA git4data_create_snapshot('shared_name')
----
<REGEX>:.*A branch named "shared_name" exists.*

statement ok
PRAGMA git4data_create_snapshot('only_snapshot')

statement error
PRAGMA git4data_create_branch('only_snapshot', '')
----
<REGEX>:.*A snapshot named "only_snapshot" exists.*
