# name: test/sql/git4data/clone_database.test
# description: A zero-copy clone of the database, and the independence it has
# group: [git4data]

load {TEST_DIR}/clone_database.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(1000)

statement ok
CHECKPOINT

# A clone is the file system's copy-on-write of the database file, so it costs nothing to make and shares
# its blocks with the original until either side writes. Measured on a database of nine megabytes: the
# clone takes ten milliseconds and no measurable disk, where copying the file takes eight and a half
# megabytes. That is what "zero-copy" means at the file level; an in-engine clone that shares row groups
# is the other route and is not built.
statement ok
PRAGMA git4data_clone_database('{TEST_DIR}/clone_database_clone.db')

# the clone is a database in its own right: attaching it reads the same rows
statement ok
ATTACH '{TEST_DIR}/clone_database_clone.db' AS cloned

query II
SELECT count(*), sum(v) FROM cloned.t
----
1000	499500

# and it is independent from the moment either side writes
statement ok
INSERT INTO cloned.t VALUES (5000, 5000)

query II
SELECT (SELECT count(*) FROM cloned.t), (SELECT count(*) FROM t)
----
1001	1000

statement ok
UPDATE t SET v = -1 WHERE k = 1

query II
SELECT (SELECT v FROM cloned.t WHERE k = 1), (SELECT v FROM t WHERE k = 1)
----
1	-1

statement ok
DETACH cloned

# cloning onto a path that exists is refused rather than overwriting whatever is there
statement error
PRAGMA git4data_clone_database('{TEST_DIR}/clone_database_clone.db')
----
<REGEX>:.*already exists - a clone does not overwrite.*

# an empty path is a mistake, not a clone into the working directory
statement error
PRAGMA git4data_clone_database('')
----
<REGEX>:.*A clone needs a path to write to.*

# A clone is the file, and the reference registry is written to the file at a checkpoint rather than through
# the log, so a clone taken with references made since the last checkpoint would have the tables and none of
# the references. Measured: the clone reported "Branch \"b\" does not exist", and the same clone taken after
# a checkpoint read the branch's v = 111 and its capture's v = 111. It is refused now, with the statement
# that resolves it in the message.
statement ok
CREATE TABLE r (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO r SELECT range, range FROM range(4)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('rb', '')

statement ok
PRAGMA git4data_materialize('r', 'rb', 'r_b')

statement ok
PRAGMA git4data_create_snapshot('rs', 'rb')

statement error
PRAGMA git4data_clone_database('{TEST_DIR}/clone_dirty.db')
----
<REGEX>:.*Run CHECKPOINT first.*

# and with a checkpoint it is a clone of the whole database again
statement ok
CHECKPOINT

statement ok
PRAGMA git4data_clone_database('{TEST_DIR}/clone_dirty.db')

statement ok
ATTACH '{TEST_DIR}/clone_dirty.db' AS cloned_dirty

query I
SELECT count(*) FROM cloned_dirty.r
----
4
