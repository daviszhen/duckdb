# name: test/sql/git4data/restore_branch.test
# description: Rewinding a branch's own line to a state it passed through
# group: [git4data]

load {TEST_DIR}/restore_branch.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('b', '')

statement ok
PRAGMA git4data_materialize('t', 'b', 't_b')

statement ok
UPDATE t_b SET v = 111 WHERE k = 1

statement ok
CHECKPOINT

# the branch's line has a state worth coming back to
statement ok
PRAGMA git4data_create_snapshot('mid')

# then it goes further: rows added and removed
statement ok
INSERT INTO t_b VALUES (500, 500)

statement ok
DELETE FROM t_b WHERE k < 5

statement ok
CHECKPOINT

query III
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1),
       (SELECT count(*) FROM t AT (BRANCH => 'b') WHERE k = 500)
----
96	NULL	1

# rewinding the branch's own table is an ordinary restore against a reference on its line
statement ok
PRAGMA git4data_restore('t_b', 'mid')

query III
SELECT (SELECT count(*) FROM t AT (BRANCH => 'b')), (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 1),
       (SELECT count(*) FROM t AT (BRANCH => 'b') WHERE k = 500)
----
100	111	0

# the table the branch came from is untouched by any of it
query II
SELECT (SELECT count(*) FROM t), (SELECT v FROM t WHERE k = 1)
----
100	1

# and the branch can be carried forward again from where it was rewound to
statement ok
UPDATE t_b SET v = 222 WHERE k = 2

query II
SELECT (SELECT v FROM t AT (BRANCH => 'b') WHERE k = 2), (SELECT v FROM t WHERE k = 2)
----
222	2
