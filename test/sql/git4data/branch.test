# name: test/sql/git4data/branch.test
# description: Data branches carry lineage and hold their base down like a pin
# group: [git4data]

load {TEST_DIR}/branch.db

statement ok
CREATE TABLE t AS SELECT range AS i FROM range(1000)

statement ok
CHECKPOINT

# a root branch starts at the newest commit, the same point a snapshot would pin
statement ok
PRAGMA git4data_create_branch('root', '')

statement ok
PRAGMA git4data_create_branch('a', 'root')

statement ok
PRAGMA git4data_create_branch('b', 'root')

statement ok
PRAGMA git4data_branches

# siblings share the branch they both descend from
query I
PRAGMA git4data_lca('a', 'b')
----
root

query I
PRAGMA git4data_lca('a', 'root')
----
root

# a branch is its own ancestor when asked against itself
query I
PRAGMA git4data_lca('a', 'a')
----
a

statement error
PRAGMA git4data_create_branch('a', 'root')
----
<REGEX>:.*already exists.*

statement error
PRAGMA git4data_create_branch('c', 'missing')
----
<REGEX>:.*missing.*neither a branch nor a snapshot.*

# dropping a branch that others descend from is refused - it would leave their lineage dangling
statement error
PRAGMA git4data_drop_branch('root')
----
<REGEX>:.*descending from it\. Drop those branches first\..*

# a leaf can be dropped, and is really gone
statement ok
PRAGMA git4data_drop_branch('b')

statement error
PRAGMA git4data_lca('b', 'a')
----
<REGEX>:.*b.*does not exist.*

# A branch holds its base down exactly as a pin does. The delete commits well past the
# branch, and the branch still keeps the pre-image readable at its own bound.
statement ok
DELETE FROM t WHERE i < 400

statement ok
CHECKPOINT

query I
SELECT count(*) FROM t
----
600

query III
PRAGMA git4data_probe('t')
----
1000	0	999

# and the branch is readable: the same reference the pin provides, through the clause
query I
SELECT count(*) FROM t AT (BRANCH => 'a')
----
1000

# an unknown name is looked up in the branch registry, so a snapshot name is not found here
statement error
SELECT count(*) FROM t AT (BRANCH => 's_not_a_branch')
----
<REGEX>:.*s_not_a_branch.*does not exist.*

# the branch, its lineage, the history it holds and its read path all come back with the file
restart

query I
SELECT count(*) FROM t AT (BRANCH => 'a')
----
1000

query I
SELECT count(*) FROM t AT (BRANCH => 'root')
----
1000

statement ok
PRAGMA git4data_branches

query I
PRAGMA git4data_lca('a', 'root')
----
root

query I
SELECT count(*) FROM t
----
600

query III
PRAGMA git4data_probe('t')
----
1000	0	999

# A fork takes the state its parent holds, and a parent's state differs from the source at its pin whenever it
# *reads a line* - not only when it holds something of its own. Measured before this: `fld`, forked from a branch
# that read its own parent's delta, carried an empty `base_line` with that branch's pin and read the **raw
# table**, so the key the line added was gone and the key it removed was back - a fork silently changing what the
# branch it forked from reads.
statement ok
CREATE TABLE fl (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO fl SELECT range, range FROM range(5)

statement ok
PRAGMA git4data_create_branch('flb', '')

statement ok
CREATE TABLE flb_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE flb_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('fl', 'flb', 'flb_add', 'flb_del')

statement ok
INSERT INTO flb_add VALUES (100, 100), (101, 101)

statement ok
INSERT INTO flb_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('flc', 'flb')

statement ok
PRAGMA git4data_create_branch('fld', 'flc')

query IIIII
SELECT (SELECT count(*) FROM fl AT (BRANCH => 'flb')),
       (SELECT count(*) FROM fl AT (BRANCH => 'flb') WHERE k = 100),
       (SELECT count(*) FROM fl AT (BRANCH => 'flb') WHERE k = 2),
       (SELECT count(*) FROM fl AT (BRANCH => 'flc')),
       (SELECT count(*) FROM fl AT (BRANCH => 'flc') WHERE k = 2)
----
6	1	0	6	0

# the second hop reads what the first one reads, and its line is the branch it forked from
query IIIII
SELECT (SELECT count(*) FROM fl AT (BRANCH => 'fld')),
       (SELECT count(*) FROM fl AT (BRANCH => 'fld') WHERE k = 100),
       (SELECT count(*) FROM fl AT (BRANCH => 'fld') WHERE k = 101),
       (SELECT count(*) FROM fl AT (BRANCH => 'fld') WHERE k = 2),
       (SELECT line FROM git4data_branches() WHERE branch_name = 'fld')
----
6	1	1	0	flc

# and the branch that line runs through cannot be dropped while the fork holds it
statement error
PRAGMA git4data_drop_branch('flc')
----
<REGEX>:.*descending from it\. Drop those branches first\..*

# The drop guard's second refusal is about a branch's **line**, not its storage: a branch that differs by a delta
# has no storage at all, and a dependent reached through a snapshot that captured its line reads that delta.
# Measured before the wording changed: the refusal said the dependents "read this one's storage at their fork
# pin" about a branch whose `has_storage` is false and whose `delta_added` is `lr_add` - and the dependent read
# five rows through it.
statement ok
CREATE TABLE lr (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO lr SELECT range, range FROM range(4)

statement ok
PRAGMA git4data_create_branch('lr0', '')

statement ok
CREATE TABLE lr_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE lr_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('lr', 'lr0', 'lr_add', 'lr_del')

statement ok
INSERT INTO lr_add VALUES (100, 100)

statement ok
PRAGMA git4data_create_snapshot('lr_cap', 'lr0')

statement ok
PRAGMA git4data_create_branch('lr1', 'lr_cap')

# the parent has no storage, and the dependent reads its line
query III
SELECT has_storage, storage_table, delta_added FROM git4data_branches() WHERE branch_name = 'lr0'
----
false	(empty)	lr_add

query II
SELECT (SELECT count(*) FROM lr AT (BRANCH => 'lr1')), (SELECT count(*) FROM lr AT (BRANCH => 'lr1') WHERE k = 100)
----
5	1

# so the refusal is about the line, and it says so
statement error
PRAGMA git4data_drop_branch('lr0')
----
<REGEX>:.*captured its line, and they read it at their fork pin\. Drop those branches first\..*
