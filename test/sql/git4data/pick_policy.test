# name: test/sql/git4data/pick_policy.test
# description: A pick can refuse or skip rows the live table has moved on from
# group: [git4data]

load {TEST_DIR}/pick_policy.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

# one row added, one removed, three changed - this is the source's state
statement ok
INSERT INTO t VALUES (100, 100)

statement ok
DELETE FROM t WHERE k = 5

statement ok
UPDATE t SET v = v + 1 WHERE k < 3

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('source')

# The live table then moves on, on the very keys the source changed. That is what a pick would
# silently overwrite, and what a policy is for.
statement ok
DELETE FROM t WHERE k = 100

statement ok
UPDATE t SET v = -1 WHERE k = 1

statement ok
UPDATE t SET v = -5 WHERE k = 0

# fail refuses, and a refused pick leaves the table exactly as it was: the rows the two sides agree on
# are untouched too, and the row the source added is still absent.
statement error
PRAGMA git4data_pick('t', 'source', 'base', 'fail')
----
<REGEX>:.*pick conflict.*

query II
SELECT (SELECT count(*) FROM t WHERE k = 100), (SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k) FROM t WHERE k < 3)
----
0	0:-5 1:-1 2:3

# skip applies what the two sides agree on and leaves the two the live table changed itself
statement ok
PRAGMA git4data_pick('t', 'source', 'base', 'skip')

query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k) FROM t WHERE k < 4
----
0:-5 1:-1 2:3 3:3

# the row the source added is back with the source's value, and the one it removed stays removed
query II
SELECT (SELECT v FROM t WHERE k = 100), (SELECT count(*) FROM t WHERE k = 5)
----
100	0

# A policy that is not one of the three is refused before anything runs.
statement error
PRAGMA git4data_pick('t', 'source', 'base', 'merge')
----
<REGEX>:.*Pick policy has to be overwrite, fail or skip.*

# Making the same change on both sides is agreement, not a conflict, so the same pick goes through
# under fail once the live table has caught up with the source on those keys.
statement ok
UPDATE t SET v = 1 WHERE k = 0

statement ok
UPDATE t SET v = 2 WHERE k = 1

statement ok
PRAGMA git4data_pick('t', 'source', 'base', 'fail')

query I
SELECT string_agg(k::VARCHAR || ':' || v::VARCHAR, ' ' ORDER BY k) FROM t WHERE k < 3
----
0:1 1:2 2:3

# Overwriting is what a pick did before there was a choice, and it is still the default: the source's
# value wins on a key the live table changed too.
statement ok
UPDATE t SET v = -1 WHERE k = 1

statement ok
PRAGMA git4data_pick('t', 'source', 'base')

query I
SELECT v FROM t WHERE k = 1
----
2

# A deletion is an agreement like any other: when the live table and the source have both removed the same
# row, there is nothing left for them to differ about, so a pick under fail goes through. Measured across
# three shapes at once, with a source of its own for each (a branch with a copy, because the source side has
# to be changeable):
#   both removed the same row            -> goes through, row gone
#   live removed it, source changed it   -> refused, the two sides did not end up with the same row
#   source removed it, live left it      -> goes through, row gone
statement ok
CREATE TABLE t_p1 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_p2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t_p3 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t_p1 SELECT range, range FROM range(10)

statement ok
INSERT INTO t_p2 SELECT range, range FROM range(10)

statement ok
INSERT INTO t_p3 SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('pb1', '')

statement ok
PRAGMA git4data_create_branch('pb2', '')

statement ok
PRAGMA git4data_create_branch('pb3', '')

statement ok
PRAGMA git4data_create_branch('ps1', '')

statement ok
PRAGMA git4data_create_branch('ps2', '')

statement ok
PRAGMA git4data_create_branch('ps3', '')

statement ok
PRAGMA git4data_materialize('t_p1', 'ps1', 'c_p1')

statement ok
PRAGMA git4data_materialize('t_p2', 'ps2', 'c_p2')

statement ok
PRAGMA git4data_materialize('t_p3', 'ps3', 'c_p3')

statement ok
DELETE FROM t_p1 WHERE k = 5

statement ok
DELETE FROM c_p1 WHERE k = 5

statement ok
DELETE FROM t_p2 WHERE k = 5

statement ok
UPDATE c_p2 SET v = 999 WHERE k = 5

statement ok
DELETE FROM c_p3 WHERE k = 5

# both removed: agreement, so it goes through and the row is gone
statement ok
PRAGMA git4data_pick('t_p1', 'ps1', 'pb1', 'fail')

query I
SELECT count(*) FROM t_p1 WHERE k = 5
----
0

# the live table removed the row and the source changed it: a conflict, the sides are not the same
statement error
PRAGMA git4data_pick('t_p2', 'ps2', 'pb2', 'fail')
----
<REGEX>:.*pick conflict.*

# the source removed it and the live table never touched it: the removal lands
statement ok
PRAGMA git4data_pick('t_p3', 'ps3', 'pb3', 'fail')

query I
SELECT count(*) FROM t_p3 WHERE k = 5
----
0
