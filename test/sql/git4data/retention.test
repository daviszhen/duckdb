# name: test/sql/git4data/retention.test
# description: A pinned snapshot keeps deleted rows readable across CHECKPOINT, and across a reopen
# group: [git4data]

# A *file* database, because the last phase closes and reopens it: an in-memory one loses the registry tables
# with the process, which is not what a reopen is being asked about.
load {TEST_DIR}/retention.db

statement ok
CREATE TABLE u AS SELECT range AS i FROM range(1000);

statement ok
CHECKPOINT;

statement ok
PRAGMA git4data_create_snapshot('s1')

statement ok
DELETE FROM u WHERE i < 400;

statement ok
CHECKPOINT;

statement ok
CHECKPOINT;

# The logical view still sees 600 rows
query I
SELECT count(*) FROM u
----
600

# A pinned snapshot makes the physical scan retain the pre-image. The probe reads
# through the retention bound, so it still sees all 1000 original rows and their
# original values even after two checkpoints.
query III
PRAGMA git4data_probe('u')
----
1000	0	999

statement ok
PRAGMA git4data_drop_snapshot('s1')

# Releasing the pin lets the next checkpoint reclaim the pre-image
statement ok
CHECKPOINT;

query III
PRAGMA git4data_probe('u')
----
600	400	999

# **And across a reopen.** The retention a reference buys is not only a checkpoint's business: the pre-image has
# to be *in the file*, and the reference that keeps it readable has to come back with it. The scenario is the
# one above with a close in the middle - a pin, an update and a delete, a checkpoint, the process ends, and the
# pin is read again from what the file holds. Its own table, so the phases above are untouched.
statement ok
CREATE TABLE w (k INTEGER PRIMARY KEY, v INTEGER);

statement ok
INSERT INTO w SELECT range, range FROM range(1000);

statement ok
CHECKPOINT;

statement ok
PRAGMA git4data_create_snapshot('w_pin');

statement ok
UPDATE w SET v = v + 10000;

statement ok
DELETE FROM w WHERE k < 400;

statement ok
CHECKPOINT;

# before the close: the pin reads the pre-image, and the table reads what it holds now
query III
SELECT (SELECT count(*) FROM w AT (SNAPSHOT => 'w_pin')),
       (SELECT v FROM w AT (SNAPSHOT => 'w_pin') WHERE k = 1),
       (SELECT v FROM w WHERE k = 500)
----
1000	1	10500

restart

# after it: the same two answers, one from the file's versions and one from the file's rows
query III
SELECT (SELECT count(*) FROM w AT (SNAPSHOT => 'w_pin')),
       (SELECT v FROM w AT (SNAPSHOT => 'w_pin') WHERE k = 1),
       (SELECT v FROM w WHERE k = 500)
----
1000	1	10500

# and the reference itself came back with the pin it had: the row is there, and the listing reports the same pin
# for it - which is what makes the read above possible rather than a coincidence of the file's rows
query II
SELECT (SELECT count(*) FROM git4data.snapshots WHERE name = 'w_pin'),
       (SELECT count(*) FROM git4data_snapshots()
         WHERE snapshot_name = 'w_pin'
           AND pinned_commit_id = (SELECT pin FROM git4data.snapshots WHERE name = 'w_pin'))
----
1	1
