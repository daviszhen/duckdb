# name: test/sql/git4data/merge_delta_base.test
# description: An ancestor that differs by a delta is not the state the two sides parted at either
# group: [git4data]

# The same question as `merge_line_base.test`, for the other way an ancestor stops reading as its state at the
# pin: a delta on the source is the ancestor's own change to it, so its name reads as its line *now*. The base
# has to be named by its pin (and by the line it inherited), or the ancestor's own change is inside the base
# and comes out of the merge looking like no change at all - a merge that silently drops the other side's edit.
# Measured before the fix: the row B had changed stayed at its old value on C.

load {TEST_DIR}/merge_delta_base.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_branch('A', '')

statement ok
PRAGMA git4data_materialize('t', 'A', 'a_copy')

statement ok
UPDATE a_copy SET v = 111 WHERE k = 1

# B forks from A's captured line, and differs from it by a delta rather than holding a copy
statement ok
PRAGMA git4data_create_snapshot('S', 'A')

statement ok
PRAGMA git4data_create_branch('B', 'S')

query II
SELECT k, v FROM t AT (BRANCH => 'B') ORDER BY k
----
1	111
2	20
3	30

statement ok
CREATE TABLE b_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE b_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_bind_branch_delta('t', 'B', 'b_add', 'b_del')

# C forks from B and takes a copy of that state, so the two sides can move apart
statement ok
PRAGMA git4data_create_branch('C', 'B')

statement ok
PRAGMA git4data_materialize('t', 'C', 'c_copy')

statement ok
UPDATE c_copy SET v = 999 WHERE k = 1

# and B changes a row C never touched, through its delta, after C's fork
statement ok
PRAGMA git4data_apply('t', 'B', 'UPDATE t SET v = 333 WHERE k = 3')

query II
SELECT k, v FROM t AT (BRANCH => 'B') ORDER BY k
----
1	111
2	20
3	333

# The base is B's line at its pin, which held 3 -> 30: only B changed that row, and only C changed k = 1, so
# the merge brings B's row over. Read as B's line *now* - what naming the branch would do - the base already
# holds 3 -> 333 and the merge has nothing to bring.
statement ok
PRAGMA git4data_merge('t', 'C', 'B', 'fail')

query II
SELECT k, v FROM t AT (BRANCH => 'C') ORDER BY k
----
1	999
2	20
3	333

query II
SELECT k, v FROM t AT (BRANCH => 'B') ORDER BY k
----
1	111
2	20
3	333

query II
SELECT k, v FROM t ORDER BY k
----
1	10
2	20
3	30

# Two sides forked from a delta branch part *inside* that delta, not at the source the ancestor's pin names.
# Measured before this was fixed: the base was read as the source at the ancestor's pin - the source without
# the delta - so every row the delta had removed looked changed on both sides, and two sides that were the
# same state (`git4data_diff` between them 0) were refused as a conflict.
statement ok
CREATE TABLE t2 (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t2 SELECT range, range FROM range(10)

statement ok
CHECKPOINT

statement ok
CREATE TABLE t2_add (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
CREATE TABLE t2_del (k INTEGER PRIMARY KEY)

statement ok
PRAGMA git4data_create_branch('dl', '')

statement ok
PRAGMA git4data_bind_branch_delta('t2', 'dl', 't2_add', 't2_del')

statement ok
INSERT INTO t2_del VALUES (2)

statement ok
PRAGMA git4data_create_branch('dl1', 'dl')

statement ok
PRAGMA git4data_create_branch('dl2', 'dl')

statement ok
PRAGMA git4data_materialize('t2', 'dl1', 't2_dl1')

# the two sides hold the same state, so the merge has nothing to resolve and nothing to refuse
query I
SELECT count(*) FROM git4data_diff('t2', 'dl1', 'dl2')
----
0

statement ok
PRAGMA git4data_merge('t2', 'dl1', 'dl2', 'fail')

query II
SELECT (SELECT count(*) FROM t2 AT (BRANCH => 'dl1')), (SELECT count(*) FROM t2 AT (BRANCH => 'dl1') WHERE k = 2)
----
9	0

# and a change only one side made still lands, with no conflict invented for the rows it did not touch
statement ok
UPDATE t2_dl1 SET v = 555 WHERE k = 1

statement ok
PRAGMA git4data_merge('t2', 'dl1', 'dl2', 'fail')

query II
SELECT (SELECT v FROM t2 AT (BRANCH => 'dl1') WHERE k = 1), (SELECT count(*) FROM t2 AT (BRANCH => 'dl1'))
----
555	9
