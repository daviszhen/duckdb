# name: test/sql/git4data/pick_base.test
# description: A pick's base is read as the reference it names, snapshot or branch
# group: [git4data]

load {TEST_DIR}/pick_base.db

statement ok
CREATE TABLE t (k INTEGER PRIMARY KEY, v INTEGER)

statement ok
INSERT INTO t SELECT range, range FROM range(100)

statement ok
CHECKPOINT

statement ok
PRAGMA git4data_create_snapshot('base')

# one line changes the first ten rows and removes the next ten
statement ok
PRAGMA git4data_create_branch('feature', '')

statement ok
PRAGMA git4data_materialize('t', 'feature', 't_feature')

statement ok
UPDATE t_feature SET v = v + 1000 WHERE k < 10

statement ok
DELETE FROM t_feature WHERE k >= 10 AND k < 20

# another line, forked from the same base, changes one row of its own
statement ok
PRAGMA git4data_create_branch('other', '')

statement ok
PRAGMA git4data_materialize('t', 'other', 't_other')

statement ok
UPDATE t_other SET v = 777 WHERE k = 50

statement ok
CHECKPOINT

# With a snapshot as the base, what the pick applies is everything the feature line did since that
# commit - until the main line already has it, which it does not here.
statement ok
PRAGMA git4data_pick('t', 'feature', 'base', 'fail')

query III
SELECT (SELECT v FROM t WHERE k = 0), (SELECT count(*) FROM t WHERE k = 15), (SELECT v FROM t WHERE k = 50)
----
1000	0	50

# The base can equally name a branch, and then it is that line's head that the changes are relative to.
# Between two lines forked from the same commit, what one has and the other does not includes the rows
# the other never removed - so picking other relative to feature puts those ten rows back and takes
# other's change to k = 50, which is what "make the main line look like other, relative to feature"
# means. The base being named is the point; which base to name is the caller's.
statement ok
PRAGMA git4data_pick('t', 'other', 'feature', 'fail')

query III
SELECT (SELECT v FROM t WHERE k = 50), (SELECT count(*) FROM t WHERE k = 15), (SELECT count(*) FROM t)
----
777	1	100

# A base that is a branch's head is a sharp tool: the main line's k = 0 was changed by the feature
# line and not by the other one, so relative to feature the other line "changes" it back. That is what
# naming that base means, and it is why a snapshot is usually the base a caller wants.
query II
SELECT (SELECT v FROM t WHERE k = 25), (SELECT v FROM t WHERE k = 0)
----
25	0
