{
  "description": "Run with debug_verify_statement set to prepared_statement - forcing statements through PREPARE and EXECUTE with parameters",
  "on_init": "SET debug_verify_statement='prepared_statement'; SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';",
  "skip_compiled": "true",
  "skip_error_messages": [
    "Parameter Not Allowed Error:",
    "This type of statement can't be prepared!"
  ],
  "skip_tests": [
    {
      "reason": "Parameters don't work here",
      "paths": [
        "test/sql/collate/test_collate_orderby_column_number.test",
        "test/sql/projection/select_star_like.test"
      ]
    },
    {
      "reason": "Different error message",
      "paths": [
        "test/sql/cast/cast_error_location.test",
        "test/sql/types/type_constructor_error_location.test",
        "test/sql/types/struct/unnest_struct_mix.test",
        "test/sql/settings/allowed_directories.test",
        "test/sql/function/string/regex_extract_all.test"
      ]
    },
    {
      "reason": "Extra queries mess up logs",
      "paths": [
        "test/sql/pragma/test_query_log.test",
        "test/sql/cte/warn_deprecated_union_in_using_key.test",
        "test/sql/logging/test_logging_function.test",
        "test/sql/logging/logging_buffer_size.test",
        "test/sql/logging/logging_types.test",
        "test/sql/logging/logging.test",
        "test/sql/logging/logging_context_ids.test",
        "test/sql/logging/logging_csv.test",
        "test/sql/logging/logging_file_truncate_rewrite.test",
        "test/sql/logging/http_log_timing.test"
      ]
    },
    {
      "reason": "Extra prepared statements registered",
      "paths": [
        "test/sql/pg_catalog/pg_prepared_statements.test",
        "test/sql/table_function/duckdb_prepared_statements.test"
      ]
    },
    {
      "reason": "EXECUTE does not emit parser/phase metrics; profiling output differs from direct SELECT",
      "paths": [
        "test/sql/pragma/profiling/test_custom_profiling_using_groups.test",
        "test/sql/pragma/profiling/test_custom_profiling_row_group_metrics_local_storage.test",
        "test/sql/types/geo/geometry_parquet_pushdown.test"
      ]
    },
    {
      "reason": "A prepared statement binds once and executes the plan that bind left behind, and a refusal the feature raises while binding does not reach the caller in this mode. These tests assert refusals, so nothing they say here is about the feature. Measured in the design note's increment 3fp: the table's identity is from the file and differs from the mapping's in both modes, and the read is answered instead of refused. The same tests are what decision 2 and 3ej exist for, and they pass in every build without this mode.",
      "paths": [
        "test/sql/git4data/storage_swap.test",
        "test/sql/git4data/name_spelling.test",
        "test/sql/git4data/line_snapshot.test"
      ]
    }
  ]
}
